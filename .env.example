# Copy to .env and fill in. Read by the dev/preview server and `npm start` only;
# never bundled into the browser code. With no provider the assistant runs in
# basic (keyword) mode. Full list: docs/ai-assistant/provider-integration.md

# --- AI providers (any combination) ---
ANTHROPIC_API_KEY=
# AI_ANTHROPIC_MODEL=claude-opus-5-5
# AI_OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_API_KEY=
# AI_DEFAULT_PROVIDER=ollama

# Required to store provider API keys entered in Settings (min 16 chars).
# AI_SECRET_KEY=

# Admin accounts (comma-separated). Unset: the first registered account is admin.
# AI_ADMIN_USERNAMES=

# Database file (default .data/mixivivu.db)
# MIXIVIVU_DB_PATH=

# Optional: embeddings via Ollama instead of the local hashing embedder
# AI_EMBEDDINGS=ollama:nomic-embed-text
# Optional: web search backend (opt-in per user)
# AI_WEB_SEARCH=searxng
# AI_SEARXNG_URL=

# Force keyword-only answers even when a provider is set (used by tests).
# MIXIVIVU_CHAT_MODE=basic
