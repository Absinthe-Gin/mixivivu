"tour/hue-riverside-boutique-resortand-spa/images/q822o2ekaqvm0h83.webp","tour/hue-riverside-boutique-resortand-spa/images/tjuo32fchl4je1me.webp","tour/hue-riverside-boutique-resortand-spa/images/10sh87p6yle2uulo.webp","tour/hue-riverside-boutique-resortand-spa/images/mkzde8y43uzwrwbc.webp","tour/hue-riverside-boutique-resortand-spa/images/uh1t9yyz8x7tz3jp.webp","tour/hue-riverside-boutique-resortand-spa/images/ksi1fugan4xqffs0.webp","tour/hue-riverside-boutique-resortand-spa/images/wnnpdy3p96ds695r.webp","tour/hue-riverside-boutique-resortand-spa/images/1tqn955wvamxnc1a.webp","tour/hue-riverside-boutique-resortand-spa/images/hxi6kk4rxaf6flnw.webp","tour/hue-riverside-boutique-resortand-spa/images/8jtbldv5ul83q924.webp","tour/hue-riverside-boutique-resortand-spa/images/5sjfyqqrsk5e3hm6.webp","tour/hue-riverside-boutique-resortand-spa/images/2zd1y5azpnkwenop.webp","tour/hue-riverside-boutique-resortand-spa/images/3ea2z7okbnhjbtwq.webp","tour/hue-riverside-boutique-resortand-spa/images/h1istbkp6hkdrh8k.webp","tour/hue-riverside-boutique-resortand-spa/images/kbvcl5aceb35s3ev.webp","tour/hue-riverside-boutique-resortand-spa/images/nqkkcmfgbqrhubzx.webp","tour/hue-riverside-boutique-resortand-spa/images/kd6yywafbdq2oh1g.webp","tour/hue-riverside-boutique-resortand-spa/images/4fuz46pbwz8lo9pr.webp","tour/hue-riverside-boutique-resortand-spa/images/1o29czvxdg9byehm.webp","tour/hue-riverside-boutique-resortand-spa/images/ldfv69r5pvg042z9.webp","tour/hue-riverside-boutique-resortand-spa/images/00gcscnadzimdqhh.webp","tour/hue-riverside-boutique-resortand-spa/images/twievf4taykbnt01.webp","tour/hue-riverside-boutique-resortand-spa/images/m5sc8476vepdx0pu.webp","tour/hue-riverside-boutique-resortand-spa/images/datpuy5e5mnufmg4.webp","tour/hue-riverside-boutique-resortand-spa/images/8b6qw542kuskm3no.webp","tour/hue-riverside-boutique-resortand-spa/images/v9sf3vb9tp2ixfww.webp","tour/hue-riverside-boutique-resortand-spa/images/frcuys277qnynk46.webp","tour/hue-riverside-boutique-resortand-spa/images/8cawccyr8vfjgphe.webp"],"highlights":["Bạn sẽ được ngắm nhìn quang cảnh sông Hương và vườn bưởi trong phòng nghỉ dưỡng sang trọng, thanh lịch này.","Hue Riverside Resort là một điểm đến lý tưởng cho những ai muốn tìm kiếm một nơi yên tĩnh, thanh bình","Khám phá Hue Riverside Resort - nơi bạn có thể kết nối với thiên nhiên, tận hưởng những khoảnh khắc yên bình bên người thân yêu.","Với vị trí đắc địa bên bờ sông Hương, tất cả các phòng của resort đều có view sông, mang lại cảm giác thư thái và bình yên"],"content":[{"type":"paragraph","text":"Hue Riverside Boutique Resort &amp; Spa là một trong số ít khu nghỉ dưỡng sinh thái tại Huế.Bạn không chỉ có được trải nghiệm chân thực hơn mà chuyến đi của bạn còn có lợi cho môi trường. Là một Khu nghỉ dưỡng sinh thái, chúng tôi tận tâm bảo tồn vẻ đẹp của môi trường tự nhiên, sử dụng năng lượng thiên nhiên như năng lượng mặt trời, cối xay gió để cung cấp năng lượng cho các hoạt động hàng ngày và giảm thiểu chất thải."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/hue-riverside-boutique-resortand-spa/blog/gwd0qiggdw35lagl.webp","caption":""},{"type":"paragraph","text":"Với mỗi lời chào của người dân Thủy Biều đều bắt đầu bằng một nụ cười dễ lây lan, bạn không thể không yêu nơi đẹp như mơ này và con người nơi đây. Ngay từ khoảnh khắc bạn đến, bạn sẽ cảm thấy được ôm ấp bằng sự ấm áp và lòng hiếu khách vốn có trong mọi khía cạnh của văn hóa Việt Nam. Đây là nơi để cảm thấy được yêu thương, nuôi dưỡng và chào đón bởi đội ngũ nhân viên tại đây."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/hue-riverside-boutique-resortand-spa/blog/7ioxkyqvqhl6nesd.webp","caption":""},{"type":"paragraph","text":"Tại Resort, bạn có thể nghe thấy mọi hơi thở của thiên nhiên như tiếng chim hót, tiếng dế kêu trên thảm cỏ xanh, tiếng bướm đủ màu sắc."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/hue-riverside-boutique-resortand-spa/blog/f2dug37qypp9wcst.webp","caption":""}],"rooms":[{"id":"66fa9e580b818e5ee74c7736","title":"Deluxe River View","size":25,"maxPersons":2,"price":1350000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/hue-riverside-boutique-resortand-spa/Deluxe River View/q269icq5clck835t.webp","tour/hue-riverside-boutique-resortand-spa/Deluxe River View/4phjkw5kwlvnyr0g.webp","tour/hue-riverside-boutique-resortand-spa/Deluxe River View/otxsphzynjoi4n6b.webp"]},{"id":"66fa9e580b818e5ee74c7734","title":"Superior River View","size":25,"maxPersons":2,"price":1150000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/hue-riverside-boutique-resortand-spa/Superior River View/0wa7iund7zcc29hc.webp","tour/hue-riverside-boutique-resortand-spa/Superior River View/0hsgi56jp5iv2hky.webp","tour/hue-riverside-boutique-resortand-spa/Superior River View/e90mao9h7tbn5m2b.webp"]},{"id":"66fa9e580b818e5ee74c773a","title":"Triple Deluxe River View","size":30,"maxPersons":3,"price":1850000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/hue-riverside-boutique-resortand-spa/Triple Deluxe River View/5zpf426nrttgmagm.webp","tour/hue-riverside-boutique-resortand-spa/Triple Deluxe River View/gnhf2ifoydc0gbii.webp","tour/hue-riverside-boutique-resortand-spa/Triple Deluxe River View/zb03yf69tow9iyfj.webp","tour/hue-riverside-boutique-resortand-spa/Triple Deluxe River View/vvstx3e8yb5mamkh.webp"]},{"id":"66fa9e580b818e5ee74c7738","title":"Triple Superior River View","size":30,"maxPersons":3,"price":1700000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/hue-riverside-boutique-resortand-spa/Triple Superior River View/xfuugy4p1vrazgfc.webp","tour/hue-