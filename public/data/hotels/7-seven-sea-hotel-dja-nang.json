àng, spa, phòng hội nghị. Bên cạnh đó, khách sạn cũng cung cấp dịch vụ đón/tiễn sân bay theo yêu cầu của du khách.&nbsp;"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/7-seven-sea-hotel-dja-nang/blog/xcny4tuysgpaz36e.webp","caption":""},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/7-seven-sea-hotel-dja-nang/blog/xuieohgiaf084y48.webp","caption":""}],"rooms":[{"id":"66f273c40b818e5ee74b64ec","title":"Superior","size":24,"maxPersons":2,"price":950000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/7-seven-sea-hotel-dja-nang/Superior/pl3pmn3804wq64eo.webp","tour/7-seven-sea-hotel-dja-nang/Superior/lr3yzy38dla70vfu.webp","tour/7-seven-sea-hotel-dja-nang/Superior/n84euvg5ikcw1vjo.webp","tour/7-seven-sea-hotel-dja-nang/Superior/16qa5tstwwhy2w0g.webp","tour/7-seven-sea-hotel-dja-nang/Superior/6w2oifv7o2io1q5p.webp"]},{"id":"66f276740b818e5ee74b6982","title":"Ocean Suite","size":35,"maxPersons":2,"price":1650000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/7-seven-sea-hotel-dja-nang/Ocean Suite/eo3op464ceh0ux76.webp","tour/7-seven-sea-hotel-dja-nang/Ocean Suite/sq4lxml5zbdusubf.webp","tour/7-seven-sea-hotel-dja-nang/Ocean Suite/rghf5iifcg98y193.webp","tour/7-seven-sea-hotel-dja-nang/Ocean Suite/sm3d2gsgsq2zkokr.webp","tour/7-seven-sea-hotel-dja-nang/Ocean Suite/qxi72zxhrdkieuk4.webp","tour/7-seven-sea-hotel-dja-nang/Ocean Suite/pjb29u9o5g4khs7o.webp","tour/7-seven-sea-hotel-dja-nang/Ocean Suite/bnvnoonyz0j8ucjg.webp","tour/7-seven-sea-hotel-dja-nang/Ocean Suite/bffs0urbrdc4p9sl.webp","tour/7-seven-sea-hotel-dja-nang/Ocean Suite/5jrzexo1nh72mhs8.webp","tour/7-seven-sea-hotel-dja-nang/Ocean Suite/0j5ghjdrvwifsk8s.webp"]},{"id":"66f276740b818e5ee74b697c","title":"Deluxe Triple","size":33,"maxPersons":3,"price":1200000,"salePrice":0,