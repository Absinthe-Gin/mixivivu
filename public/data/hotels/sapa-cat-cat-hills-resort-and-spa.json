s/tl6ucnji9r6dx1gx.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/9nbdtneuwlsm1c8c.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/uw3nr18ywnndtjdn.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/9kdisqdtpzctdp53.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/r8qeemvyznbgbxbo.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/9sfyl270vdpuqimr.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/1tj2yozb8h8e93co.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/28utqoeom7lhpsrt.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/flrcnwfvo6oegoxy.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/lmv0h0nv16lnzqhc.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/hff8g4wcx58j10t1.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/m7ymnvuapjplkcpw.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/p71z2sg4tk5x0aat.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/qi6n5oij7fubmgxi.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/mqt3rcs0ll58oqfe.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/bzy33bu2mjbh55ni.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/nr5px73by8v69e23.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/b8tsef9z14oil4db.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/r1zbl05jck9anen7.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/tvv7oeclkb48ya7y.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/5pozu5y0d43mphsv.webp","tour/sapa-cat-cat-hills-resort-and-spa/images/g8ta67julwxz0yip.webp"],"highlights":["Hãy tưởng tượng bạn đang ngồi trước ban công phòng, trước mắt là thung lũng Mường Hoa thơ mộng, xa xa là những thửa ruộng bậc thang đang mùa xanh ngát.","Tận hưởng không gian riêng tư, hòa mình vào thiên nhiên với bungalow rộng rãi, đầy đủ tiện nghi.","Phòng cao cấp với tầm nhìn ngoạn mục ra dãy Hoàng Liên Sơn hùng vĩ, mang đến trải nghiệm nghỉ dưỡng đẳng cấp."],"content":[{"type":"paragraph","text":"Catcat Hills Resort &amp; Spa - một không gian nghỉ dưỡng phù hợp cho mọi chuyến đi của bạn. Được tọa lạc tại vị trí tuyệt đẹp của thung lũng Mường Hoa cùng khung cảnh thiên nhiên ưu ái ban tặng, Catcat Hills rực rỡ như một đồi kỳ quan lộng lẫy giữa lòng đất bản."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/sapa-cat-cat-hills-resort-and-spa/blog/4ry6mio3jxrsb9br.webp","caption":""},{"type":"paragraph","text":"Sở hữu lối kiến trúc mang đậm văn hóa vùng cao Tây Bắc và tầm nhìn thẳng hướng thung lũng Mường Hoa, căn phòng Superior của Catcat Hills Sapa Resort &amp; Spa là không gian lưu trú giúp bạn cảm nhận sự thư thái lý tưởng trong kỳ nghỉ của mình."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/sapa-cat-cat-hills-resort-and-spa/blog/mjacrl9y3qxil689.webp","caption":""},{"type":"paragraph","text":"Silk Path Sapa Grand Resort &amp; Spa, nơi mang đến cho bạn trải nghiệm nghỉ dưỡng đẳng cấp và thư giãn tuyệt vời. Tọa lạc trên ngọn đồi riêng biệt, chỉ cách trung tâm thị trấn Sapa 2km,&nbsp;<a href=\"https://ticotravel.com.vn/resort/silk-path-sapa/\">Silk Path Sapa</a>&nbsp;sở hữu vẻ đẹp tinh tế hòa quyện giữa phong cách kiến trúc Đông Dương và bản sắc văn hóa Sapa độc đáo."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/sapa-cat-cat-hills-resort-and-spa/blog/0ui8k4egdqxx5dm3.webp","caption":""}],"rooms":[{"id":"66f504790b818e5ee74be63b","title":"Premier Superior","size":28,"maxPersons":2,"price":2280000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/sapa-cat-cat-hills-resort-and-spa/Premier Superior /n9jjlco2n0cfqanf.webp","tour/sapa-cat-cat-hills-resort-and-spa/Premier Superior /lbufifiwnmnqndk7.webp","tour/sapa-cat-cat-hills-resort-and-spa/Premier Superior /rfsjgknqbhwazzdk.webp","tour/sapa-cat-cat-hills-resort-and-spa/Premier Superior /ufuwdb1rsjeclovm.webp","tour/sapa-cat-cat-hills-resort-and-spa/Premier Superior /xsi3nvyx6i5l0ir7.webp","tour/sapa-cat-cat-hills-resort-and-spa/Premier Supe