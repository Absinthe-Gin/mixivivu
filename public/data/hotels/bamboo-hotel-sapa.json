ges/e5dsjifmvgpfnbd5.webp","tour/bamboo-hotel-sapa/images/spsc6nb7owvcr7sj.webp","tour/bamboo-hotel-sapa/images/3g6rhnp0segnisxa.webp","tour/bamboo-hotel-sapa/images/9si226ldph97pmxi.webp","tour/bamboo-hotel-sapa/images/djn6dsb9xo71yejj.webp","tour/bamboo-hotel-sapa/images/gj2qa11iiwzvke2f.webp","tour/bamboo-hotel-sapa/images/bcx6j72vhj58x2ts.webp","tour/bamboo-hotel-sapa/images/zzcjalmwytjinlzy.webp","tour/bamboo-hotel-sapa/images/rojo4kzsab48n60d.webp","tour/bamboo-hotel-sapa/images/dkjlw6x5442yqv6f.webp","tour/bamboo-hotel-sapa/images/94vbwumiajmgubdy.webp","tour/bamboo-hotel-sapa/images/c5j2vzudcnedfc89.webp","tour/bamboo-hotel-sapa/images/5m1rpi3bzmglzczr.webp","tour/bamboo-hotel-sapa/images/xxyqb0dmspj44dko.webp","tour/bamboo-hotel-sapa/images/e2rp7zbq71awtgke.webp","tour/bamboo-hotel-sapa/images/hykc7a5e3or8trzd.webp","tour/bamboo-hotel-sapa/images/nohetyhuobrgyu6h.webp","tour/bamboo-hotel-sapa/images/b0ohv3kayy79b6dn.webp","tour/bamboo-hotel-sapa/images/li3u4c30du1f4yz5.webp","tour/bamboo-hotel-sapa/images/oy66motpuf0j8uxf.webp","tour/bamboo-hotel-sapa/images/edo2dnp7ngqreq7z.webp","tour/bamboo-hotel-sapa/images/vbvt7c1y4l6ewd55.webp","tour/bamboo-hotel-sapa/images/69zr8nqisg7urmyx.webp","tour/bamboo-hotel-sapa/images/r45uk09gk93m8pqi.webp","tour/bamboo-hotel-sapa/images/smjpuxppgxu3hz1s.webp","tour/bamboo-hotel-sapa/images/z2wzib3kchg2xlk3.webp"],"highlights":["Với thiết kế ấn tượng, trang bị đầy đủ hệ thống âm thanh ánh sáng tối tân, đội ngũ nhân viên chuyên nghiệp. Hứa hẹn mang thành công tới mọi bữa tiệc, sự kiện lớn nhỏ của Du khách.","Nhà hàng sang trọng, có sức chứa 250 khách, mở ra một không gian trải nghiệm ẩm thực đặc sắc với tầm nhìn tuyệt đẹp hướng thung lũng và menu đa dạng các món ăn từ Á - Âu.","Trong không gian yên tĩnh với hương thảo mộc nhẹ dịu, từng động tác massage chuyên nghiệp, tinh tế và tắm lá thuốc Dao đỏ giúp bạn lấy lại cân bằng cho cơ thể, tận hưởng sự thư giãn tuyệt đối.","Bamboo Eden gây ấn tượng nhờ thiết kế độc đáo, đem đến cho Du khách cảm giác chạm tay tới khoảnh khắc hòa cùng mây trời trong không gian đầy thơ mộng."],"content":[{"type":"paragraph","text":"Được biết tới là khách sạn có bể bơi vô cực đầu tiên tại Sapa, Bamboo Sapa Hotel cung cấp dịch vụ nghỉ dưỡng đẳng cấp với 106 phòng nghỉ đạt chuẩn 4 sao quốc tế, cùng tầm view “triệu đô”, ngắm trọn vẻ hoang sơ, hùng vĩ của dãy Hoàng Liên Sơn, vẻ đẹp thơ mộng của thung lũng Mường Hoa. Bamboo Sapa Hotel xứng đáng trở thành điểm đến đầy quyến rũ cho bất cứ Du khách nào đặt chân tới  “Thị trấn mờ sương”."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/bamboo-hotel-sapa/blog/31a1ghifnughunix.webp","caption":""},{"type":"paragraph","text":"Ở Bamboo Sapa Hotel, mọi không gian đều được thiết kế hài hòa, toát lên vẻ sang trọng, hiện đại nhưng vẫn giữ bản sắc văn hóa dân tộc, mang đậm hơi thở miền núi cao. Đặc biệt, chiều lòng Du khách với bể bơi vô cực và Bamboo Eden, các “tín đồ sống ảo” có thể tha hồ chụp choẹt với những góc check-in siêu ấn tượng tại đây."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/bamboo-hotel-sapa/blog/aqwm1r4et72r16ea.webp","caption":""},{"type":"paragraph","text":"Không chỉ dừng lại ở đó, Bamboo Sapa Hotel còn đáp ứng đầy đủ nhu cầu nghỉ dưỡng của Du khách với nhà hàng đạt chuẩn, Bamboo Spa chất lượng, phòng Gym hiện đại và phòng họp, hội nghị cao cấp. Chính vì vậy, Bamboo Sapa Hotel hoàn toàn tự tin mang đến cho Du khách những trải nghiệm tuyệt vời nhất, cùng Du khách làm nên một kỳ nghỉ dưỡng hoàn hảo tại Sapa."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/bamboo-hotel-sapa/blog/7ysfkn6lq4y66ig1.webp","caption":""}],"rooms":[{"id":"66f58d830b818e5ee74c279e","title":"Superior Mountain View","size":28,"maxPersons":2,"price":1850000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/bamboo-hotel-sapa/Superior Mountain View/h1kizmwx05gzewsf.webp","tour/bamboo-h