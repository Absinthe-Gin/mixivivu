/images/h1a05jg02htse51l.webp","tour/paos-sapa-leisure-hote/images/9cr3cau9yoxifp7v.webp","tour/paos-sapa-leisure-hote/images/glk9tuy3xmy2f5qm.webp","tour/paos-sapa-leisure-hote/images/6z3vi0wys49wu2hq.webp","tour/paos-sapa-leisure-hote/images/y8r8h49uas8yqmmk.webp","tour/paos-sapa-leisure-hote/images/pt5l0jit80ck7vu6.webp","tour/paos-sapa-leisure-hote/images/z26an3w4kmdhbasa.webp","tour/paos-sapa-leisure-hote/images/m34nt59afwqbypxq.webp","tour/paos-sapa-leisure-hote/images/gvsfs5qjocmmknnv.webp","tour/paos-sapa-leisure-hote/images/reuk1ssav5l1cuga.webp","tour/paos-sapa-leisure-hote/images/m4sa3d9uvh7pyfn9.webp","tour/paos-sapa-leisure-hote/images/9a47q220hu7hl8i5.webp","tour/paos-sapa-leisure-hote/images/6hzam5v7ub5iwl4m.webp","tour/paos-sapa-leisure-hote/images/7xrebm4am8gdp052.webp","tour/paos-sapa-leisure-hote/images/agx3k4d2u5jt8kqc.webp","tour/paos-sapa-leisure-hote/images/a56dulq673x27tx3.webp","tour/paos-sapa-leisure-hote/images/ejv7podz8istfq7s.webp","tour/paos-sapa-leisure-hote/images/pr24x1eozf3ru6dz.webp","tour/paos-sapa-leisure-hote/images/dr0eize3fh92eydi.webp","tour/paos-sapa-leisure-hote/images/o13haaih3vxas2vw.webp","tour/paos-sapa-leisure-hote/images/z2p90zxzal2fqlto.webp","tour/paos-sapa-leisure-hote/images/vt6m1tliucgy00m2.webp"],"highlights":["Thả hồn giữa bầu trời Sapa rực rỡ, thả dáng giữa khu vườn nên thơ, thả trôi tất cả âu lo trong chuyến đi ngập tràn sắc màu thanh xuân tại Pao's Sapa - điểm đến yêu thích của những nàng thơ giữa mây trời Tây Bắc.","Nằm trên sườn đồi giữa những ngọn núi hùng vĩ với tầm nhìn ngoạn mục ra thung lũng Mường Hoa thơ mộng và dãy núi Hoàng Liên Sơn hùng vĩ, Pao's Sapa Leisure tự hào là hiện thân của sự sang trọng bậc nhất tại trung tâm thị trấn miền núi Sapa.","Pao's Sapa Leisure Hotel là điểm đến tuyệt vời cho chuyến tham quan sẽ kích thích các giác quan và trẻ hóa tâm hồn.","Tất cả các phòng đều có tiện nghi riêng, không gian thoáng đãng và ban công lãng mạn nhìn ra quang cảnh thiên nhiên hùng vĩ của vùng Tây Bắc."],"content":[{"type":"paragraph","text":"Là một trong những khách sạn có view đẹp nhất Sapa do nằm ngay sát sườn núi, Pao’s Sapa Leisure Hotel có không gian rộng và thoáng mát, bao quanh bởi thung lũng Mường Hoa xanh ngát và những dãy núi ngút ngàn"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/paos-sapa-leisure-hote/blog/7gsqahibz046uydq.webp","caption":""},{"type":"paragraph","text":"Khách sạn tọa lạc trong bán kính 2,6 km từ ga cáp treo Fansipan Legend, từ đây khá thuận tiện để thăm thú các địa điểm du lịch khác của thành phố như hồ Sapa, nhà thờ cổ, quảng trường trung tâm, núi Hàm Rồng…"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/paos-sapa-leisure-hote/blog/04moyxir3r83jhl0.webp","caption":""},{"type":"paragraph","text":"Pao’s Sapa mang đến cho du khách 223 không gian nghỉ dưỡng mang đậm bản sắc văn hóa địa phương, hòa quyện tinh tế cùng nội thất tiêu chuẩn và dịch vụ hoàn hảo."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/paos-sapa-leisure-hote/blog/10pkdb91h959ubxh.webp","caption":""},{"type":"paragraph","text":"Sở hữu lối thiết kế ấn tượng với những đường cong duyên dáng, mềm mại tiếp nối, Pao’s Sapa Leisure hứa hẹn là điểm dừng chân lý tưởng để du khách thư giãn và khơi dậy mọi giác quan."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/paos-sapa-leisure-hote/blog/9rlshykeiryz79pr.webp","caption":""}],"rooms":[{"id":"66f3d23d0b818e5ee74bacf7","title":"Deluxe Garden View","size":30,"maxPersons":2,"price":2300000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/paos-sapa-leisure-hote/Deluxe Garden View/j78wddnlk5syhvia.webp","tour/paos-sapa-leisure-hote/Deluxe Garden View/tbig7v38lvcieg4b.webp"]},{"id":"66f3d23d0b818e5ee74bacfb","title":"Super Deluxe","size":30,"maxPersons":2,"price":2700000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar",