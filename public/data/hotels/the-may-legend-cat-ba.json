w01l58f.webp","caption":""},{"type":"paragraph","text":"Không gian xung quanh resort được bao phủ bởi màu xanh của rừng và biển, mang lại cho du khách cảm giác vô cùng thư thái. "},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/the-may-legend-cat-ba/blog/ukxdu0dfpa1qda8z.webp","caption":""},{"type":"paragraph","text":"Tất cả phòng nghỉ đều có ban công hướng nhìn ra vịnh, vật liệu xây dựng chủ yếu từ gỗ và mây tre đan vô cùng ấm cúng. Lựa chọn Resort này chắc chắn sẽ làm cho chuyến đi của du khách có nhiều cảm xúc không thể nào quên.&nbsp;"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/the-may-legend-cat-ba/blog/2wxusltb8wzsv1zj.webp","caption":""}],"rooms":[{"id":"6875d29e7f201468c388070d","title":"Superior Mountain view","size":24,"maxPersons":2,"price":2050000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/the-may-legend-cat-ba/Superior Mountain view/gl1n5oht56rwrypk.webp","tour/the-may-legend-cat-ba/Superior Mountain view/tybtyds8rr1ss6qv.webp","tour/the-may-legend-cat-ba/Superior Mountain view/nbi6gprc3uujv3s8.webp","tour/the-may-legend-cat-ba/Superior Mountain view/mnmkm2lqd8dovqlr.webp","tour/the-may-legend-cat-ba/Superior Mountain view/uic5492hcwyder4q.webp"]},{"id":"6875d29e7f201468c388070f","title":"Superior Ocean view","size":25,"maxPersons":2,"price":2450000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/the-may-legend-cat-ba/Superior Ocean view/yf7lnmwnmm3zpevr.webp","tour/the-may-legend-cat-ba/Superior Ocean view/2t5s9nploqg2g19m.webp","tour/the-may-legend-cat-ba/Superior Ocean view/o321umhj6l4i63pd.webp","tour/the-may-legend-cat-ba/Superior Ocean view/qaqjmp5y34x1ttx0.webp"]},{"id":"6875d29e7f201468c3880711","title":"Deluxe Suite Garden view","size":46,"maxPersons":2,"price":2450000,"salePrice":0,"features":["Điều hòa","