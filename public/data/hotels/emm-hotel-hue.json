p","tour/emm-hotel-hue/images/jf1u4dnh5e8a49re.webp","tour/emm-hotel-hue/images/468v4z1bhu1zpldk.webp","tour/emm-hotel-hue/images/xr5n9q2kncc1worz.webp","tour/emm-hotel-hue/images/q5xqixjeko2qbgop.webp","tour/emm-hotel-hue/images/k6lexxuyziyciiz7.webp","tour/emm-hotel-hue/images/fzt4n9k60tblzuzv.webp","tour/emm-hotel-hue/images/bqv5us3lguy2sh0i.webp","tour/emm-hotel-hue/images/g7mji8raw42n91p5.webp","tour/emm-hotel-hue/images/v887otg7z01lwn8d.webp","tour/emm-hotel-hue/images/04nazu0kjodwn7mq.webp","tour/emm-hotel-hue/images/xyyctkv68gx6iea5.webp","tour/emm-hotel-hue/images/5vt9a6cqt18zyn7f.webp","tour/emm-hotel-hue/images/w4k1s0qwmik1098k.webp","tour/emm-hotel-hue/images/fdo0zik5oggkqixa.webp","tour/emm-hotel-hue/images/8cio1vcww7t4v2sc.webp","tour/emm-hotel-hue/images/aec88c2qj137gnb3.webp","tour/emm-hotel-hue/images/zkujq8rubca3vh6k.webp","tour/emm-hotel-hue/images/g6iq7k6d9ayn5peo.webp","tour/emm-hotel-hue/images/njfit3jf9wpmuh8w.webp","tour/emm-hotel-hue/images/fzbtow0s9t1ayby9.webp","tour/emm-hotel-hue/images/5ovsu3hs2p8xuhcf.webp","tour/emm-hotel-hue/images/xsuaojjhnfuh6ed8.webp","tour/emm-hotel-hue/images/dropotqkmh9snxx0.webp","tour/emm-hotel-hue/images/jth60weylnn064v3.webp","tour/emm-hotel-hue/images/z9n8fxm06dtyizkh.webp","tour/emm-hotel-hue/images/u8y2zfwgtrmeirom.webp","tour/emm-hotel-hue/images/p4hp0ykmv8n1zz50.webp"],"highlights":["Khách sạn ÊMM Huế được trang bị đầy đủ các dịch vụ & tiện ích từ ăn uống, giải trí đến phòng họp… nhằm mang lại không gian nghỉ dưỡng & công tác trọn vẹn nhất.","Dễ dàng nạp lại năng lượng ngay cuối tuần này trong không gian bể bơi xanh mát, thiết kế hiện đại và phục vụ tận tâm của ÊMM Hotel Hue","ọa lạc ngay trung tâm thành phố, dễ dàng tiếp cận mọi điểm đến nổi tiếng của Huế như Sông Hương, Cầu Tràng Tiền, Chợ Đông Ba và Tử Cấm Thành,...","Không gian ấm cúng, gần gũi tại sảnh khách sạn ÊMM Huế, nơi bạn sẽ cảm nhận sự nồng hậu và chân thành của con người xứ Huế ngay từ khoảnh khắc đầu tiên."],"content":[{"type":"paragraph","text":"Tọa lạc giữa trung tâm Cố đô lịch sử – Di sản văn hóa thế giới, Khách sạn ÊMM Huế là điểm dừng chân tựa một “ngôi nhà xa xứ” với thiết kế hiện đại, dịch vụ tận tâm và tiện nghi chuẩn quốc tế."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/emm-hotel-hue/blog/ffpo91qhf9akebkg.webp","caption":""},{"type":"paragraph","text":"Chiêm ngưỡng những cảnh quan tuyệt đẹp của ÊMM Hotel Hue từ góc nhìn bao quát! Tọa lạc tại trung tâm thành phố Huế, khách sạn mang đến sự kết hợp hoàn hảo giữa nét đẹp truyền thống và tiện nghi hiện đại."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/emm-hotel-hue/blog/avtflbdiv9s7oxk5.webp","caption":""},{"type":"paragraph","text":"Thả mình vào không gian xanh mát và yên bình nơi có hồ bơi và sân vườn thư thái, bạn sẽ cảm nhận được sự thư thái và thoải mái tuyệt đối. Với thiết kế tinh tế, phòng ốc rộng rãi và dịch vụ chu đáo, ÊMM Hotel Hue là nơi lý tưởng để bạn nghỉ ngơi và khám phá cố đô Huế."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/emm-hotel-hue/blog/wmcgb87e41enuh3j.webp","caption":""},{"type":"paragraph","text":"Cùng ÊMM Hotel Hue, mỗi chuyến đi không chỉ là khám phá những vẻ đẹp thiên nhiên, mà còn là hành trình vun đắp sự thấu hiểu và hòa hợp giữa các dân tộc. Mỗi điểm đến không chỉ mang lại sự thư giãn, mà còn là cơ hội để gắn kết, sẻ chia và phát triển mối quan hệ bền vững với con người và thiên nhiên."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/emm-hotel-hue/blog/lhtcjc2linou0f1r.webp","caption":""}],"rooms":[{"id":"66f980c60b818e5ee74c4c5d","title":"Superior","size":30,"maxPersons":2,"price":1200000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/emm-hotel-hue/Superior/v5vv5wzgwnop21ys.webp","tour/emm-hotel-hue/Superior/okc3ucj2lwl7bipz.webp","tour/emm-hotel-hue/Superior/nygsgxk6yz16ds82.webp"]},{"id":"66f980c60b818e5ee74c4c5f","title":"Deluxe","size":32,"maxPersons":2,"price":1300000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/emm-hotel-hue/Deluxe/r7jkk4rca8yx5ckt.webp","tour/emm-hotel-hue/Deluxe/asrbzg8g7kmgro88.webp","tour/emm-hotel-hue/Deluxe/54lxsb4h5kitt3wz.webp","tour/emm-hotel-hue/Deluxe/q5jncw8tkoa42iad.webp"]},{"id":"66f980c60b818e5ee74c4c61","title":"Family","size":45,"maxPersons":4,"price":2050000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/emm-hotel-hue/Family/ibyvuj6bn91t59i3.webp","tour/emm-hotel-hue/Family/f54p9mim69rdx7x0.webp"]}],"reviews":[]}