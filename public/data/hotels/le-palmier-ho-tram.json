n nghi để tận hưởng trọn vẹn hạnh phúc và vừa đủ riêng tư để mọi cảm xúc được lắng đọng."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/le-palmier-ho-tram/blog/qw9n776gzsoeq7ry.webp","caption":""},{"type":"paragraph","text":"Le Palmier Hồ Tràm không chỉ là một điểm đến nghỉ dưỡng, mà còn là một điểm đến khó quên cho bạn và gia đình để tận hưởng kỳ nghỉ trong lòng thiên nhiên xanh mát, từ những đám cỏ, bóng cây đến những hàng dừa duyên dáng. Một nơi ta tìm về với yên bình."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/le-palmier-ho-tram/blog/9r7p02fkuboqv420.webp","caption":""}],"rooms":[{"id":"67c7f670116b96bc5b772ee8","title":"Superior","size":45,"maxPersons":2,"price":1800000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/le-palmier-ho-tram/Superior/j7d1d355ukflvg3d.webp","tour/le-palmier-ho-tram/Superior/2vvil9awcwvr9isu.webp","tour/le-palmier-ho-tram/Superior/oygghq32xv8kgt6c.webp","tour/le-palmier-ho-tram/Superior/nixocwjkaxfamv90.webp","tour/le-palmier-ho-tram/Superior/xm9rjlwovuocfno9.webp"]},{"id":"67c7f670116b96bc5b772eea","title":"Deluxe","size":50,"maxPersons":2,"price":1950000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/le-palmier-ho-tram/Deluxe/coapp1n9qeoh20po.webp","tour/le-palmier-ho-tram/Deluxe/dppbdgpzasaf22ok.webp","tour/le-palmier-ho-tram/Deluxe/x68yrirqfq0bx5a1.webp","tour/le-palmier-ho-tram/Deluxe/j6a2l4y64vpg7qte.webp","tour/le-palmier-ho-tram/Deluxe/7t3da8q0ygwlfb12.webp","tour/le-palmier-ho-tram/Deluxe/6irrfbtc35ufptd1.webp","tour/le-palmier-ho-tram/Deluxe/1kz3ctvbyliik7ze.webp"]},{"id":"67c7f670116b96bc5b772eec","title":"Luxury Ocean View","size":65,"maxPersons":2,"price":2200000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đ