tel/images/xd3wvcgclmh3osfc.webp","tour/sala-dja-nang-beach-hotel/images/rpwx6714l5t7jahx.webp","tour/sala-dja-nang-beach-hotel/images/lv9izgmj3ovq5z96.webp","tour/sala-dja-nang-beach-hotel/images/9shbxt8795vvz3hg.webp","tour/sala-dja-nang-beach-hotel/images/nssqfneh7s2u9p29.webp","tour/sala-dja-nang-beach-hotel/images/iloeopjs1jvhzhga.webp","tour/sala-dja-nang-beach-hotel/images/8k1t4yaw4qalbn7n.webp","tour/sala-dja-nang-beach-hotel/images/o9ns2l4o97uiuvci.webp","tour/sala-dja-nang-beach-hotel/images/vtzhlconnpyhsa6t.webp"],"highlights":["Khách sạn chỉ cách bãi biển Mỹ Khê vài phút di chuyển","Thiết kế hiện đại mang phong cách Nhật Bản","Phòng nghỉ đầy đủ tiện ích như: tivi màn hình phẳng, phòng tắm riêng, máy sấy tóc, két an toàn...","Khách sạn cũng sở hữu bể bơi vô cực độc đáo tại tầng thượng cùng với nhà hàng, quầy bar ấn tượng"],"content":[{"type":"paragraph","text":"Khách sạn Sala Beach tọa lạc tại trung tâm thành phố biển Đà Nẵng chỉ cách bãi biển Mỹ Khê vài phút di chuyển. Với thiết kế hiện đại mang phong cách Nhật Bản, khách sạn gồm 162 phòng nghỉ được trang bị đầy đủ các tiện ích như: tivi màn hình phằng, phòng tắm, tầm nhìn thoáng và rộng rãi.&nbsp;"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/sala-dja-nang-beach-hotel/blog/61kokur8s6z2ceim.webp","caption":"Tầm nhìn tuyệt đẹp"},{"type":"paragraph","text":"Nhà hàng Nhật Bản phục vụ bữa sáng buffet, bữa trưa và tối theo thực đơn có sẵn hoặc yêu cầu của du khách."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/sala-dja-nang-beach-hotel/blog/ib3fo8t4pmpkljqx.webp","caption":"Nhà hàng khách sạn"},{"type":"paragraph","text":"Ngoải ra, bể bơi vô cực của khách sạn trên tầng thượng cũng là điểm thu hút không thể bỏ qua của du khách. Tại đây, du khách có thể thu trọn vào tầm mắt sự mênh mông của biển cả với không gian vô cùng thoáng đãng."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/sala-dja-nang-beach-hotel/blog/ww1kx3l0en3wivm2.webp","caption":"Hồ bơi vô cực"}],"rooms":[{"id":"66e7d9430b818e5ee7498f2c","title":"Deluxe Sea View","size":32,"maxPersons":2,"price":1850000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/sala-dja-nang-beach-hotel/Deluxe Sea View/skmz9os11ybrt5op.webp","tour/sala-dja-nang-beach-hotel/Deluxe Sea View/8hh03yooosbnaobh.webp","tour/sala-dja-nang-beach-hotel/Deluxe Sea View/nhbj4dckhy6wyrq7.webp","tour/sala-dja-nang-beach-hotel/Deluxe Sea View/3k3gzs0ktiqeb7s6.webp","tour/sala-dja-nang-beach-hotel/Deluxe Sea View/rzomq22q79t1vjqn.webp","tour/sala-dja-nang-beach-hotel/Deluxe Sea View/akz6mf7oeundmr32.webp","tour/sala-dja-nang-beach-hotel/Deluxe Sea View/t94favq0tilq6lh6.webp","tour/sala-dja-nang-beach-hotel/Deluxe Sea View/euizb4dhgqub296p.webp","tour/sala-dja-nang-beach-hotel/Deluxe Sea View/hhp031o1iycbyoel.webp","tour/sala-dja-nang-beach-hotel/Deluxe Sea View/hnmm4pbiodwizfdi.webp"]},{"id":"66e7d9430b818e5ee7498f2e","title":"Suite Partial Sea View","size":45,"maxPersons":2,"price":2050000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/sala-dja-nang-beach-hotel/Suite Partial Sea View/kv0rxlig2r1gcu5o.webp","tour/sala-dja-nang-beach-hotel/Suite Partial Sea View/skezof7165px58rk.webp","tour/sala-dja-nang-beach-hotel/Suite Partial Sea View/o9hg15bacyvc0fkr.webp","tour/sala-dja-nang-beach-hotel/Suite Partial Sea View/8aviuutr1zyda3y2.webp"]},{"id":"66e7d9430b818e5ee7498f34","title":"Premium Suite","size":55,"maxPersons":2,"price":3350000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/sala-dja-nang-beach-hotel/Premium Suite/i9df8yjgg3465uw5.webp","tour/sala-dja-nang-beach-hotel/Premium Suite/r1xld72g9trbciuw.webp","tour/sala-dja-nang-beach-hotel/Premium Suite/nhvelbzf7s7vas0j.webp","tour/s