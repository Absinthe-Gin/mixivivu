otel-and-spa-hue/images/8ukw4vyz0wiytmyf.webp","tour/baly-hotel-and-spa-hue/images/o7h1xduoqe5bq8xm.webp","tour/baly-hotel-and-spa-hue/images/m2ia1dca8vdai3rt.webp","tour/baly-hotel-and-spa-hue/images/s82bbnd21xziz6n0.webp","tour/baly-hotel-and-spa-hue/images/fdn6zpnp5kvq4ggh.webp","tour/baly-hotel-and-spa-hue/images/0914usdgoc8dh84o.webp","tour/baly-hotel-and-spa-hue/images/6anif6r3b9zfa9up.webp","tour/baly-hotel-and-spa-hue/images/r5sarabnyos56s26.webp","tour/baly-hotel-and-spa-hue/images/xmdn51muqk2aysf0.webp","tour/baly-hotel-and-spa-hue/images/w0pbggoshzulvli1.webp","tour/baly-hotel-and-spa-hue/images/fa16zd7ggj65ng8o.webp","tour/baly-hotel-and-spa-hue/images/8xw9pe8xrbz1fijm.webp","tour/baly-hotel-and-spa-hue/images/3s2984nxwpijed9z.webp","tour/baly-hotel-and-spa-hue/images/2bdnyj2wdmtbluce.webp","tour/baly-hotel-and-spa-hue/images/l9pbqdvok1ih5a06.webp","tour/baly-hotel-and-spa-hue/images/eeias71i6x0y9n61.webp","tour/baly-hotel-and-spa-hue/images/1kxz2sq99yk987jr.webp","tour/baly-hotel-and-spa-hue/images/k77mbfhu32m0kggs.webp","tour/baly-hotel-and-spa-hue/images/1cecwcpgrckdtajd.webp","tour/baly-hotel-and-spa-hue/images/v0t4yd7s67l6o2vg.webp","tour/baly-hotel-and-spa-hue/images/modbunbo5mwfq831.webp","tour/baly-hotel-and-spa-hue/images/1v0u3be23x4vcgnw.webp","tour/baly-hotel-and-spa-hue/images/r1l82dff1632ta5c.webp","tour/baly-hotel-and-spa-hue/images/i1npw5pr7umjjpnm.webp","tour/baly-hotel-and-spa-hue/images/9cexkg4vxfqppt0b.webp"],"highlights":["Baby Hotel là một lựa chọn tuyệt vời cho khách du lịch khi đến thăm Huế, mang đến những tiện nghi hữu ích cho suốt thời gian lưu trú của bạn.","Là “ngôi nhà xa xứ,” các phòng cơ sở kinh doanh có dịch vụ giới hạn cung cấp điều hòa nhiệt độ, tủ lạnh và quầy bar mini, và kết nối mạng thật dễ dàng, với wifi miễn phí sẵn có.","Baly Hotel Hue nằm gần An Cuu Market và chỉ cách 15 phút đi bộ từ trung tâm của Huế. Khách sạn này cung cấp xông hơi khô, massage và các hoạt động giải trí, cũng như các phòng khách nhìn ra thành phố."],"content":[{"type":"paragraph","text":"<a href=\"https://www.vietnambooking.com/hotel/vietnam/baly-hue.html\">Baly Hotel</a>&nbsp;là khách sạn đạt chuẩn 3 sao&nbsp;tọa lạc tại số 181 Bà Triệu, phường Phú Hội, thành phố Huế. Với vị trí thuận lợi nằm cạnh bờ Nam sông Hương,&nbsp;từ khách sạn quý khách sẽ dễ dàng tiếp cận các danh lam, thắng cảnh nổi tiếng của đất cố đô như:&nbsp;Kinh thành Huế, sông Hương, Núi Ngự Bình,&nbsp;chợ Đông Ba,&nbsp;chùa Thiên Mụ... hoặc chỉ cần di chuyển&nbsp;vài bước chân, quý khách đã có thể đến với Big C Huế, Trung tâm Thể thao Thừa Thiên Huế..."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/baly-hotel-and-spa-hue/blog/x27kzsfhoyqzaan1.webp","caption":""},{"type":"paragraph","text":"BALY HOTEL AND SPA sở hữu đầy đủ các hạng phòng từ cơ bản đến các hạng phòng cao cấp cho du khách có thể thoải mái lựa chọn khi đến đây. Các hạng phòng tại đây được trang bị đầy đủ tất cả những yêu cầu của một hạng phòng cơ bản để mang đến một căn phòng tiện nghi nhất cho du khách."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/baly-hotel-and-spa-hue/blog/7jxnkfy0mrax59dx.webp","caption":""},{"type":"paragraph","text":"Với khoảng cách tầm 1km, Baly Hotel tự tin là khách sạn 3 sao gần AEON MALL nhất, hứa hẹn đáp ứng đầy đủ các tiêu chí của bạn và mang đến trải nghiệm lưu trú tuyệt vời, thoải mái nhất."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/baly-hotel-and-spa-hue/blog/ppniyylnge2fu2zv.webp","caption":""}],"rooms":[{"id":"66f9878a0b818e5ee74c4da3","title":"Family","size":40,"maxPersons":4,"price":1100000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/baly-hotel-and-spa-hue/Family/rf1i9p3k3o5z87wi.webp","tour/baly-hotel-and-spa-hue/Family/2llobd765cobw4uj.webp","tour/baly-hotel-and-spa-hue/Family/5gplwp0pch076vry.webp","tour/baly-hotel-and-spa-hue/Family/9saw430yarovtwgt.webp","tour/baly-