r/silk-path-grand-sapa-resort-and-spa/images/zqfn9obfjwkbt9sh.webp","tour/silk-path-grand-sapa-resort-and-spa/images/zoy775afrfggxvpk.webp","tour/silk-path-grand-sapa-resort-and-spa/images/la39qnstiismlfuq.webp","tour/silk-path-grand-sapa-resort-and-spa/images/khlu76cok9nunmba.webp","tour/silk-path-grand-sapa-resort-and-spa/images/zh09q36fi6h0h70o.webp","tour/silk-path-grand-sapa-resort-and-spa/images/xuqynpscduq9krvo.webp","tour/silk-path-grand-sapa-resort-and-spa/images/w9dl69sx69ztquik.webp","tour/silk-path-grand-sapa-resort-and-spa/images/sz5gmumuylnuytw4.webp","tour/silk-path-grand-sapa-resort-and-spa/images/0g8m7wy3xadfjgud.webp","tour/silk-path-grand-sapa-resort-and-spa/images/62tt2f57p58eg59y.webp","tour/silk-path-grand-sapa-resort-and-spa/images/7cgwxuwjgmr7ra18.webp","tour/silk-path-grand-sapa-resort-and-spa/images/jworcw39sni2wlh3.webp","tour/silk-path-grand-sapa-resort-and-spa/images/qm81yloj0rjbsebn.webp","tour/silk-path-grand-sapa-resort-and-spa/images/8alfv9sauigg6r5p.webp","tour/silk-path-grand-sapa-resort-and-spa/images/ffxc92yl8gpy131k.webp","tour/silk-path-grand-sapa-resort-and-spa/images/t29sp6480di2fdcv.webp","tour/silk-path-grand-sapa-resort-and-spa/images/b64r309s6piqmvgi.webp","tour/silk-path-grand-sapa-resort-and-spa/images/xexp6fbq4ys47rvi.webp","tour/silk-path-grand-sapa-resort-and-spa/images/1z61768al5xuymxb.webp","tour/silk-path-grand-sapa-resort-and-spa/images/fuouwambbse21rt9.webp","tour/silk-path-grand-sapa-resort-and-spa/images/i7cx5tjim6wfxku7.webp","tour/silk-path-grand-sapa-resort-and-spa/images/d54zomimt8hz9f7a.webp","tour/silk-path-grand-sapa-resort-and-spa/images/dr055u5d3elkq65l.webp","tour/silk-path-grand-sapa-resort-and-spa/images/lso6l6f9nx8vs1pd.webp","tour/silk-path-grand-sapa-resort-and-spa/images/uopanah5x782szgu.webp","tour/silk-path-grand-sapa-resort-and-spa/images/wbwzmorbrsqoecmv.webp","tour/silk-path-grand-sapa-resort-and-spa/images/xcmrmehiwwjy984b.webp","tour/silk-path-grand-sapa-resort-and-spa/images/0ky6k6cvtyw3m4px.webp"],"highlights":["Mỗi phòng nghỉ tại Silk Path Grand Sapa Resort & Spa là sự kết hợp hài hòa giữa kiến trúc Châu u thanh lịch với những nét chấm phá tinh hoa dân tộc thiểu số khu vực Tây Bắc.","Nuông chiều vị giác với những món ăn tinh hoa tại Silk Path Grand Sapa Resort & Spa, kết hợp hài hòa, tinh tế giữa nét độc đáo hương vị đặc trưng của vùng núi Tây Bắc và sự đa dạng trong văn hóa ẩm thực Đông Tây.","Silk Path Grand Sapa Resort & Spa sở hữu hệ thống cơ sở vật chất giải trí hiện đại bậc nhất Sa Pa","Cho dù là một bữa tiệc thân mật hay hội nghị, hội thảo quốc tế, hãy để sự kiện của bạn trở nên độc đáo hơn khi tổ chức tại Silk Path Grand Sapa Resort & Spa."],"content":[{"type":"paragraph","text":"Toạ lạc trên ngọn đồi riêng tuyệt đẹp, với tầm nhìn bao trọn dãy núi Hoàn Liên Sơn bao quanh là mây trắng bồng bềnh, nơi đây lấy cảm hứng từ những toà lâu đài Pháp với 152 phòng ngủ và biệt thự sang trọng."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/silk-path-grand-sapa-resort-and-spa/blog/m4vd19d7lpavfguy.webp","caption":""},{"type":"paragraph","text":"Sở hữuu vẻ đẹp kiêu sa quý phái theo phong cách kiến trúc Đông Dương đặc trưng thời Pháp thuộc cùng hoạ tiết trang trí đậm nét Sapa bản địa, Nơi đây tự hào là khu nghỉ dưỡng đậm chất Châu Âu giữ núi rừng Tây Bắc."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/silk-path-grand-sapa-resort-and-spa/blog/b63mi0wjqee048px.webp","caption":""},{"type":"paragraph","text":"Duyên dáng và thanh lịch trên ngọn đồi riêng biệt với tầm nhìn ôm trọn dãy núi Hoàng Liên Sơn hùng vĩ, Silk Path Grand Sapa Resort &amp; Spa được khách du lịch yêu mến gọi tên “Châu Âu thu nhỏ giữa lòng Sapa”. Tựa như một lâu đài Pháp tráng lệ, khu nghỉ dưỡng 5* duy nhất của trung tâm xứ sở mờ sương cuốn hút người lữ khách lạc bước vào tuyệt tác kiến trúc lung linh giữa thiên đường hoa bốn mùa và mây ngàn sơn cước"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/silk-path-grand-sapa-resort-and-spa/blog/ya881w8693quw2pw.webp","caption":""}],"rooms":[{"id":"66f3d7f00b818e5ee74bae43","title":"Balcony Premium Classic Mountain","size":33,"maxPersons":2,"price":3090000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc"],"images":["tour/silk-path-grand-sapa-resort-and-spa/Balcony Premium Classic Mountain/g3jjl7lqyqgbeyo0.webp","tour/silk-path-grand-sapa-resort-and-spa/Balcony Premium Classic Mountain/ij49s5m7jumhw3dh.webp","tour/silk-path-grand-sapa-resort-and-spa/Balcony Premium Classic Mountain/hb6ab418yh9zlmo0.webp","tour/silk-path-grand-sapa-resort-and-spa/Balcony Premium Classic Mountain/d1ktduw958x9eov7.webp"]},{"id":"66f3d7f00b818e5ee74bae3f","title":"Balcony Classic Garden","size":33,"maxPersons":2,"price":2640000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/silk-path-grand-sapa-resort-and-spa/Balcony Classic Garden/xfu71n8g6tc9d21y.webp","tour/silk-path-grand-sapa-resort-and-spa/Balcony Classic Garden/6e4m7qw2o6zrpeq2.webp","tour/silk-path-grand-sapa-resort-and-spa/Balcony Classic Garden/q3wnz5f4h3b9ahff.webp","tour/silk-path-grand-sapa-resort-and-spa/Balcony Classic Garden/498vfeau8pp7pq0m.webp"]},{"id":"66f3d7f00b818e5ee74bae45","title":"Balcony Junior Suite","size":60,"maxPersons":2,"price":4140000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/silk-path-grand-sapa-resort-and-spa/Balcony Junior Suite/xlbzrgsffdrkgt6e.webp","tour/silk-path-grand-sapa-resort-and-spa/Balcony Junior Suite/a2nj8s1jh05u5qxn.webp","tour/silk-path-grand-sapa-resort-and-spa/Balcony Junior Suite/46y0y5hgpsrpc8ux.webp","tour/silk-path-grand-sapa-resort-and-spa/Balcony Junior Suite/2ofh9s827e0znjhy.webp","tour/silk-path-grand-sapa-resort-and-spa/Balcony Junior Suite/0aiu6o2wv12nm0yh.webp","tour/silk-path-grand-sapa-r