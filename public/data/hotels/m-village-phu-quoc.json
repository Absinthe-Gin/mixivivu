 sẽ được tận hưởng sự thoải mái, mộc mạc khi đến đây lưu trú."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/m-village-phu-quoc/blog/wso5c9unzj2tpdo5.webp","caption":""},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/m-village-phu-quoc/blog/0xp1zyql03twrxzx.webp","caption":""},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/m-village-phu-quoc/blog/zuolinbj79ai16as.webp","caption":""}],"rooms":[{"id":"66f1111c0b818e5ee74b1536","title":"Tropical Double/Twin Room","size":30,"maxPersons":2,"price":1250000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/m-village-phu-quoc/Tropical Double/Twin Room/1nzvmpjcmrsnx5zk.webp","tour/m-village-phu-quoc/Tropical Double/Twin Room/rfjopxyx33nrut6x.webp","tour/m-village-phu-quoc/Tropical Double/Twin Room/l6b4q9g363cughgl.webp","tour/m-village-phu-quoc/Tropical Double/Twin Room/rsbsvxnsgkfd7mfn.webp","tour/m-village-phu-quoc/Tropical Double/Twin Room/up5ye2o1zbnrp713.webp","tour/m-village-phu-quoc/Tropical Double/Twin Room/vldr9d3u2byvsoas.webp","tour/m-village-phu-quoc/Tropical Double/Twin Room/za3sro865qcjx128.webp","tour/m-village-phu-quoc/Tropical Double/Twin Room/p2edv3ilv78jd6tg.webp"]},{"id":"66f1111c0b818e5ee74b1534","title":"Cozy Double/Twin Room","size":20,"maxPersons":2,"price":1100000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/m-village-phu-quoc/Cozy Double/Twin Room/q2j901jvineii7wl.webp","tour/m-village-phu-quoc/Cozy Double/Twin Room/qhzfhjzqwl5b5j0n.webp","tour/m-village-phu-quoc/Cozy Double/Twin Room/772os4on10qqp6ya.webp","tour/m-village-phu-quoc/Cozy Double/Twin Room/1zgh40oqp4izj9an.webp","tour/m-village-phu-quoc/Cozy Double/Twin Room/57yscar06uxpsyb0.webp","tour/m-village-phu-quoc/Cozy Double/Twin Room/f4lzawbtu2z4625j.webp","tour/m-village-phu-quoc/Coz