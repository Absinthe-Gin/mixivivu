 Quốc Resort nằm ngay trung tâm thị trấn Dương Đông, bên cạnh là bãi Dài xinh đẹp. "},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/thien-thanh-phu-quoc-resort/blog/o1es9a4miai1d1xs.webp","caption":""},{"type":"paragraph","text":"Khu nghỉ dưỡng được thiết kế theo lối kiến trúc bán cổ điển, phòng nghỉ trang bị đầy đủ tiện nghi hiện đại đẳng cấp 5*. Du khách có thể lựa chọn nghỉ ngơi tại bungalow hoặc phòng khách sạn.&nbsp;"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/thien-thanh-phu-quoc-resort/blog/a6hf92czthgimbu0.webp","caption":""},{"type":"paragraph","text":"Chắc chắn du khách sẽ có nhiều trải nghiệm thú vị, khó có thể quên khi lựa chọn nơi đây làm điểm dừng chân khi tới đảo Ngọc."}],"rooms":[{"id":"66f964ae0b818e5ee74c47c5","title":"Deluxe City View","size":36,"maxPersons":2,"price":1550000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/thien-thanh-phu-quoc-resort/Deluxe City View/r6qfvsah2uoddz3b.webp","tour/thien-thanh-phu-quoc-resort/Deluxe City View/2exae6jd8546xctl.webp","tour/thien-thanh-phu-quoc-resort/Deluxe City View/d5qg2dh53wprnxnc.webp","tour/thien-thanh-phu-quoc-resort/Deluxe City View/wco3fscaf0okqhrb.webp"]},{"id":"66f964ae0b818e5ee74c47c9","title":"Deluxe Sea View","size":36,"maxPersons":2,"price":1900000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/thien-thanh-phu-quoc-resort/Deluxe Sea View/9t9w6f20yzkqbdoz.webp","tour/thien-thanh-phu-quoc-resort/Deluxe Sea View/qqmcuhggnyypwfh4.webp","tour/thien-thanh-phu-quoc-resort/Deluxe Sea View/qm3dgaizdxzut87t.webp","tour/thien-thanh-phu-quoc-resort/Deluxe Sea View/wh9yr4zt2d5gzfqi.webp"]},{"id":"66f964ae0b818e5ee74c47d3","title":"Bungalow Sea View","size":50,"maxPersons":2,"price":4500000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy s