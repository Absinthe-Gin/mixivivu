p","tour/sapa-jade-hill-resort-and-spa/images/l0tdusinkjbxe0ud.webp","tour/sapa-jade-hill-resort-and-spa/images/qjkjhzjkjyiz54by.webp","tour/sapa-jade-hill-resort-and-spa/images/xvrx8o22x3d237d4.webp","tour/sapa-jade-hill-resort-and-spa/images/ce6pkbur389cfbzl.webp","tour/sapa-jade-hill-resort-and-spa/images/dima509qaptqi4n9.webp","tour/sapa-jade-hill-resort-and-spa/images/zhpf6e6w0ubh906t.webp","tour/sapa-jade-hill-resort-and-spa/images/wyj34gf1mu417cvr.webp","tour/sapa-jade-hill-resort-and-spa/images/hcrkwwjcp2ipxo2x.webp","tour/sapa-jade-hill-resort-and-spa/images/0n7v0717xn3heryi.webp","tour/sapa-jade-hill-resort-and-spa/images/04ds5uokat740wgr.webp","tour/sapa-jade-hill-resort-and-spa/images/l9szykdppf2aybw6.webp","tour/sapa-jade-hill-resort-and-spa/images/gi6cbdtbp64wcii8.webp","tour/sapa-jade-hill-resort-and-spa/images/a8hefadw548ttwmj.webp","tour/sapa-jade-hill-resort-and-spa/images/68wpv0ayjdycs6b8.webp","tour/sapa-jade-hill-resort-and-spa/images/n8be9okbxyb209sn.webp"],"highlights":["Sapa Jade Hill Resort & Spa là khu nghỉ dưỡng rất phù hợp để nghỉ dưỡng cùng gia đình hay tận hưởng sự lãng mạn dành cho các cặp đôi.","Bước vào bản làng nhỏ Sapa Jade Hill Resort & Spa, hơi ấm lan tỏa từ những nụ cười nồng hậu của các bạn nhân sự bản địa, hơi ấm bay nhẹ từ lò sưởi củi bập bùng và từ cả những bữa ăn quầy quần ấm cúng.","\"Bản làng\" Sapa Jade Hill những ngày này sau buổi sáng chìm trong biển mây là đến lúc khoảng trời trong xanh, nắng nhẹ, và những cơn gió mát lành dần ùa về.","Thong thả dạo bước dọc lối nhỏ thân quen, đâu cũng là những góc check in thật xinh xắn, cùng bạn và những người thương yêu lưu lại những kỷ niệm thật đẹp tại  bản làng cổ tích Sapa Jade Hill."],"content":[{"type":"paragraph","text":"Khu nghỉ dưỡng trên núi độc đáo bậc nhất Việt Nam – nơi mang đậm dấu ấn văn hoá của Sapa – mảnh đất của những thửa ruộng bậc thang huyền thoại."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/sapa-jade-hill-resort-and-spa/blog/qmltat9gfvw2m8sq.webp","caption":""},{"type":"paragraph","text":"Cách trung tâm Sapa gần 2km với 5 phút di chuyển bằng taxi/xe máy, Sapa Jade Hill vừa đủ gần để du khách dễ dàng kết nối với các điểm tham quan nổi tiếng của Sapa, vừa đủ xa để giữ sự biệt lập trong lành và riêng tư của một khu nghỉ dưỡng đẳng cấp. "},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/sapa-jade-hill-resort-and-spa/blog/hzp2gsai0zb8axcd.webp","caption":""},{"type":"paragraph","text":"Nằm ẩn mình giữa rừng samu yên ả, tất cả các biệt thự và bungalow đều có hướng nhìn ra núi và thung lũng Mường Hoa - top 10 ruộng bậc thang đẹp nhất thế giới. "},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/sapa-jade-hill-resort-and-spa/blog/yzpdwaug08mcb6sq.webp","caption":""},{"type":"paragraph","text":"Khám phá những bản làng nguyên sơ,trải nghiệm làm nghề truyền thống của dân tộc thiểu số, thưởng thức những món ăn tinh tế từ nguyên liệu tươi ngon từ đầu bếp tài hoa. Những tải nghiệm về một Sapa đích thực độc đáo chỉ có tại khu nghỉ dưỡng boutique Sapa Jade Hill Resort &amp; Sapa"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/sapa-jade-hill-resort-and-spa/blog/qwo5yituyo06y1ms.webp","caption":""}],"rooms":[{"id":"66f3cf6d0b818e5ee74bab53","title":"Deluxe Valley View","size":40,"maxPersons":2,"price":2520000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/sapa-jade-hill-resort-and-spa/Deluxe Valley View /tc1tze8wao0ju7ll.webp","tour/sapa-jade-hill-resort-and-spa/Deluxe Valley View /why9ly7nubw0kgb4.webp","tour/sapa-jade-hill-resort-and-spa/Deluxe Valley View /evwsedjo3o07jksp.webp","tour/sapa-jade-hill-resort-and-spa/Deluxe Valley View /z0gsuzml94hti218.webp","tour/sapa-jade-hill-resort-and-spa/Deluxe Valley View /7hmk6s8g8voz2kzz.webp","tour/sapa-jade-hill-resort-and-spa/Deluxe Valley View /p0rw4cbkw0gdv2jv.webp","tour/sapa-jade-hill-resort-and-spa/Deluxe Valley