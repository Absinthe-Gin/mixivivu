67sr3oza.webp","caption":""},{"type":"paragraph","text":"Bliss Hoi An Beach Resort &amp; Wellness có vị trí gần phố cổ Hội An và các điểm vui chơi ăn uống trong thành phố. Nhân viên chu đáo, phục vụ tận tình cùng với các tiện nghi hiện đại và đầy đủ chắc chắn sẽ mang lại những trải nghiệm tốt nhất cho quý khách khi lưu trú tại đây"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/bliss-hoi-an-beach-resort-and-wellness/blog/7zvnb5t13aki1ioi.webp","caption":""}],"rooms":[{"id":"686c90f37f201468c3869af8","title":"Deluxe","size":51,"maxPersons":2,"price":2800000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/bliss-hoi-an-beach-resort-and-wellness/Deluxe/4bkfr802tzlr8iho.webp","tour/bliss-hoi-an-beach-resort-and-wellness/Deluxe/yxk0kt6cq9sxg51i.webp","tour/bliss-hoi-an-beach-resort-and-wellness/Deluxe/ytajba4iddrzi6pm.webp","tour/bliss-hoi-an-beach-resort-and-wellness/Deluxe/tdo8o9babiwt74sx.webp","tour/bliss-hoi-an-beach-resort-and-wellness/Deluxe/r3x3sxn97dtgwffa.webp","tour/bliss-hoi-an-beach-resort-and-wellness/Deluxe/kuq3f7wlf5vw7c1d.webp","tour/bliss-hoi-an-beach-resort-and-wellness/Deluxe/ml9hvanb37hdrpm3.webp","tour/bliss-hoi-an-beach-resort-and-wellness/Deluxe/6m8tzgbarzdoiozq.webp","tour/bliss-hoi-an-beach-resort-and-wellness/Deluxe/g4xlhzlsy7h8wnk6.webp"]},{"id":"686c90f37f201468c3869afa","title":"Ocean Deluxe","size":51,"maxPersons":2,"price":3255000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/bliss-hoi-an-beach-resort-and-wellness/Ocean Deluxe/0tqppwlpuzpvx6sr.webp","tour/bliss-hoi-an-beach-resort-and-wellness/Ocean Deluxe/p0v46cwvj3slcbqk.webp","tour/bliss-hoi-an-beach-resort-and-wellness/Ocean Deluxe/zbn92ek26fhtbajk.webp","tour/bliss-hoi-an-beach-resort-and-wellness/Ocean Deluxe/bnniz2mzxq8l8q24.webp","tour/bliss-hoi-an-beach-resor