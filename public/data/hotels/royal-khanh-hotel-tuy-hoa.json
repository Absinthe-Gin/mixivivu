our/royalkhanhhoteltuyhoa/images/ce12bt7fx5agk295.webp","tour/royalkhanhhoteltuyhoa/images/k58nszzfujkk15wg.webp"],"highlights":["Royal Khanh Hotel tọa lạc trên đường Nguyễn Huệ, ngay Trung tâm thành phố Phú Yên - Tuy Hòa, nằm gần biển với bãi biển sạch đẹp, thoáng mát, giao thông đi lại rất thuận tiện","Nhà hàng của khách sạn nằm ở tầng 1 và tầng 7 với không gian thoáng đãng và cách bài trí ấm cúng có thể phục vụ cùng lúc 40 đến 200 thực khách với ẩm thực Á - Âu phong phú.","Đội ngũ cán bộ nhân viên của Khách sạn Royal Khanh luôn được trau dồi về chuyên môn và nghiệp vụ; với tinh thần nhiệt tình, hết lòng vì khách hàng, luôn ân cần và chu đáo sẽ mang đến cho du khách trải nghiệm tại Phú Yên cảm giác thân thiện, ấm cúng như đang được ở chính ngôi nhà của mình."],"content":[{"type":"paragraph","text":"Royal Khanh Hotel tọa lạc ngay tại trung tâm thành phố Phú Yên - Tuy Hòa. Khách sạn nằm gần biển với bãi biển sạch đẹp, thoáng mát. Phía bắc của khách sạn giáp với đường Nguyễn Huệ nối liền quảng trường thành phố, rất thuận tiện cho các hoạt động nghỉ dưỡng như đi bộ, tắm biển, tập dưỡng sinh,…Từ Royal Khanh Hotel đến Ga Tuy Hòa khoảng 10 phút và đến Sân bay Tuy Hòa khoảng 15 phút bằng phương tiện ô tô."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/royalkhanhhoteltuyhoa/blog/rgs57z2fjvr85ae9.webp","caption":""},{"type":"paragraph","text":"Khách sạn có 60 phòng nghỉ, được thiết kế hiện đại, đạt tiêu chuẩn quốc tế 3 sao, với đa dạng nhiều loại phòng cùng nội thất được bày trí khoa học và tinh tế, lắp đặt những trang thiết bị hiện đại đạt tiêu chuẩn quốc tế, sẵn sàng phục vụ quý khách. Các dịch vụ đi kèm hoàn hảo đã thể hiện được sự chuyên nghiệp của Royal Khanh Hotel."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/royalkhanhhoteltuyhoa/blog/1pa75vqrxx5atfh9.webp","caption":""}],"rooms":[{"id":"66c8085473736d74557772f0","title":"Superior Double","size":25,"maxPersons":2,"price":700000,"salePrice":0,"features":["Điều hòa","Máy sấy tóc","Tivi","Nước đóng chai miễn phí"],"images":["tour/royalkhanhhoteltuyhoa/Superior Double/w8o7va0qmduzovy3.webp","tour/royalkhanhhoteltuyhoa/Superior Double/28wv2ldn4s74gq5x.webp","tour/royalkhanhhoteltuyhoa/Superior Double/evjrsd5yhq4m9b7f.webp"]},{"id":"66c8085473736d74557772f2","title":"Deluxe Twin","size":28,"maxPersons":2,"price":750000,"salePrice":0,"features":["Điều hòa","Máy sấy tóc","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/royalkhanhhoteltuyhoa/Deluxe Twin/vibhrbkks37j8aj8.webp","tour/royalkhanhhoteltuyhoa/Deluxe Twin/wm0ozwrpqqvsmys5.webp","tour/royalkhanhhoteltuyhoa/Deluxe Twin/wy7vng7fbx5mgtn4.webp"]},{"id":"66e108f00b818e5ee7484e2b","title":"Executive Suite","size":35,"maxPersons":2,"price":1250000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/royalkhanhhoteltuyhoa/Executive Suite/xdqcm3yh9asypicg.webp","tour/royalkhanhhoteltuyhoa/Executive Suite/vv5lhfm83exi94w4.webp","tour/royalkhanhhoteltuyhoa/Executive Suite/cnqnoug0sy5e4nyi.webp"]},{"id":"66e108f00b818e5ee7484e29","title":"Quad Family Room","size":32,"maxPersons":4,"price":1150000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/royalkhanhhoteltuyhoa/Quad Family Room/1pk5hk5npl5rgvkr.webp","tour/royalkhanhhoteltuyhoa/Quad Family Room/wcbqbxmnv1yzwm0t.webp","tour/royalkhanhhoteltuyhoa/Quad Family Room/xiok0c5hy8s2qkf1.webp","tour/royalkhanhhoteltuyhoa/Quad Family Room/wf3d4bqpogkoaziu.webp"]},{"id":"66e108f00b818e5ee7484e2d","title":"Royal Suite","size":40,"maxPersons":2,"price":1350000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/royalkhanhhoteltuyhoa/Royal Suite/cy4t0sea24pm8vwp.webp","tour/royalkhanhhoteltuyhoa/Royal Suite/ls250x6ejl08ykc7.webp","tour/royalkhanhhoteltuyhoa/Royal Suite/jhq2j2hsw