/sun-ha-long/images/x6w73f92rukfowtv.webp","tour/sun-ha-long/images/htp0x2wmpdoxs3ar.webp","tour/sun-ha-long/images/g0lm5ngkpap051l3.webp","tour/sun-ha-long/images/rg1zgofu3jsf5c5c.webp","tour/sun-ha-long/images/texgnq3d826q1vzn.webp","tour/sun-ha-long/images/51ts146vbt6gno7s.webp","tour/sun-ha-long/images/snq0u6oxzonoa97o.webp","tour/sun-ha-long/images/1l2yuqhw31ao4fad.webp","tour/sun-ha-long/images/09ed0l2rxv4m4k9l.webp","tour/sun-ha-long/images/tpjyty70buxm575o.webp","tour/sun-ha-long/images/t1imscmcs5k5xhqa.webp"],"highlights":["Sun halong hotel có đủ không gian để đáp ứng nhu cầu của du khách. Mỗi phòng được thiết kế sang trọng và tiện nghi, đảm bảo mang đến sự thoải mái và thoáng đãng cho khách hàng.","Khách sạn cũng rất thích hợp cho gia đình có trẻ em, vì theo chính sách của khách sạn, trẻ em từ 6 tuổi trở xuống được ở miễn phí.","Sun halong hotel không chỉ là một điểm đến tuyệt vời để thư giãn và khám phá vẻ đẹp của Hạ Long, mà còn cung cấp cho du khách nhiều tiện ích thể thao tuyệt vời.","Sun halong hotel là một khách sạn tuyệt vời tại Hạ Long, Việt Nam, với nhiều tiện ích tiện lợi để đáp ứng nhu cầu của khách hàng."],"content":[{"type":"paragraph","text":"Khách sạn 3 sao với 35 phòng thiết kế sang trọng, hiện đại theo phong cách kiến trúc Châu Âu nằm trong quần thể Sun Premier - Trung tâm du lịch Hạ Long, là sự kết hợp của những công nghệ hiện đại cùng phong cách Việt gần gũi tạo cảm giác thoải mái và thân thiện."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/sun-ha-long/blog/48cgtfr1qvpucpe9.webp","caption":""},{"type":"paragraph","text":"Sun Halong Hotel là lựa chọn sáng giá dành cho những ai đang tìm kiếm một trải nghiệm xa hoa đầy thú vị trong kỳ nghỉ của mình. Lưu trú tại đây cũng là cách để quý khách chiều chuộng bản thân với những dịch vụ xuất sắc nhất và khiến kỳ nghỉ của mình trở nên thật đáng nhớ."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/sun-ha-long/blog/jqq56fgwgmpwrqnq.webp","caption":""},{"type":"paragraph","text":"Sun Halong Hotel&nbsp;tọa lạc tại Hạ Long, Việt Nam, là một khách sạn lý tưởng cho du khách muốn khám phá vẻ đẹp của vịnh Hạ Long. Khách sạn cung cấp các dịch vụ vận chuyển tiện lợi để du khách có thể dễ dàng di chuyển trong khu vực"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/sun-ha-long/blog/wia8k3wvy23corwa.webp","caption":""}],"rooms":[{"id":"66f66e7d0b818e5ee74c3612","title":"Family Suite","size":40,"maxPersons":4,"price":950000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/sun-ha-long/Family Suite /l50qe5epfobcec9z.webp","tour/sun-ha-long/Family Suite /thsem35tpwia103a.webp","tour/sun-ha-long/Family Suite /cpgjou0qlrm6f8qc.webp","tour/sun-ha-long/Family Suite /mm7ald7ysep1wfj3.webp","tour/sun-ha-long/Family Suite /ezq22r0rfox3ei6e.webp","tour/sun-ha-long/Family Suite /vfvvrgvr34j0dpk9.webp","tour/sun-ha-long/Family Suite /q31b0yzb2frmeqw0.webp","tour/sun-ha-long/Family Suite /5v71utahfqfbugdd.webp","tour/sun-ha-long/Family Suite /30xztye7rca981y7.webp"]},{"id":"66f66e7d0b818e5ee74c3610","title":"Helen + vip","size":34,"maxPersons":2,"price":800000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/sun-ha-long/Helen + vip /ogyvcv0mpvcjf2fn.webp","tour/sun-ha-long/Helen + vip /xh3asvo9zwgjpwcl.webp","tour/sun-ha-long/Helen + vip /8v1f0266vy19mjr5.webp","tour/sun-ha-long/Helen + vip /s68oh93hnajaxbo1.webp","tour/sun-ha-long/Helen + vip /behwupboz1r1g728.webp","tour/sun-ha-long/Helen + vip /ing15nfubrs0xm4o.webp"]},{"id":"66f66e7d0b818e5ee74c360c","title":"Superior","size":25,"maxPersons":2,"price":600000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/sun-ha-long/Superior /lbqfn6qa0z2bu0cp.webp","tour/sun-ha-long/Superio