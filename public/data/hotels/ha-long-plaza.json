webp","tour/ha-long-plaza/images/wp940ihnt370jvbq.webp","tour/ha-long-plaza/images/vz17n6xpmhid0fih.webp","tour/ha-long-plaza/images/ifdlx4bau7yl200d.webp","tour/ha-long-plaza/images/d9ejhtuvndngr951.webp","tour/ha-long-plaza/images/f3bxbawmhmwcwl6o.webp","tour/ha-long-plaza/images/dlnumhkhrjkg9f9o.webp","tour/ha-long-plaza/images/njgom09mpan88bs3.webp","tour/ha-long-plaza/images/3lv37pneqlfim5aq.webp","tour/ha-long-plaza/images/c916mxrd3cnhyc11.webp","tour/ha-long-plaza/images/5gquqth56ka8yjbr.webp","tour/ha-long-plaza/images/ozc44cgigt7x9apg.webp","tour/ha-long-plaza/images/mlf7ve7ftfc55veg.webp","tour/ha-long-plaza/images/j0nr9ya97b8715pg.webp","tour/ha-long-plaza/images/yb9q55vyuxmdmirw.webp","tour/ha-long-plaza/images/icimn4vn1dmyline.webp","tour/ha-long-plaza/images/d1wzoblx66rmjevl.webp","tour/ha-long-plaza/images/o9q7xsykhvmzvz8o.webp","tour/ha-long-plaza/images/w80hnp4rzxv76i3k.webp","tour/ha-long-plaza/images/3ihp5nw1qq5wkx69.webp","tour/ha-long-plaza/images/me1lsvya8x7xp8my.webp","tour/ha-long-plaza/images/nrfig027ia90rnb2.webp","tour/ha-long-plaza/images/bb8f6a3bm95wtnqd.webp","tour/ha-long-plaza/images/1e5enf7ajhcv5zwx.webp","tour/ha-long-plaza/images/5fyphse1dm8fef3a.webp","tour/ha-long-plaza/images/isxqcrqec2y7qr7k.webp"],"highlights":["Halong Plaza Hotel nằm ở trung tâm thành phố Hạ Long, cách Ga cáp treo Nữ Hoàng 800 m. Khách sạn có hồ bơi ngoài trời, trung tâm thể dục và nhà hàng cũng như chỗ đỗ xe riêng miễn phí trong khuôn viên.","Tất cả các phòng nghỉ sang trọng tại đây được trang bị đầy đủ tiện nghi, bao gồm máy điều hòa, Wi-Fi miễn phí, đồ nội thất hiện đại, cửa sổ lớn đón nhiều ánh sáng tự nhiên và nhìn ra biển, TV truyền hình vệ tinh màn hình phẳng, tủ lạnh mini và tủ quần áo","Du khách có thể thư giãn với buổi xông hơi khô hoặc tận hưởng liệu pháp mát-xa nhẹ nhàng. Khách sạn còn có trung tâm dịch vụ doanh nhân đầy đủ trang thiết bị với dịch vụ fax và photocopy."],"content":[{"type":"paragraph","text":"Khách Sạn Hạ Long Plaza tọa lạc ở đường Hạ Long, khu Bãi Cháy. Khách sạn cách sân bay Quốc tế Cát Bi khoảng 70 km, cách sân bay Quốc tế Nội Bài khoảng 180 km, là khách sạn đạt tiêu chuẩn quốc tế của tỉnh Quảng Ninh. Với 200 phòng nghỉ hướng biển được trang bị nội thất hiện đại, kiến trúc hài hòa đem lại cảm giác thư giãn thoải mái cho khách hàng."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/ha-long-plaza/blog/vmbz1m7af66pvi1k.webp","caption":""},{"type":"paragraph","text":"Khách sạn tự tin mang đến những sản phẩm du lịch uy tín, chất lượng và tận tâm. Với lòng hiếu khách và mục tiêu mang tới trải nghiệm tốt nhất đến với khách hàng, khách sạn đã chuẩn bị chu đáo đón tiếp đoàn từ khâu chọn lựa đồ uống welcome, từng chiếc bánh ngọt cũng được chọn lựa nguyên liệu tốt nhất."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/ha-long-plaza/blog/ffvf94u2fz36givt.webp","caption":""},{"type":"paragraph","text":"Khách sạn có nhiều lựa chọn ăn uống mang đến sự tiện lợi, sang trọng và đồ ăn, thức uống đặc biệt. Nhà hàng Four Seasons là địa điểm ăn uống lý tưởng với nhiều lựa chọn ẩm thực bao gồm các món ăn đặc sản của Việt Nam, Nhật Bản, phương Tây và Thái Lan do đầu bếp người Thái chế biến. Nhà hàng Bay View có khu vực ăn uống riêng cho tiệc riêng hoặc sự kiện của công ty. Với không gian ấm cúng và tầm nhìn tuyệt đẹp ra Vịnh Hạ Long, La Plaza Bar &amp; Lounge là nơi tuyệt vời để thư giãn."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/ha-long-plaza/blog/k77zvo3ybl86y0ke.webp","caption":""}],"rooms":[{"id":"66e3092e0b818e5ee7492172","title":"Executive Suite","size":82,"maxPersons":2,"price":2650000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/ha-long-plaza/Executive Suite/jhu47m2r4oyat8r2.webp","tour/ha-long-plaza/Executive Suite/nhx4jev035eswur9.webp","tour/ha-long-plaza/Executive Suite/l3ic41rluscuw20c.webp","tour/ha-long-plaza/Executive Suite/mf13fm640jpmymk6.webp","tour/ha-long-plaza/Executive Suite/zxiqqrdojl0glisl.webp"]},{"id":"66e3092e0b818e5ee7492174","title":"Plaza Suite","size":102,"maxPersons":2,"price":3050000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/ha-long-plaza/Plaza Suite/xamksjwy9xi35iwa.webp","tour/ha-long-plaza/Plaza Suite/qu5k2sby6hkngvo8.webp","tour/ha-long-plaza/Plaza Suite/hkbl2w0cwh528duh.webp","tour/ha-long-plaza/Plaza Suite/b9djg1cdoxgtxty2.webp","tour/ha-long-plaza/Plaza Suite/tx1otplp6voxe95m.webp","tour/ha-long-plaza/Plaza Suite/xzeib835awy4cytp.webp","tour/ha-long-plaza/Plaza Suite/nqceko6ksj7rhvgh.webp"]},{"id":"66e3092e0b818e5ee749216a","title":"Superior","size":38,"maxPersons":2,"price":950000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/ha-long-plaza/Superior/v4acltdpth0tp70c.webp","tour/ha-long-plaza/Superior/t8gy5vg0ayo7e6qa.webp","tour/ha-long-plaza/Superior/exfhtzkojxl1317y.webp","tour/ha-long-plaza/Superior/ahdfc5yxyg8ykycq.webp","tour/ha-long-plaza/Superior/ffbw1txq3wbtvas5.webp","tour/ha-long-plaza/Superior/i1fnvf9e525wpc4v.webp","tour/ha-long-plaza/Superior/bjihy5xzxf5snqqa.webp","tour/ha-long-plaza/Superior/ob7hxchwog7g1jpa.webp","tour/ha-long-plaza/Superior/j25nmw9tiifjyu1v.webp","tour/ha-long-plaza/Superior/at57xynb8w5dc9pa.webp","tour/ha-long-plaza/Superior/41t6jnfnjfjn9vlj.webp"]},{"id":"66e3092e0b818e5ee749216c","title":"Deluxe","size":38,"maxPersons":2,"price":1050000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/ha-long-plaza/Deluxe/o6crwnibjte3b441.webp","tour/ha-long-plaza/Deluxe/9yr2qmxe82wag8dv.webp","tour/ha-long-plaza/Deluxe/l0a983pmn1p4f83y.webp","tour/ha-long-plaza/Deluxe/e8liyb1dpyk8p93w.webp","tour/ha-long-plaza/Deluxe/v52g6zmh9h1fj9mj.webp",