bp","tour/muong-thanh-sapa/images/mcauvdpd6foh6nhg.webp","tour/muong-thanh-sapa/images/s5viwoy7m36m5ew6.webp","tour/muong-thanh-sapa/images/a5pv1gi6vhtr97bo.webp","tour/muong-thanh-sapa/images/ea0x4q5wh0u46uqo.webp","tour/muong-thanh-sapa/images/zns27knbrhxh6g19.webp","tour/muong-thanh-sapa/images/ru8ptnill0bgr2qj.webp","tour/muong-thanh-sapa/images/71jmo7iwsqzfcavk.webp","tour/muong-thanh-sapa/images/byj2s8pvgkrybpnr.webp","tour/muong-thanh-sapa/images/ogvl71zii6w4eifn.webp","tour/muong-thanh-sapa/images/snejhajwnldxwhvk.webp","tour/muong-thanh-sapa/images/4ve3ghtxu73qbxll.webp","tour/muong-thanh-sapa/images/qrxfqeqb50gfihnp.webp"],"highlights":["Khách sạn Mường Thanh Sapa được thiết kế với hệ thống 96 phòng nghỉ, tất cả đều đạt chuẩn, đầy đủ các tiện nghi với nhiều dịch vụ cần thiết đi kèm nhằm đáp ứng nhu cầu của bạn trong thời gian nghỉ dưỡng tại đây.","Một điều độc đáo để tạo nên điểm khác biệt của Khách sạn Mường Thanh Sapa chính là kiến trúc, nó được kết hợp hài hòa giữa phong cách hiện đại sang trọng và nét bình dị trong vẻ đẹp văn hóa của người dân đồng bào Tây Bắc.","Đặc biệt, Khách sạn Mường Thanh Sapa có tầm nhìn hướng ra hồ với mặt nước long lanh, tựa như mắt rồng in bóng toàn bộ khuôn viên khiến cho không gian khung cảnh nơi đây ngày càng thơ mộng."],"content":[{"type":"paragraph","text":"Khách sạn Mường Thanh Sa Pa nằm tại trung tâm thị xã Sapa, cách thành phố Lào Cai 38 km. Khách sạn được thiết kế với tiêu chuẩn 3 sao cùng tầm nhìn hướng hồ, sau lưng là dãy núi Hàm Rồng huyền thoại tạo thế “tựa sơn hướng thủy”. Khách sạn có 96 phòng thỏa mãn những yêu cầu đa dạng của khách hàng, là nơi nghỉ ngơi và thư giãn lý tưởng góp phần làm cho chuyến thăm quan Sa Pa của du khách thêm thú vị và trọn vẹn."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/muong-thanh-sapa/blog/07f3l0sw9sk0kgm2.webp","caption":""},{"type":"paragraph","text":"Khách sạn Mường Thanh Sapa nổi bật với dịch vụ nghỉ dưỡng và thư giãn, nó cũng là nơi góp phần làm nên chuyến đi thật ý nghĩa cho nhiều du khách ghé đến Sapa. Với những tiện nghi hiện đại và đặc biệt là tác phong phục vụ của đội ngũ nhân viên, Chúng tôi tin chắc rằng bạn sẽ được trải nghiệm những điều thú vị và có một chuyến đi thật đáng nhớ tại đây."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/muong-thanh-sapa/blog/s8w299ao98bn16gd.webp","caption":""},{"type":"paragraph","text":"Cho dù mục đích chuyến đi của bạn là nghỉ dưỡng, khám phá hay công tác đi chăng nữa, thì khách sạn Mường Thanh Sapa thực sự là một điểm đến lý tưởng mà bạn nên dừng chân tại thị trấn sương mù này."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/muong-thanh-sapa/blog/ejr2c8sflkmsgci4.webp","caption":""}],"rooms":[{"id":"66f6601e0b818e5ee74c3099","title":"Executive Suite","size":60,"maxPersons":2,"price":1790000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/muong-thanh-sapa/Executive Suite/3gs9b7hemohfkkn0.webp","tour/muong-thanh-sapa/Executive Suite/hp8v81j6turwkvmd.webp","tour/muong-thanh-sapa/Executive Suite/q9eoezfo0tszzrr1.webp","tour/muong-thanh-sapa/Executive Suite/qeu8ituny1oe3q9n.webp","tour/muong-thanh-sapa/Executive Suite/lxazfft6gqqi4m30.webp","tour/muong-thanh-sapa/Executive Suite/2jemle54nuxa3s7b.webp"]},{"id":"66f6601e0b818e5ee74c3097","title":"Deluxe Triple","size":40,"maxPersons":3,"price":1390000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/muong-thanh-sapa/Deluxe Triple /1qhlehe3g7hm6bj6.webp","tour/muong-thanh-sapa/Deluxe Triple /0z03lwd2yd4ncf0y.webp","tour/muong-thanh-sapa/Deluxe Triple /q6dp7e5thfjno9pu.webp","tour/muong-thanh-sapa/Deluxe Triple /p2sxohnu3k7y9ose.webp"]},{"id":"66f6601e0b818e5ee74c3095","title":"Deluxe","size":30,"maxPersons":2,"price":1050000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/muong-thanh-sapa/Deluxe/fd7hf4jyx6nu17x6.webp","tour/muong-thanh-sapa/Deluxe/frk51yvz74za1cwr.webp","tour/muong-thanh-sapa/Deluxe/1aulbcl59ujmj1pl.webp","tour/muong-thanh-sapa/Deluxe/mslym2w43crmtnu6.webp"]}],"reviews":[]}