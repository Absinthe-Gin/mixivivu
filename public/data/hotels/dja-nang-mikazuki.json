/dja-nang-mikazuki/images/o52yv6qcwb3iv5iq.webp","tour/dja-nang-mikazuki/images/r4p2vj40k9xg4c2e.webp","tour/dja-nang-mikazuki/images/yan5scl4pv002i2g.webp","tour/dja-nang-mikazuki/images/h13xnpiycnhobfvf.webp","tour/dja-nang-mikazuki/images/78x5hxkx105mp30z.webp","tour/dja-nang-mikazuki/images/zyxlyacjylupr23j.webp","tour/dja-nang-mikazuki/images/bpquqcegbl4uzkir.webp","tour/dja-nang-mikazuki/images/uqdroeka5a1qhmpm.webp","tour/dja-nang-mikazuki/images/9kdrvrynpi4bqpfm.webp","tour/dja-nang-mikazuki/images/wzcj9ff6go99oi9l.webp","tour/dja-nang-mikazuki/images/yev3imzatw9vwnxu.webp","tour/dja-nang-mikazuki/images/2uqzzh3hzy8fek7a.webp","tour/dja-nang-mikazuki/images/x83spuoixxoc3czi.webp","tour/dja-nang-mikazuki/images/c1zu2xi1d95c3s66.webp","tour/dja-nang-mikazuki/images/a9whac75augz3r3e.webp","tour/dja-nang-mikazuki/images/1l82oatstkydhfna.webp","tour/dja-nang-mikazuki/images/ovnn8lxk2erkpju4.webp","tour/dja-nang-mikazuki/images/xc3119wsyjftxi9g.webp","tour/dja-nang-mikazuki/images/3ghnqc31806b2mn4.webp","tour/dja-nang-mikazuki/images/zv7i9canq1ec5dwf.webp","tour/dja-nang-mikazuki/images/atpzdb2ql965raf9.webp","tour/dja-nang-mikazuki/images/i9xde7qgyjj0enya.webp","tour/dja-nang-mikazuki/images/eu571uoiitegry8z.webp","tour/dja-nang-mikazuki/images/21et41rnkke2kz9c.webp","tour/dja-nang-mikazuki/images/cp4pz64yap90ccia.webp","tour/dja-nang-mikazuki/images/6amizc5ikbthgdyz.webp","tour/dja-nang-mikazuki/images/a81hfy5y608v6cbr.webp","tour/dja-nang-mikazuki/images/wqwoi9ph9dmsesmr.webp","tour/dja-nang-mikazuki/images/g5m30y1rmoyvjezk.webp","tour/dja-nang-mikazuki/images/vflv2bqeld95gvuo.webp"],"highlights":["Khu nghỉ mang đậm phong cách Nhật Bản với thiết kế mới, hiện đại và đầy đủ tiện ích","Khu nghỉ có công viên nước hiện đại với nhiều trò chơi rất phù hợp cho gia đình có trẻ nhỏ","Tất cả các phòng nghỉ đều có diện tích rộng rãi, thoáng mát"],"content":[{"type":"paragraph","text":"Đà Nẵng –Mikazuki Japanese Resorts &amp; Spa thành viên của&nbsp;Tập đoàn Khách sạn Mikazuki&nbsp;đến từ Nhật Bản – là&nbsp;khu tổ hợp nghỉ dưỡng và vui chơi giải trí chuẩn 5 sao."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/dja-nang-mikazuki/blog/qm16iw48og5f5219.webp","caption":""},{"type":"paragraph","text":"Ngoài khu khách sạn 22 tầng với gần 300 phòng nghỉ hướng biển và bồn tắm lộ thiên, khu nghỉ còn có 12 căn biệt thư với 48 phòng hướng vườn riêng tư."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/dja-nang-mikazuki/blog/o1suii1qlgtai1ge.webp","caption":""},{"type":"paragraph","text":"Khu nghỉ còn sở hữu hệ thống nhà hàng, sảnh hội nghị, tiệc cưới sang trọng, hiện đại với sức chứa lớn. Quầy bar và bể bơi vô cực của khu nghỉ nằm trên tầng 22 của khách sạn cũng là 1 vị trí mà du khách nên ghé qua để có các bức ảnh siêu đẹp.&nbsp;"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/dja-nang-mikazuki/blog/kjuifh94naiaxage.webp","caption":""},{"type":"paragraph","text":"Đặc biệt, khu nghỉ còn sở hữu khu công viên nước bốn mùa và tắm khoáng nóng Onsen, Spa chuẩn Nhật. Với những gia đình có trẻ nhỏ, đây là 1 điểm không thể bỏ qua khi tới Đà Nẵng."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/dja-nang-mikazuki/blog/jp0psqvqw2mnyq5z.webp","caption":""},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/dja-nang-mikazuki/blog/imc5vs4jwx6r18h8.webp","caption":""}],"rooms":[{"id":"66f3be2a0b818e5ee74b8ddf","title":"Hinode Garden View","size":45,"maxPersons":2,"price":2190000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/dja-nang-mikazuki/Hinode Garden View/c7pqng0tpcfa87xv.webp","tour/dja-nang-mikazuki/Hinode Garden View/c73bwxy5i5muz20q.webp","tour/dja-nang-mikazuki/Hinode Garden View/wfngdtjn9wiczpx8.webp","tour/dja-nang-mikazuki/Hinode Garden View/u616iz0b185el6hy.webp","tour/dja-nang-mikazuki/Hinode Garden View/z7be4ra50avsk6sj.webp","tour/dja-nang-mikazuki/Hinod