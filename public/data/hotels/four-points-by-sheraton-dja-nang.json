tion":""},{"type":"paragraph","text":"Bể bơi của khách sạn nằm tại tầng thượng bên cạnh quầy Bar. Nhiều bị trí ngồi thư giãn với ghế ngồi độc đáo cũng được khách sạn bố trí để du khách cảm thấy thoải mái nhất."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/four-points-by-sheraton-dja-nang/blog/dnlgtep4sww6otpj.webp","caption":""},{"type":"paragraph","text":"Nhà hàng khách sạn có sức chứa lớn phục vụ bữa sáng buffet, bữa trưa và bữa tối theo thực đơn có sẵn hoặc theo yêu cầu của thực khách."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/four-points-by-sheraton-dja-nang/blog/ntuhhfv43u06borl.webp","caption":""}],"rooms":[{"id":"66df303073736d745577ae58","title":"Superior King Ocean View / Superior Twin City View","size":30,"maxPersons":2,"price":1950000,"salePrice":0,"features":["Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Bàn làm việc"],"images":["tour/four-points-by-sheraton-dja-nang/Superior King Ocean View / Superior Twin City View/2lcnsug5bjaav974.webp","tour/four-points-by-sheraton-dja-nang/Superior King Ocean View / Superior Twin City View/10h9zvtxv4r34b8n.webp","tour/four-points-by-sheraton-dja-nang/Superior King Ocean View / Superior Twin City View/tl2o52pqd6z4loic.webp","tour/four-points-by-sheraton-dja-nang/Superior King Ocean View / Superior Twin City View/dl1ftx2bupf5f11g.webp"]},{"id":"66ea5c2c0b818e5ee74a4571","title":"Premium Deluxe King Ocean View / Premium Deluxe Twin Partial Ocean View","size":40,"maxPersons":2,"price":2400000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/four-points-by-sheraton-dja-nang/Premium Deluxe King Ocean View / Premium Deluxe Twin Partial Ocean View/96j0ini8xtwm3g9c.webp","tour/four-points-by-sheraton-dja-nang/Premium Deluxe King Ocean View / Premium Deluxe Twin Partial Ocean View/zraapgcitrby4vwt.webp","tour/four-points-by-sheraton-dja-nang/Premium Deluxe King Ocean View / Pr