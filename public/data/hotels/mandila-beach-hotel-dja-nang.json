/hotel/mandila-beach-hotel-dja-nang/blog/88s6ksig2x7kot1w.webp","caption":""},{"type":"paragraph","text":"Các phòng của khách sạn đều được trang bị nội thất mới và đầy đủ như: ti vi màn hình phẳng, tủ quần áo, két an toàn, phòng tắm với các thiết bị phòng tắm, đồ vệ sinh phòng tắm.&nbsp;"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/mandila-beach-hotel-dja-nang/blog/dpk2sogcb9iiu5kn.webp","caption":""},{"type":"paragraph","text":"Khách sạn cũng sở hữu bể bơi ngoài trời đẹp mắt tại tầng thượng với tầm nhìn toàn cảnh biển Đà Nẵng.&nbsp;"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/mandila-beach-hotel-dja-nang/blog/0qd0nlfos4h0wz1s.webp","caption":""},{"type":"paragraph","text":"Nhà hàng của khách sạn phục vụ bữa sáng buffet và bữa trưa, bữa tối theo thực đơn có sẵn hoặc theo yêu cầu đặt trước của thực khách.&nbsp;"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/mandila-beach-hotel-dja-nang/blog/4hou6de90d5dy98k.webp","caption":""},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/mandila-beach-hotel-dja-nang/blog/ljpcoy19qenfxtr3.webp","caption":""}],"rooms":[{"id":"66f248f30b818e5ee74b4b08","title":"Deluxe","size":30,"maxPersons":2,"price":1050000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/mandila-beach-hotel-dja-nang/Deluxe/0c6awu34518frkcq.webp","tour/mandila-beach-hotel-dja-nang/Deluxe/f88541ihp8sisjam.webp","tour/mandila-beach-hotel-dja-nang/Deluxe/wnd6cgodql7ae74x.webp","tour/mandila-beach-hotel-dja-nang/Deluxe/fq043vti0n245cm0.webp"]},{"id":"66f262df0b818e5ee74b4ebe","title":"Deluxe Ocean View","size":30,"maxPersons":2,"price":1500000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/mandila-beach-hotel-dja-nang/Deluxe Ocean View/vbnr3hvqmh3oiqwq.webp","tour/mandila-beach-hotel-dj