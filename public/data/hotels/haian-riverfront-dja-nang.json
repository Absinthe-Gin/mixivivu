ng/blog/5vdk9c127h1rigj1.webp","caption":""},{"type":"paragraph","text":"Ngoài nhà hàng sang trọng, khách sạn cũng sở hữu phòng hội thảo, hội nghị với sức chứa lên tới hơn 120 khách. Bên cạnh đó, khách sạn cũng có đầy đủ các tiện ích như bể bơi, spa, phòng thể dục..."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/haian-riverfront-dja-nang/blog/letvjz8y3brnyel8.webp","caption":""},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/haian-riverfront-dja-nang/blog/5tbbszysph6ksydx.webp","caption":""},{"type":"paragraph","text":"Đặc biệt, du khách có thẻ vừa nhâm nhi ly cocktail và đồ uống mát lạnh tại Nyx Sky Lounge và ngắm nhìn toàn cảnh sông Hàn tuyệt đẹp."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/haian-riverfront-dja-nang/blog/z2g9nhqt74nek7we.webp","caption":""}],"rooms":[{"id":"66ebd42d0b818e5ee74ab9c0","title":"Deluxe River Vỉew","size":26,"maxPersons":2,"price":1250000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/haian-riverfront-dja-nang/Deluxe River Vỉew/zluo1d6eqfedpv44.webp","tour/haian-riverfront-dja-nang/Deluxe River Vỉew/o7kubho0jqivkhc5.webp","tour/haian-riverfront-dja-nang/Deluxe River Vỉew/ueb63ldtsnudbhaz.webp","tour/haian-riverfront-dja-nang/Deluxe River Vỉew/vdfdb9psl24x9e53.webp","tour/haian-riverfront-dja-nang/Deluxe River Vỉew/mw0q8lgmm7rxz0zm.webp","tour/haian-riverfront-dja-nang/Deluxe River Vỉew/ojh4vx7z4z6zlixp.webp"]},{"id":"66ebd42d0b818e5ee74ab9be","title":"Superior","size":25,"maxPersons":2,"price":1150000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/haian-riverfront-dja-nang/Superior /rqaztov0u98kem7q.webp","tour/haian-riverfront-dja-nang/Superior /slyat3hj1cita5n3.webp","tour/haian-riverfront-dja-nang/Superior /kvlf81pj1trfkgmn.webp","tour/haian-riverfront-dja-nang/Superi