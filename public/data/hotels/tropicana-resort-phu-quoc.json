ng tâm thị trấn Dương Đông. Chỉ mất 2 phút đi bộ ra bãi Trường là quý khách đã được chiêm ngưỡng khung cảnh bao la, tuyệt vời của biển cả ngay trước mắt. Các phòng khách sạn được lát sàn gỗ, cung cấp đầy đủ tiện nghi cơ bản, hướng nhìn ra vườn hoặc biển chắc chắn đem đến cho bạn cảm giác thư giãn, thoải mái khi chọn khu nghỉ dưỡng."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/tropicana-resort-phu-quoc/blog/3z0ieswgaus71noq.webp","caption":""}],"rooms":[{"id":"6703674b7140e5956a6608ca","title":"Standard Garden view","size":42,"maxPersons":2,"price":1300000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/tropicana-resort-phu-quoc/Standard Garden view/1qq2q6e9iubpt5of.webp","tour/tropicana-resort-phu-quoc/Standard Garden view/vt8w4dvu2rcksu4g.webp","tour/tropicana-resort-phu-quoc/Standard Garden view/oxe186u6c23gx74e.webp"]},{"id":"6703674b7140e5956a6608cc","title":"Deluxe Ocean View","size":42,"maxPersons":2,"price":1600000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/tropicana-resort-phu-quoc/Deluxe Ocean View/r7w3s0f9ysmejom5.webp","tour/tropicana-resort-phu-quoc/Deluxe Ocean View/ehf3gmijs4udjbsf.webp","tour/tropicana-resort-phu-quoc/Deluxe Ocean View/kjp6npbm6j3j4t1z.webp"]},{"id":"6703674b7140e5956a6608ce","title":"Bungalow Garden","size":48,"maxPersons":2,"price":1600000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/tropicana-resort-phu-quoc/Bungalow Garden/jtcczwa330fuuy0w.webp","tour/tropicana-resort-phu-quoc/Bungalow Garden/w3oxnzyqt6nv6q1r.webp","tour/tropicana-resort-phu-quoc/Bungalow Garden/jv0b4ngt1f80lzgm.webp"]},{"id":"6703674b7140e5956a6608d0","title":"Beach Front","size":60,"maxPersons":2,"price":2150000,"salePrice":0,"fe