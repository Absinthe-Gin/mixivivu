2757819mwpp.webp","tour/flc-grand-hotel-sam-son/images/3uaroff19k3mcr45.webp","tour/flc-grand-hotel-sam-son/images/h57z5hax7k5sgci1.webp","tour/flc-grand-hotel-sam-son/images/rag4ni3hu1cbdx3z.webp","tour/flc-grand-hotel-sam-son/images/cjrsxvh5npkwjv80.webp","tour/flc-grand-hotel-sam-son/images/3te6j2jbzxwmx6lu.webp","tour/flc-grand-hotel-sam-son/images/5eu75dnnjfk6uwz8.webp"],"highlights":["Nằm ở một vị trí thuận lợi cho du khách tham quan và di chuyển","Hệ thống bể bơi rộng rãi, thoáng mát","Hệ thông nhà hàng và quầy bar mang đến nền ẩm thực đa dạng","Hệ thống phòng họp hội nghị được trang bị đầy đủ âm thanh ánh sáng","Các tiện ích khác: dịch vụ Spa, sân golf, dịch vụ BBQ, bàn billiards,..."],"content":[{"type":"paragraph","text":"<a href=\"https://www.bestprice.vn/khach-san/flc-grand-hotel-sam-son-1402.html\">FLC Grand Hotel Sầm Sơn</a>&nbsp;là khách sạn đạt tiêu chuẩn 5 sao ấn tượng với vị trí nằm trên mặt biển Sầm Sơn, có thiết kế hình vòng cung và tất cả các phòng đều view biển. Khách sạn được thiết kế gồm 7 tầng, với tất cả 350 phòng nghỉ được trang bị đầy đủ tiện nghi hiện đại và đẳng cấp."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/flc-grand-hotel-sam-son/blog/3x9so5gvxr6hodpj.webp","caption":""},{"type":"paragraph","text":"Khi nhắc tới FLC Grand Hotel Sầm Sơn nhiều du khách ấn tượng với hồ bơi nước mặn lớn nhất Đông Nam Á, sân golf 18 hố dạng link, trung tâm hội nghị quốc tế 1300 chỗ, khu đô thị phố biển L’Amoura… Cùng với những dịch vụ tiện ích nổi bật như: Phòng tập gym, khu vui chơi trẻ em, nhà hàng ẩm thực đa quốc gia, rooftop bar ngoài trời trên tầng cao nhất hứa hẹn sẽ mang tới chuyến nghỉ dưỡng đáng nhớ cho du khách."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/flc-grand-hotel-sam-son/blog/qf089wqs00bx9y9z.webp","caption":"Gym"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/flc-grand-hotel-sam-son/blog/514kq5k9ktudysiz.webp","caption":"Golf"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/flc-grand-hotel-sam-son/blog/o3gt8j37rl4pan5w.webp","caption":"Spa"}],"rooms":[{"id":"68a401657f201468c38cc107","title":"Grand Comfort","size":32,"maxPersons":2,"price":1900000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/flc-grand-hotel-sam-son/Grand Comfort/ncr2w1aiqtj82zp3.webp","tour/flc-grand-hotel-sam-son/Grand Comfort/3w57t2qe4hyjlcso.webp"]},{"id":"68a401657f201468c38cc109","title":"Grand Premier","size":55,"maxPersons":2,"price":2160000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/flc-grand-hotel-sam-son/Grand Premier/tkq12rkntmhig1kn.webp","tour/flc-grand-hotel-sam-son/Grand Premier/kss3jfd8hempq27x.webp","tour/flc-grand-hotel-sam-son/Grand Premier/vfz98njubbm7xyur.webp","tour/flc-grand-hotel-sam-son/Grand Premier/1zjahk9irt3dyrs9.webp","tour/flc-grand-hotel-sam-son/Grand Premier/dvl2r6c5zt7phtoz.webp","tour/flc-grand-hotel-sam-son/Grand Premier/0yazgubidjq16w84.webp"]},{"id":"68a401657f201468c38cc10b","title":"Grand Suite","size":71,"maxPersons":4,"price":3200000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/flc-grand-hotel-sam-son/Grand Suite/x60u0j1kxtqhixd9.webp","tour/flc-grand-hotel-sam-son/Grand Suite/qlu6d1sguj3m2sth.webp","tour/flc-grand-hotel-sam-son/Grand Suite/wlrhvxps87jfbki0.webp","tour/flc-grand-hotel-sam-son/Grand Suite/zayyrinb59uidd0c.webp","tour/flc-grand-hotel-sam-son/Grand Suite/gc3z7u3o59gdvnid.webp"]}],"reviews":[]}