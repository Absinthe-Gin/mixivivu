 giữa lòng thành phố”."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/khach-san/blog/tbc3sh9ia39jfw1h.webp","caption":""},{"type":"paragraph","text":"Nhà hàng của khách sạn cũng phục vụ các món ăn Á và Âu cho bữa sáng buffet và bữa trưa, bữa tối theo thực đơn có sẵn."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/khach-san/blog/wz59d9pf8aj1pc9v.webp","caption":""},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/khach-san/blog/lob1t7z6aiyooj00.webp","caption":""}],"rooms":[{"id":"66ed240a0b818e5ee74ae59e","title":"Deluxe Twin with balcony","size":32,"maxPersons":2,"price":1100000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/salmalia-boutique-hotel-and-spa/Deluxe Twin with balcony/nin1cf5tymo9tsh0.webp","tour/salmalia-boutique-hotel-and-spa/Deluxe Twin with balcony/wkitrm9nx8umohov.webp","tour/salmalia-boutique-hotel-and-spa/Deluxe Twin with balcony/sckc4vxneqn85ult.webp","tour/salmalia-boutique-hotel-and-spa/Deluxe Twin with balcony/7p031fnwacu5lxg7.webp"]},{"id":"66ed240a0b818e5ee74ae59c","title":"Deluxe King with balcony","size":32,"maxPersons":2,"price":1050000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/salmalia-boutique-hotel-and-spa/Deluxe King with balcony/9ymbu84gx3k4ji3n.webp","tour/salmalia-boutique-hotel-and-spa/Deluxe King with balcony/qsx1jgbfg9hgn63q.webp","tour/salmalia-boutique-hotel-and-spa/Deluxe King with balcony/fuz2y3fhe10e0zxt.webp","tour/salmalia-boutique-hotel-and-spa/Deluxe King with balcony/6jxk96turpzlhl3q.webp"]},{"id":"66ed240a0b818e5ee74ae5a2","title":"Premier Twin with balcony & bathtub","size":33,"maxPersons":2,"price":1250000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["