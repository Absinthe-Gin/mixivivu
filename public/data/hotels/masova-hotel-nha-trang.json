ng/blog/gtyh12n3k6h10fpa.webp","caption":""},{"type":"paragraph","text":"Khách sạn cung cấp chỗ nghỉ với hệ thống 80 phòng đều được bố trí cửa sổ lớn nhằm tối đa hóa không gian, tạo cảm giác thư giãn tuyệt đối trong căn phòng. Cùng với lối kiến trúc đạt tới độ thẩm mỹ cao, dịch vụ tiện ích hấp dẫn nơi đây hứa hẹn sẽ mang đến những trải nghiệm mới lạ và độc đáo cho Quý khách trong suốt chuyến đi tới Nha Trang.&nbsp;"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/masova-hotel-nha-trang/blog/d271icme2de9v7qw.webp","caption":""},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/masova-hotel-nha-trang/blog/mf3dyp8p2hzdhpe7.webp","caption":""}],"rooms":[{"id":"66ecedfa0b818e5ee74ad826","title":"Senior Sea Room","size":26,"maxPersons":2,"price":950000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/masova-hotel-nha-trang/Senior Sea Room/p9jeza9n201aoatb.webp","tour/masova-hotel-nha-trang/Senior Sea Room/eyut8w7kx19z5njw.webp","tour/masova-hotel-nha-trang/Senior Sea Room/41oun1tr00qv1een.webp","tour/masova-hotel-nha-trang/Senior Sea Room/rycc6cmkw2pajopn.webp","tour/masova-hotel-nha-trang/Senior Sea Room/xcvly3gshl5dlqhc.webp","tour/masova-hotel-nha-trang/Senior Sea Room/qb8zpyifdls033ei.webp"]},{"id":"66ecedfa0b818e5ee74ad824","title":"Deluxe Room","size":24,"maxPersons":2,"price":800000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/masova-hotel-nha-trang/Deluxe Room/t32l1x3ocfysc7t1.webp","tour/masova-hotel-nha-trang/Deluxe Room/dhsy93ocalygdknz.webp","tour/masova-hotel-nha-trang/Deluxe Room/2cesgg2ih8j6n1b2.webp","tour/masova-hotel-nha-trang/Deluxe Room/rta0ikn4cl32zqdb.webp","tour/masova-hotel-nha-trang/Deluxe Room/8xu5jsq26qzzkmzy.webp"]}],"reviews":[]}