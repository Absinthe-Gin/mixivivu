nvas-beach-dja-nang-hotel/images/zlutl9nlaf7d6f5q.webp","tour/canvas-beach-dja-nang-hotel/images/qau5b8dc563sgp4q.webp","tour/canvas-beach-dja-nang-hotel/images/klicnphisccnvaql.webp","tour/canvas-beach-dja-nang-hotel/images/9f3rqofrea8jr0h5.webp","tour/canvas-beach-dja-nang-hotel/images/sutuynhhuevqqntt.webp","tour/canvas-beach-dja-nang-hotel/images/5fffx81wko3otb63.webp","tour/canvas-beach-dja-nang-hotel/images/sl0emw3stg3zv0lf.webp","tour/canvas-beach-dja-nang-hotel/images/c9vjlwsnkdpem174.webp","tour/canvas-beach-dja-nang-hotel/images/4n9e2gaal0z1334x.webp","tour/canvas-beach-dja-nang-hotel/images/8vet6axb2b31935l.webp","tour/canvas-beach-dja-nang-hotel/images/34pe58caf9pg7sso.webp","tour/canvas-beach-dja-nang-hotel/images/qrmx1tcpn2fir4vv.webp","tour/canvas-beach-dja-nang-hotel/images/106y7dgjwla4omh8.webp","tour/canvas-beach-dja-nang-hotel/images/82amd306p5ktuwj9.webp","tour/canvas-beach-dja-nang-hotel/images/8sc43vc96jrxv61v.webp","tour/canvas-beach-dja-nang-hotel/images/1gvwqgifyuwzgzb2.webp","tour/canvas-beach-dja-nang-hotel/images/m0jfe0n94pyacu0i.webp"],"highlights":["Vị trí đẹp, nằm bên dải cát trắng mịn trải dài của bãi biển Mỹ Khê xinh đẹp.","Nhà hàng phục vụ đa dạng phong vị ẩm thực địa phương và quốc tế.","Hồ bơi vô cực trên tầng thượng của khách sạn.","2 quán Bar nằm ngay trong khuôn viên: Sailing Rooftop Bar, Compass Coffee & Bar."],"content":[{"type":"paragraph","text":"Toạ lạc tại thành phố Đà Nẵng xinh đẹp,&nbsp;Canvas Beach Da Nang Hotel&nbsp;thuộc dòng khách sạn đạt tiêu chuẩn 4*. "},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/canvas-beach-dja-nang-hotel/blog/x6wbdlg6lg5x48gc.webp","caption":""},{"type":"paragraph","text":"Với hệ thống phòng được thiết kế bởi những kiến trúc sư có nhiều năm kinh nghiệm, khách sạn là minh chứng điển hình đi theo lối kiến trúc thiết kế hiện đại, trang trọng. "},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/canvas-beach-dja-nang-hotel/blog/yqd999n5kfxgtnbg.webp","caption":""},{"type":"paragraph","text":"Bên cạnh cơ sở vật chất hiện đại, Canvas Beach còn cung cấp hàng loạt các tiện ích với mong muốn tối đa sự thoải mái của khách lưu trú. Nơi đây hứa hẹn sẽ là lựa chọn tuyệt vời cho chuyến đi du lịch hay công tác tại thành phố Đà Nẵng của Quý khách.&nbsp;"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/canvas-beach-dja-nang-hotel/blog/hy7194bh5efxwmnk.webp","caption":""}],"rooms":[{"id":"684114f367d50ad1ec4816c3","title":"Classic King","size":28,"maxPersons":2,"price":1400000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/canvas-beach-dja-nang-hotel/Classic King/6dnn60nawgdczvwl.webp","tour/canvas-beach-dja-nang-hotel/Classic King/53jdramqhkmsldan.webp","tour/canvas-beach-dja-nang-hotel/Classic King/4207aed86qc7929w.webp","tour/canvas-beach-dja-nang-hotel/Classic King/0n5pj4i55129j1b2.webp","tour/canvas-beach-dja-nang-hotel/Classic King/xulq14hmd2dun1g1.webp"]},{"id":"684114f367d50ad1ec4816c5","title":"Premier Twin","size":32,"maxPersons":2,"price":1400000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/canvas-beach-dja-nang-hotel/Premier Twin/m34mrae8gbijdy78.webp","tour/canvas-beach-dja-nang-hotel/Premier Twin/x536cys30yjzhgxs.webp","tour/canvas-beach-dja-nang-hotel/Premier Twin/blgmonay7g4n2npi.webp","tour/canvas-beach-dja-nang-hotel/Premier Twin/yr5a0n5zypsrslle.webp"]},{"id":"684114f367d50ad1ec4816c7","title":"Grand Premier Twin","size":35,"maxPersons":2,"price":1500000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/canvas-beach-dja-nang-hotel/Grand Premier Twin/551vx5l4dorxbw0z.webp","tour/canvas-beach-dja-nang-hotel/Grand Premier Twin/g1qxbaxj9jm7b86o.webp","tour/canvas-beach-dja-nang-hotel/Grand Premier T