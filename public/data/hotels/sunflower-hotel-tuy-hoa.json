iãn và vui chơi mà còn là sự lựa chọn hàng đầu cho việc tổ chức các chương trình hội nghị - hội thảo, các tour tham quan, khám phá danh lam thắng cảnh và biển đảo với một phong cách phục vụ tận tâm, thân thiết và chuyên nghiệp. Với hệ thống phòng nghỉ hiện đại, trang bị đầy đủ tiện nghi sẽ mang đến cho quý khách cảm giác thư giãn nhất khi lưu trú tại đây."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/sunflower-hotel-tuy-hoa/blog/0my0hj6scp16e2q7.webp","caption":""},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/sunflower-hotel-tuy-hoa/blog/euu1807p996e201z.webp","caption":""}],"rooms":[{"id":"66ed21b20b818e5ee74ae483","title":"Superior","size":24,"maxPersons":2,"price":600000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Nước đóng chai miễn phí"],"images":["tour/sunflower-hotel-tuy-hoa/Superior/wnynvc9o9kqfys17.webp","tour/sunflower-hotel-tuy-hoa/Superior/xgq00lnyzvyu1sik.webp","tour/sunflower-hotel-tuy-hoa/Superior/h81qscj1w25ly9tv.webp","tour/sunflower-hotel-tuy-hoa/Superior/hoe7nt0h789i3trz.webp","tour/sunflower-hotel-tuy-hoa/Superior/gk29vz2chhqqddtv.webp"]},{"id":"66ed21b20b818e5ee74ae487","title":"Deluxe Sea View","size":26,"maxPersons":2,"price":700000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Nước đóng chai miễn phí"],"images":["tour/sunflower-hotel-tuy-hoa/Deluxe Sea View/83m07flwy2ss3uwe.webp","tour/sunflower-hotel-tuy-hoa/Deluxe Sea View/k6oxy9k24sgot9lf.webp","tour/sunflower-hotel-tuy-hoa/Deluxe Sea View/nsvnhez84vzxqmxx.webp","tour/sunflower-hotel-tuy-hoa/Deluxe Sea View/fb8ulgza73b6mpxy.webp","tour/sunflower-hotel-tuy-hoa/Deluxe Sea View/g1hi6nclvec4rivu.webp","tour/sunflower-hotel-tuy-hoa/Deluxe Sea View/qfddzejywokqxzz5.webp"]},{"id":"66ed21b20b818e5ee74ae485","title":"Deluxe City View","size":26,"maxPersons":2,"price":550000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Ti