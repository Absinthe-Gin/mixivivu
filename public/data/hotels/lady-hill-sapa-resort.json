/lady-hill-sapa-resort/images/tyu9ssz16bpmlrgb.webp","tour/lady-hill-sapa-resort/images/ifp0u09lhb964wun.webp","tour/lady-hill-sapa-resort/images/rtpnr7yxu5onsom7.webp","tour/lady-hill-sapa-resort/images/vylyokjsvmj98kzx.webp","tour/lady-hill-sapa-resort/images/g40b1u6n6lc97mw8.webp","tour/lady-hill-sapa-resort/images/gt99nj173ich6o26.webp","tour/lady-hill-sapa-resort/images/mae70e6fj26ql23a.webp","tour/lady-hill-sapa-resort/images/q7nd6iricro4peb8.webp","tour/lady-hill-sapa-resort/images/nmy3fjiyylei477v.webp","tour/lady-hill-sapa-resort/images/2q6af0fz3vyaw5uv.webp","tour/lady-hill-sapa-resort/images/2thbxufj3jiq7r1m.webp","tour/lady-hill-sapa-resort/images/m8c6yybhyr9guerc.webp","tour/lady-hill-sapa-resort/images/p0oj1c0cj95qdkik.webp","tour/lady-hill-sapa-resort/images/snuwh0c5twf9f3d2.webp","tour/lady-hill-sapa-resort/images/cwfsk1nuw2od1fg6.webp","tour/lady-hill-sapa-resort/images/cdh9337hrxe3r2v4.webp","tour/lady-hill-sapa-resort/images/b5dqw8z15kwoz25v.webp","tour/lady-hill-sapa-resort/images/puswrb3x6qvwo7va.webp","tour/lady-hill-sapa-resort/images/9zyr8rqxo760el6k.webp","tour/lady-hill-sapa-resort/images/qkbznu6q59pg4flr.webp"],"highlights":["Ru giấc giữa mây ngàn trong không gian ấm áp, đầy cảm hứng, thu hút với phong cách tối giản sang trọng kết hợp cùng họa tiết trang trí mang âm hưởng Tây Bắc tại các phòng nghỉ dưỡng của Lady Hill Sapa Resort.","Lady Hill Sapa Resort chào đón bạn bằng một \"khoảnh khắc chạm mây ngàn\" đầy cảm hứng, nơi mọi nỗi lo lắng sẽ bị \"thổi bay\" trong không gian thư giãn và yên bình của đồi núi Sa Pa","Tại Lady Hill Sapa Resort, mỗi khoảnh khắc đều là một hành trình khám phá và hòa mình vào vẻ đẹp của thiên nhiên","Lady Hill Sapa Resort – Nơi từng chiếc lá, từng trái cây kể câu chuyện về sự tinh túy và thuần khiết từ thiên nhiên"],"content":[{"type":"paragraph","text":"Lấy cảm hứng từ đôi khuyên tai “Khu chê” của phụ nữ H’Mong. Nép mình bên những áng mây bồng bềnh, nằm biệt lập trên đỉnh đồi đối diện ga cáp treo Phan Xi Păng, khu nghỉ dưỡng 5* Lady Hill Sapa Resort sở hữu tầm nhìn bao trọn khung cảnh đỉnh núi Fansipan hùng vỹ."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/lady-hill-sapa-resort/blog/bxt7obywmnwz4pi6.webp","caption":""},{"type":"paragraph","text":"Lady Hill Sapa Resort, khu nghỉ dưỡng đầu tiên ở Việt Nam mang dáng hình chiếc khuyên tai đặc trưng của vùng Tây Bắc, nằm biệt lập trên đỉnh đồi đối diện ga cáp treo Fansipan. Sở hữu tầm nhìn bao trọn khung cảnh đỉnh núi Fansipan hùng vỹ, giữa không gian xanh rộng hơn 22 ha, Lady Hill Sapa Resort vẽ nên bức tranh đầy thơ mộng, hòa quyện giữa sắc màu độc đáo của Sa Pa và mang đến hơi thở đương đại đầy sức sống.&nbsp;"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/lady-hill-sapa-resort/blog/t7kuu3nvg0zy5pjm.webp","caption":""},{"type":"paragraph","text":"Lady Hill Sapa Resort hứa hẹn là khu nghỉ dưỡng lý tưởng cho mọi kỳ nghỉ, sự kiện đáng nhớ với 154 phòng nghỉ cao cấp và 20 villa biệt lập; thả mình trong bể bơi vô cực trong làn nước mát lạnh hay thư thái giữa mây ngàn ở Sky Lounge,…"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/lady-hill-sapa-resort/blog/p8t60ltiac4konpr.webp","caption":""}],"rooms":[{"id":"66f3c8ec0b818e5ee74ba1c2","title":"Deluxe","size":32,"maxPersons":2,"price":2810000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/lady-hill-sapa-resort/Deluxe/jgvf8isen6lnz85m.webp","tour/lady-hill-sapa-resort/Deluxe/f301g8oiq92i1vut.webp","tour/lady-hill-sapa-resort/Deluxe/wvmaxjxmv0byefqu.webp","tour/lady-hill-sapa-resort/Deluxe/68r35uop60v9v53x.webp","tour/lady-hill-sapa-resort/Deluxe/gzt5642job8rtbpg.webp"]},{"id":"66f3c8ec0b818e5ee74ba1d0","title":"Bungalow Sa Mộc","size":46,"maxPersons":2,"price":3750000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/lady-