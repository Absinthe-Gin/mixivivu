u-quoc-hotel/blog/twzvqf6d0m7cbvd5.webp","caption":""},{"type":"paragraph","text":" Mỗi hạng phòng ở đây đều có thiết kế sang trọng với không gian mở cùng ban công rộng rãi, thoáng mát. "},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/nesta-phu-quoc-hotel/blog/fu7oovt9slexgiog.webp","caption":""},{"type":"paragraph","text":"Nghỉ dưỡng tại đây, quý khách sẽ được trải nghiệm nhiều dịch vụ cao cấp cũng như tham quan nhiều địa điểm vui chơi giải trí mà không mất quá nhiều thời gian để di chuyển, khách sạn hứa hẹn sẽ là điểm dừng chân lý tưởng dành cho du khách khi ghé thăm Phú Quốc xinh đẹp."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/nesta-phu-quoc-hotel/blog/kmqyy9a92brequej.webp","caption":""}],"rooms":[{"id":"66fa1f430b818e5ee74c50c3","title":"Standard","size":23,"maxPersons":2,"price":700000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Nước đóng chai miễn phí"],"images":["tour/nesta-phu-quoc-hotel/Standard /wky9i9qf8d6j98mx.webp","tour/nesta-phu-quoc-hotel/Standard /ieeu63dqwq3mntw9.webp","tour/nesta-phu-quoc-hotel/Standard /wga6l77u0fwnjnt0.webp","tour/nesta-phu-quoc-hotel/Standard /khcvs88wr6zyxxkw.webp","tour/nesta-phu-quoc-hotel/Standard /3drelvl63s4me08f.webp","tour/nesta-phu-quoc-hotel/Standard /ibarxh4rhg84u91u.webp","tour/nesta-phu-quoc-hotel/Standard /nc1dj62xka4cye8h.webp"]},{"id":"66fa1f430b818e5ee74c50c7","title":"Deluxe","size":26,"maxPersons":2,"price":950000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Nước đóng chai miễn phí"],"images":["tour/nesta-phu-quoc-hotel/Deluxe/z52vq03z0zuzac3d.webp","tour/nesta-phu-quoc-hotel/Deluxe/pyqqp0in5ndava3m.webp","tour/nesta-phu-quoc-hotel/Deluxe/qho9o5qzri5nesjh.webp","tour/nesta-phu-quoc-hotel/Deluxe/m1i6xtjn0c4218u0.webp","tour/nesta-phu-quoc-hotel/Deluxe/de07bcgbwkrdjh2a.webp","tour/nesta-phu-quoc-hotel/Deluxe/giboawjmq552a41u.webp"]},{"id":"66fa1f430b818e5ee74c50c5","titl