jgnsj3n7og.webp","caption":""},{"type":"paragraph","text":"Tới với Rock Mila Phú Quốc Hotel, quý khách có thể thoải mái tắm biển hoặc đón ánh chiều tà của hoàng hôn lãng mạn trên biển hay trải nghiệm các hoạt động vui chơi mua sắm chỉ với một vài phút đi xe."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/khach-san/blog/jstp72bbnnvc1vr3.webp","caption":""},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/khach-san/blog/lhevd2vfwt333hn8.webp","caption":""},{"type":"paragraph","text":"&nbsp;Với đội ngũ nhân viên tận tình và chuyên nghiệp, chắc chắn&nbsp;Rock Mila Phú Quốc Hotel sẽ mang đến cho quý khách những phút giây thư giãn tuyệt vời trong kỳ nghĩ và chuyến công tác của mình."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/khach-san/blog/gjn9jn35vx6utkj4.webp","caption":""}],"rooms":[{"id":"66f24db10b818e5ee74b4cbb","title":"Standard Tripple Room","size":28,"maxPersons":3,"price":750000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Nước đóng chai miễn phí"],"images":["tour/du-thuyen/Standard Tripple Room/dkyu0j0akvqnjbp1.webp","tour/du-thuyen/Standard Tripple Room/hce6r5fajvhuqrz9.webp","tour/du-thuyen/Standard Tripple Room/q796ogar9dcph3th.webp","tour/du-thuyen/Standard Tripple Room/5k0wft3pu56rr2ra.webp"]},{"id":"66f24db10b818e5ee74b4cb7","title":"Standard Double Room","size":21,"maxPersons":2,"price":600000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Nước đóng chai miễn phí"],"images":["tour/du-thuyen/Standard Double Room/gwkgf4xz6epcrmjf.webp","tour/du-thuyen/Standard Double Room/gc3tf66yahqgvyel.webp","tour/du-thuyen/Standard Double Room/kktpyycnk3dkkw5t.webp","tour/du-thuyen/Standard Double Room/98t2x1xxq8v8ava4.webp","tour/du-thuyen/Standard Double Room/1004k7yneojwpy8d.webp"]},{"id":"66f24db10b818e5ee74b4cb9","title":"Standard Double Room - Twin Bed","size":24,"maxPersons":2,"price":650000,"salePrice":0,"fe