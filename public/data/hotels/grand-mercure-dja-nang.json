 sẽ không làm bạn thất vọng."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/grand-mercure-dja-nang/blog/zqeaahkj027fovom.webp","caption":"Phòng chơi trẻ em"}],"rooms":[{"id":"66e3ea180b818e5ee74940f9","title":"Deluxe","size":26,"maxPersons":2,"price":2650000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/grand-mercure-dja-nang/Deluxe/9qzkn7q00zwinecq.webp","tour/grand-mercure-dja-nang/Deluxe/yh21ptj23l904om6.webp","tour/grand-mercure-dja-nang/Deluxe/on6fegfzdoidsu2u.webp","tour/grand-mercure-dja-nang/Deluxe/rn9bstjbe8frulma.webp","tour/grand-mercure-dja-nang/Deluxe/7jkgafmfqvijxa42.webp"]},{"id":"66e3ea180b818e5ee74940fb","title":"Executive Suite","size":52,"maxPersons":2,"price":3510000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/grand-mercure-dja-nang/Executive Suite/y8ci5jnir6w1qxwf.webp","tour/grand-mercure-dja-nang/Executive Suite/bg5jjvo7gjczy8c4.webp","tour/grand-mercure-dja-nang/Executive Suite/rg067036s5rdv1fd.webp","tour/grand-mercure-dja-nang/Executive Suite/mogf8of44jwx2dp6.webp","tour/grand-mercure-dja-nang/Executive Suite/9e9s84xtbh4bidy5.webp","tour/grand-mercure-dja-nang/Executive Suite/f746iwvdr84ob9vu.webp","tour/grand-mercure-dja-nang/Executive Suite/5ut93fgbhdw95jq8.webp"]},{"id":"66e3ea180b818e5ee74940f7","title":"Superior","size":26,"maxPersons":2,"price":2000000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/grand-mercure-dja-nang/Superior/nh2h8owtv86cpal7.webp","tour/grand-mercure-dja-nang/Superior/q3a7qbui18pfer92.webp","tour/grand-mercure-dja-nang/Superior/acoksfdzkiiw0dxx.webp","tour/grand-mercure-dja-nang/Superior/kgvjon11uj8rncas.webp"]}],"reviews":[]}