như là những tông màu trầm hoặc trắng tạo cho không gian trở nên thu hút khách hàng hơn. Nơi đây luôn chú trọng đến chi tiết của từng dịch vụ, nhằm giúp quý khách lưu trú tận hưởng các dịch vụ chất lượng và đảm bảo."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/the-tahiti-beach-hotel-phu-quoc/blog/ngwpzwjckbxo1kci.webp","caption":""},{"type":"paragraph","text":"Bên cạnh việc cung cấp dịch vụ lưu trú, The Tahiti Beach Hotel Phú Quốc còn cung cấp dịch vụ ăn uống đa dạng nhằm giúp du khách thuận tiện hơn trong quá trình nghỉ dưỡng tại khách sạn có nhà hàng và quán bar đáp ứng nhu cầu đa dạng của du khách."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/the-tahiti-beach-hotel-phu-quoc/blog/5qdggtr8mf16l3ua.webp","caption":""}],"rooms":[{"id":"66f0f22a0b818e5ee74b0f67","title":"Deluxe Sea View","size":25,"maxPersons":2,"price":1200000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/the-tahiti-beach-hotel-phu-quoc/Deluxe Sea View/u8vrx6i38gzhasgp.webp","tour/the-tahiti-beach-hotel-phu-quoc/Deluxe Sea View/v36r1xswneqi5s1l.webp","tour/the-tahiti-beach-hotel-phu-quoc/Deluxe Sea View/tv79lj3fmjcr2k2j.webp","tour/the-tahiti-beach-hotel-phu-quoc/Deluxe Sea View/w55uu0jem563vyfh.webp","tour/the-tahiti-beach-hotel-phu-quoc/Deluxe Sea View/8ryckbeko8ukiog1.webp","tour/the-tahiti-beach-hotel-phu-quoc/Deluxe Sea View/8tzabz6o9d4fz3p8.webp","tour/the-tahiti-beach-hotel-phu-quoc/Deluxe Sea View/95nbhlcnec295o1e.webp"]},{"id":"66f0f22a0b818e5ee74b0f6b","title":"Family Suite Ocean View","size":45,"maxPersons":4,"price":3200000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/the-tahiti-beach-hotel-phu-quoc/Family Suite Ocean View/95s8alb9y9bdfca7.webp","tour/the-tahiti-beach-hotel-phu-quoc/Family Suite Ocean View/falzt3fvwxe47ljp.webp","tour/the