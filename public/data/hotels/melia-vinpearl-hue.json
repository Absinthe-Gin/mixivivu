images/90xv266xbd2jqvnt.webp","tour/melia-vinpearl-hue/images/95o6nr2vvry1r7mz.webp","tour/melia-vinpearl-hue/images/y1yd0ko2e53c2rkp.webp","tour/melia-vinpearl-hue/images/phwi7zb7863f0rrp.webp","tour/melia-vinpearl-hue/images/naje6jpo7qwz16z4.webp","tour/melia-vinpearl-hue/images/ukeu7av1rh3erjho.webp","tour/melia-vinpearl-hue/images/pzzz022jc8kc00t1.webp","tour/melia-vinpearl-hue/images/as4q4407lotrzsn0.webp","tour/melia-vinpearl-hue/images/zv4ml2sstn2n4zhm.webp","tour/melia-vinpearl-hue/images/gp2jy855m1e9hn8w.webp","tour/melia-vinpearl-hue/images/18qgrnisdohqm118.webp","tour/melia-vinpearl-hue/images/4g6xtqafrfi1do4m.webp","tour/melia-vinpearl-hue/images/nwx8ptzv45s12y0j.webp","tour/melia-vinpearl-hue/images/y8ago2tpn7skmsw0.webp","tour/melia-vinpearl-hue/images/tcesf511iavbqyna.webp","tour/melia-vinpearl-hue/images/28ekfsj1ptgh920k.webp","tour/melia-vinpearl-hue/images/5dzyt4whxxt5cycq.webp","tour/melia-vinpearl-hue/images/u9rbedd423n2qieu.webp","tour/melia-vinpearl-hue/images/apyj6ij5619qbtw3.webp","tour/melia-vinpearl-hue/images/b32v2ors3ea5ql06.webp","tour/melia-vinpearl-hue/images/le12k18athekbjfr.webp","tour/melia-vinpearl-hue/images/fwhm07as62qk9h30.webp","tour/melia-vinpearl-hue/images/dx9jls9nfltz39qc.webp","tour/melia-vinpearl-hue/images/m0xva1wex10xzf9o.webp","tour/melia-vinpearl-hue/images/1dba0f12wtbmsfe9.webp","tour/melia-vinpearl-hue/images/ly1dpzncwygp618h.webp","tour/melia-vinpearl-hue/images/hcpcv4snf6qbclf3.webp","tour/melia-vinpearl-hue/images/pzcpzj66ef95dg3i.webp","tour/melia-vinpearl-hue/images/gz2x8dweg5my8wga.webp","tour/melia-vinpearl-hue/images/3loqxqow6if232c3.webp","tour/melia-vinpearl-hue/images/omyf9hvmtb83ecya.webp","tour/melia-vinpearl-hue/images/203qw6q1fp6d71cr.webp","tour/melia-vinpearl-hue/images/tjpxqo4elmdcb9h1.webp"],"highlights":["Nâng tầm từng sự kiện hội họp với dịch vụ chuyên nghiệp ngay giữa lòng thành phố tại Meliá Vinpearl Huế - nơi đồng hành lý tưởng để mọi cuộc họp luôn hiệu quả và chỉn chu.","Lưu giữ những kỷ niệm đáng nhớ và cùng gia đình tận hưởng mọi khoảnh khắc sum vầy đầy ý nghĩa tại Meliá Vinpearl Huế - nơi tái hiện không khí lễ hội náo nhiệt bên mỹ vị không giới hạn và các hoạt động gắn kết yêu thương.","Nơi đón tiếp những vị khách quý bằng các tiện ích độc quyền, nâng tầm sự khác biệt trong từng dịch vụ được cá nhân hóa, ưu tiên mọi trải nghiệm của du khách luôn thoải mái và riêng tư.","Ngày mới bắt đầu tràn đầy năng lượng khi được hoà mình thư giãn trong làn nước xanh mát của hồ bơi bốn mùa hay làm nóng cơ thể nơi phòng gym hiện đại tại Meliá Vinpearl Huế."],"content":[{"type":"paragraph","text":"Tọa lạc ngay trung tâm cố đô Huế với vị trí đắc địa, hướng sông Hương, tựa núi Ngự, tòa tháp khách sạn cao 34 tầng này vươn lên sừng sững như một thắng cảnh của thành phố - Đây là nơi giao thoa giữa truyền thống thiêng liêng và những nét đẹp hiện đại."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/melia-vinpearl-hue/blog/1xexd36jd4qmqrdl.webp","caption":""},{"type":"paragraph","text":"Thiết kế hình khối tinh xảo thể hiện hơi thở hiện đại và mạnh mẽ, nhưng Meliá Vinpearl Huế vẫn ôm trọn trong mình những nét tinh hoa đặc trưng của Đại Việt. Hoa văn duyên dáng của sông núi nước non, kim long phụng bảo ẩn hiện khắp nơi trong không gian của khách sạn."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/melia-vinpearl-hue/blog/r2jtwolzav8pd3q3.webp","caption":""},{"type":"paragraph","text":"Đến với Melia Vinpearl Hotel Hue, bạn không chỉ có cơ hội tận hưởng nhiều dịch vụ đẳng cấp mà còn được đắm chìm trong không gian kiến trúc và nghệ thuật độc đáo. Đó là nét kiến trúc có sự kết hợp hài hòa giữa hai gam màu chủ đạo - trắng xám và vàng đồng xuyên suốt từ những bức tường, khung cửa cho tới nội thất, tạo nên một tổng thể hài hòa, tao nhã nhưng không kém phần tinh tế. Mỗi căn phòng đều có ban công riêng với view thành phố cùng tầm nhìn thoáng đãng, mang đến không gian thư giãn riêng tư cho du khách."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/melia-vinpearl-hue/blog/ku2au68a27pesixd.webp","caption":""}],"rooms":[{"id":"66f958b60b818e5ee74c4224","title":"Deluxe Room","size":36,"maxPersons":2,"price":2000000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/melia-vinpearl-hue/Deluxe Room/p0wi3w7hzajrnjn0.webp","tour/melia-vinpearl-hue/Deluxe Room/aygq6jhkwc4y9eml.webp","tour/melia-vinpearl-hue/Deluxe Room/yp0myhxpe65j33hp.webp","tour/melia-vinpearl-hue/Deluxe Room/qxstdvixlat091ic.webp"]},{"id":"66f958b60b818e5ee74c4228","title":"Premium Room With Views","size":47,"maxPersons":2,"price":2600000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/melia-vinpearl-hue/Premium Room With Views/lq2hmg0c5u1iv6kp.webp","tour/melia-vinpearl-hue/Premium Room With Views/cw4naehfm27o0gsa.webp","tour/melia-vinpearl-hue/Premium Room With Views/xis8hv4vk4924ru1.webp","tour/melia-vinpearl-hue/Premium Room With Views/4qp3jmvee82exg05.webp"]},{"id":"66f958b60b818e5ee74c4230","title":"THE LEVEL Suite","size":81,"maxPersons":2,"price":5100000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/melia-vinpearl-hue/THE LEVEL Suite/lt3umto5jujz55h8.webp","tour/melia-vinpearl-hue/THE LEVEL Suite/1wsheecg05hn1mh6.webp","tour/melia-vinpearl-hue/THE LEVEL Suite/z5q791efx3ovdhsi.webp","tour/melia-vinpearl-hue/THE LEVEL Suite/25qf0ken9ue0r6x0.webp","tour/melia-vinpearl-hue/THE LEVEL Suite/00e5314juec83erm.webp"]},{"id":"66f958b60b818e5ee74c4226","title":"Premium Room","size":47,"maxPersons":2,"price":2300000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/melia-vinpearl-hue/Premium Room/nwfhqglebk6pqxz0.webp","tour/melia-vin