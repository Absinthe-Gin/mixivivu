elq3b.webp","caption":"Private dinning room"},{"type":"paragraph","text":"Khách sạn gần với biển Nhật Lệ, Đồi cát Quang Phú, Chợ Đồng Hới rất tiện cho việc tham quan và di chuyển"},{"type":"paragraph","text":" Vinpearl Hotel Quảng Bình chính là điểm dừng chân sang trọng và tiện nghi hàng đầu tại Đồng Hới mà du khách không nên bỏ qua."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/melia-vinpearl-quang-binh/blog/1mnt1m3yzbq8aj78.webp","caption":""}],"rooms":[{"id":"686b55997f201468c386703d","title":"Deluxe City View","size":35,"maxPersons":2,"price":1750000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/melia-vinpearl-quang-binh/Deluxe City View/x8alh0c42hp0ohhb.webp","tour/melia-vinpearl-quang-binh/Deluxe City View/qgr5y8lwjtvg6w2t.webp","tour/melia-vinpearl-quang-binh/Deluxe City View/2bvg2bqsppoxhfmq.webp","tour/melia-vinpearl-quang-binh/Deluxe City View/n7h3iz7c69gmd4st.webp"]},{"id":"686b55997f201468c386703f","title":"Deluxe River View","size":40,"maxPersons":2,"price":1950000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/melia-vinpearl-quang-binh/Deluxe River View/yqngab0otub34i84.webp","tour/melia-vinpearl-quang-binh/Deluxe River View/xrglkrndthuf6go4.webp","tour/melia-vinpearl-quang-binh/Deluxe River View/l9hv95w3upivw54z.webp","tour/melia-vinpearl-quang-binh/Deluxe River View/boln9kj1jg6bp8b8.webp","tour/melia-vinpearl-quang-binh/Deluxe River View/wkdiznjylg1fi4ze.webp"]},{"id":"686b55997f201468c3867041","title":"Suite River View","size":73,"maxPersons":2,"price":3800000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/melia-vinpearl-quang-binh/Suite River View/gvkx0a6k375cwp63.webp","tour/melia-vinpearl-quang-binh/Suite River View/th