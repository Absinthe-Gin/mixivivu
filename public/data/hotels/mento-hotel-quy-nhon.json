o thông thuận lợi, cách bãi biển chỉ 3 phút và rất gần các địa điểm tham quan nổi tiếng ở Quy Nhơn. Khách sạn được chia thành nhiều hạng phòng khác nhau, mang tới không gian nghỉ dưỡng đáng nhớ cho du khách. Những dịch vụ tiện ích nổi bật như: Hồ bơi ngoài trời, phòng tập gym, spa, nhà hàng buffet sáng, xông hơi bằng đá muối Himalaya... Cùng với đội ngũ nhân viên tại khách sạn Mento Hotel Quy Nhơn chuyên nghiệp và chu đáo, hứa hẹn sẽ là điểm dừng chân hoàn hảo cho du khách khi tới Quy Nhơn."}],"rooms":[{"id":"66fcfdd80b818e5ee74cbf3b","title":"Standard","size":20,"maxPersons":2,"price":700000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Nước đóng chai miễn phí"],"images":["tour/mento-hotel-quy-nhon/Standard/rjqgq3onw7l7kt8j.webp"]},{"id":"66fcfdd80b818e5ee74cbf3d","title":"Superior Double/Twin","size":24,"maxPersons":2,"price":800000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Nước đóng chai miễn phí"],"images":["tour/mento-hotel-quy-nhon/Superior Double/Twin/uwnb5r1lbbig94i3.webp","tour/mento-hotel-quy-nhon/Superior Double/Twin/a3bv9j6bhwf8msfz.webp"]},{"id":"66fcfdd80b818e5ee74cbf3f","title":"Deluxe Double/Twin","size":30,"maxPersons":2,"price":900000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Nước đóng chai miễn phí"],"images":["tour/mento-hotel-quy-nhon/ Deluxe Double/Twin/ltmsutrjmn7s4887.webp","tour/mento-hotel-quy-nhon/ Deluxe Double/Twin/zep9b7yxbbqjifhy.webp"]},{"id":"66fcfdd80b818e5ee74cbf43","title":"Family Suite","size":45,"maxPersons":4,"price":1550000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/mento-hotel-quy-nhon/Family Suite/y2h2lj05hgflnfn4.webp","tour/mento-hotel-quy-nhon/Family Suite/dxpohful3qyv01r5.webp"]},{"id":"66fcfdd80b818e5ee74cbf41","title":"Suite","size":40,"maxPersons":4,"price":1500000,"sal