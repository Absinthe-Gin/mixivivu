our/muong-thanh-grand-ha-long/images/8kdl28mx64w9xh19.webp","tour/muong-thanh-grand-ha-long/images/ai6l9qrxxqkzfbij.webp","tour/muong-thanh-grand-ha-long/images/iwfp20np2qp2yhvw.webp","tour/muong-thanh-grand-ha-long/images/kc9ocwedsjo833q0.webp","tour/muong-thanh-grand-ha-long/images/3rlb0p33m9bjh0ad.webp","tour/muong-thanh-grand-ha-long/images/7u3vml6dwabvuoet.webp","tour/muong-thanh-grand-ha-long/images/n655pt0y1dyht4l0.webp","tour/muong-thanh-grand-ha-long/images/wkyhqydb7t5z2beo.webp","tour/muong-thanh-grand-ha-long/images/l96a229nl4la4qbg.webp","tour/muong-thanh-grand-ha-long/images/3rll1wzbhkdrzij9.webp","tour/muong-thanh-grand-ha-long/images/pbzicjwkxtnacuwz.webp","tour/muong-thanh-grand-ha-long/images/tlwg48tko12th6zy.webp","tour/muong-thanh-grand-ha-long/images/knaycx8994obezkn.webp","tour/muong-thanh-grand-ha-long/images/hifv6ir9u5otpq9r.webp","tour/muong-thanh-grand-ha-long/images/rywmsuvm7vo3ycze.webp","tour/muong-thanh-grand-ha-long/images/648wydgzny1gpp66.webp","tour/muong-thanh-grand-ha-long/images/ltd8q2s7sehfixp0.webp","tour/muong-thanh-grand-ha-long/images/udm7ph5gqd7shg3f.webp","tour/muong-thanh-grand-ha-long/images/9c6i4xjew6cite9w.webp","tour/muong-thanh-grand-ha-long/images/2n0m4l6lnvj5g742.webp"],"highlights":["Khách sạn Mường Thanh Grand Hạ Long tọa lạc tại vị trí ngày cửa ngõ vào trung tâm du lịch Bãi Cháy. Với chất lượng đạt chuẩn 4 sao, có kiến trúc độc đáo quy mô lên tới192 phòng nghỉ được thiết kế hài hòa với thiên nhiên tạo ra không gian vô cùng thoải mái","Khách sạn Mường Thanh Grand Bãi Cháy tọa lạc tại vị trí đắc địa tại thành phố Hạ Long. Từ khách sạn có thể di chuyển thuận tiện và dễ dàng tới các điểm tham quan và công tác trong thành phố.","Là khách sạn đạt tiêu chuẩn 4 sao tại thành phố Hạ Long, Mường Thanh Grand Bãi Cháy là sự lựa chọn tuyệt vời cho quý khách tham quan cũng như công tác tại đây"],"content":[{"type":"paragraph","text":"Khi đến thăm Hạ Long, bạn sẽ cảm thấy như đang ở nhà tại Khách sạn Mường Thanh Grand Hạ Long, nơi có chất lượng tuyệt vời và dịch vụ chu đáo. Từ đây, khách có thể dễ dàng tiếp cận được nét đẹp sống động của thành phố ở mọi góc cạnh. Một điểm không kém phần đặc biệt là vị trí khách sạn dễ dàng tiếp cận vô số địa điểm thú vị như Bến tàu du lịch, Bãi tắm, Đảo Tuần Châu, Công viên Sunworld...&nbsp;"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/muong-thanh-grand-ha-long/blog/pt6l7d7trje1stk5.webp","caption":""},{"type":"paragraph","text":"Khách sạn đặc biệt có 192 phòng đẹp, có trang bị máy lạnh, bàn, quầy thức ăn nhẹ. Những phương tiện giải trí của khách sạn bao gồm bồn tắm nước nóng, phòng xông hơi, hồ bơi ngoài trời có mái che, phòng tập thể dục, massage, vườn được thiết kế để đem đến cho bạn sự thư giãn thoải mái."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/muong-thanh-grand-ha-long/blog/7x4pyo5cd41jplmj.webp","caption":""},{"type":"paragraph","text":"Thưởng thức toàn cảnh non nước Hạ Long từ khách sạn đạt tiêu chuẩn 4 sao Mường Thanh Grand Hạ Long, quý khách sẽ có những trải nghiệm tuyệt vời và thú vị ."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/muong-thanh-grand-ha-long/blog/zwgvw2tii6e50d7h.webp","caption":""}],"rooms":[{"id":"66a4ef97be6f0fbba3a4586e","title":"Deluxe King","size":26,"maxPersons":2,"price":1250000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/muong-thanh-grand-ha-long/Deluxe King/erg8iu7yx45477vw.webp","tour/muong-thanh-grand-ha-long/Deluxe King/msquhyp4i96ybary.webp","tour/muong-thanh-grand-ha-long/Deluxe King/76p1l0gca75vcxi1.webp","tour/muong-thanh-grand-ha-long/Deluxe King/dt5ar66o5k44dsx5.webp"]},{"id":"66a4ef97be6f0fbba3a45870","title":"Deluxe Twin","size":26,"maxPersons":2,"price":1250000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/muong-thanh-grand-ha-long/D