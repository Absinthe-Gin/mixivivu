ages/aipg61bqux68r9sp.webp","tour/paris-deli-hotel-dja-nang/images/5z3kat85av937fq1.webp","tour/paris-deli-hotel-dja-nang/images/i8ffxnu4ybr1vlce.webp"],"highlights":["Khách sạn Paris Deli tọa lạc ngay mặt đường Võ Nguyên Giáp, phía trước là biển Mỹ Khê tuyệt đẹp","Khách sạn gồm 23 tầng với hơn 103 phòng ngủ với thiết kế hiện đại, tiện nghi","Du khách có thể trải nghiệm không gian thoáng đãng ngoài trời tại SkyLine Bistro and Lounge trên tầng thượng của khách sạn","Khoảng cách từ khách sạn đến các điểm du lịch nổi tiếng chỉ khoảng tử 5- 10 phút"],"content":[{"type":"paragraph","text":"Tọa lạc ngay trên bãi biển Mỹ Khê xinh đẹp, khách sạn Paris Deli với bể bơi ngoài trời và tầm nhìn thoáng đãng sẽ là lựa chọn tuyệt vời cho du khách. Với 10 phút di chuyển từ sân bay Đà Nẵng hay chỉ mất khoảng 5 phút đến Bán Đảo Sơn Trà, Cầu Rông - đều là những điểm du lịch nổi tiếng tại Đà Nẵng."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/paris-deli-hotel-dja-nang/blog/ladpd13vleoaagsg.webp","caption":""},{"type":"paragraph","text":"Đặc biệt, không gian của&nbsp;SkyLine Bistro and Lounge trên tầng thượng với tầm nhìn toàn cảnh biển sẽ mang đến cảm giác vô cùng tự do và thoải mái cho du khách."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/paris-deli-hotel-dja-nang/blog/nrp1gunjvhpiinyu.webp","caption":""},{"type":"paragraph","text":"Sau những giờ phút khám phá Đà Nẵng, tắm biển thỏa thích, du khách có thể đặt các dịch vụ hay các&nbsp;phương pháp trị liệu hiện đại và cổ điển tại Oasis Spa.&nbsp;"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/paris-deli-hotel-dja-nang/blog/vb1u154qx6jr8qqd.webp","caption":"Nhà hàng sang trọng&nbsp;"}],"rooms":[{"id":"66e405370b818e5ee7496333","title":"Superior","size":23,"maxPersons":2,"price":1450000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/paris-deli-hotel-dja-nang/Superior/ldxow8f