; Spa Phú Quốc là khu nghỉ dưỡng đạt tiêu chuẩn 4* được thiết kế theo phong cách sang trọng cùng đầy đủ các tiện nghi. Giữa vẻ đẹp thiên nhiên của rừng và biển, resort mang đến một cảm giác thật sự bình yên, thư giãn, chọn khách sạn là điểm dừng chân khi đến với đảo Ngọc chắc chắn sẽ là một trải nghiệm du lịch tuyệt vời cho quý khách."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/camia-resort-and-spa-phu-quoc/blog/ed2e7josdhn3bdqk.webp","caption":""}],"rooms":[{"id":"66f968cd0b818e5ee74c4876","title":"Villa Beachfront","size":65,"maxPersons":2,"price":2950000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/camia-resort-and-spa-phu-quoc/Villa Beachfront/iz66uw59g4sw0cz0.webp","tour/camia-resort-and-spa-phu-quoc/Villa Beachfront/99twkvt0jn6r7os9.webp","tour/camia-resort-and-spa-phu-quoc/Villa Beachfront/bi8gac35kzo687jt.webp"]},{"id":"66f968cd0b818e5ee74c487a","title":"Villa 2 Bedrooms, 01 Living room with Balcony (4 khách)","size":120,"maxPersons":4,"price":4500000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":[]},{"id":"66f968cd0b818e5ee74c4872","title":"Villa Garden View","size":65,"maxPersons":2,"price":2150000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/camia-resort-and-spa-phu-quoc/Villa Garden View/stlo05s7m2k35xss.webp","tour/camia-resort-and-spa-phu-quoc/Villa Garden View/tdr1lcahhndbstlk.webp","tour/camia-resort-and-spa-phu-quoc/Villa Garden View/ud1dfmslcii3hw4z.webp","tour/camia-resort-and-spa-phu-quoc/Villa Garden View/rd5pbwy04u0obnjs.webp","tour/camia-resort-and-spa-phu-quoc/Villa Garden View/pj6bmonw0k01tq3z.webp"]},{"id":"66f968cd0b818e5ee74c4874","title":"Villa Sea View","size":65,"maxPersons":2,"price":2550000,"salePrice":0,"f