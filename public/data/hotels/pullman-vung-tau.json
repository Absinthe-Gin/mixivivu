ebp","tour/pullman-vung-tau/images/0s2icx6gb40li5jm.webp","tour/pullman-vung-tau/images/womyrlmubenb3lta.webp","tour/pullman-vung-tau/images/hrx9nbj1ef220q3q.webp","tour/pullman-vung-tau/images/yszgwndm323ccqso.webp","tour/pullman-vung-tau/images/97d4qvnklhh8xrr5.webp","tour/pullman-vung-tau/images/wmo3l3vjwixny0re.webp","tour/pullman-vung-tau/images/dci0fz6a9dzjxidp.webp","tour/pullman-vung-tau/images/5dicm5x8eksybwgj.webp","tour/pullman-vung-tau/images/fmpuwbwjtvr8ivrz.webp","tour/pullman-vung-tau/images/m8xx077ovs6bgisn.webp","tour/pullman-vung-tau/images/aet0y9feyi3u5n1t.webp","tour/pullman-vung-tau/images/w1xt5j8n5aabfdcq.webp","tour/pullman-vung-tau/images/tnj9zcrefm3bkj1j.webp","tour/pullman-vung-tau/images/b69vb0sivldhdf3a.webp","tour/pullman-vung-tau/images/dc83afli2wbfdkay.webp","tour/pullman-vung-tau/images/okccjt8mthpvt3jy.webp","tour/pullman-vung-tau/images/yc5uhdkd8xpsb9pu.webp","tour/pullman-vung-tau/images/mr0n1hqo524bzxry.webp","tour/pullman-vung-tau/images/z5pa1ks9ch1lfocx.webp","tour/pullman-vung-tau/images/q3a4bq0llrhzap3d.webp","tour/pullman-vung-tau/images/mi0t40tlk3rl73qd.webp"],"highlights":["Khách sạn cao cấp với nhiều sự lựa chọn về các hạng phòng, cùng tầm nhìn ấn tượng hướng biển hoặc thành phố.","Tại Pullman Vũng Tàu, có đa dạng sự lựa chọn về địa điểm tổ chức tiệc bao gồm tòa hội nghị rộng lớn, khu sân vườn với đài phun nước thoáng đãng, hồ bơi tầng cao và các phòng tiệc hiện đại","Phòng lưu trú rộng rãi, thân thiện với gia đình và những tiện ích trong khuôn viên của Pullman Vũng Tàu sẽ là một lựa chọn hoàn hảo cho kỳ nghỉ tiếp theo của bạn và những người thân yêu.","Cơ sở vật chất hiện đại, không gian tổ chức linh hoạt và đội ngũ sự kiện chuyên nghiệp, Pullman Vũng Tàu là sự lựa chọn hoàn hảo để tổ chức các buổi hội họp doanh nghiệp."],"content":[{"type":"paragraph","text":"Giờ đây du khách đã có một điểm đến ngay bờ biển phía nam của Việt Nam. Tiền sảnh ngập tràn ánh sáng, pha trộn giữa phong cách đương đại và bản sắc châu Á chào đón du khách đến với Pullman Vũng Tàu. Công trình kiến trúc mang đậm nét riêng biệt bao gồm 356 phòng nghỉ và phòng suite với tầm nhìn hướng ra biển và thành phố. Thiên đường nghỉ dưỡng nhiệt đới – chỉ cách thành phố Hồ Chí Minh hai giờ lái xe và vài phút đi bộ đến Bãi Sau."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/pullman-vung-tau/blog/piswwn0d1vdqi9n4.webp","caption":""},{"type":"paragraph","text":"Pullman Vũng Tàu mang đến một trải nghiệm khách sạn đẳng cấp, ấn tượng và hoàn hảo trong xu hướng chung của toàn cầu. Cung cách phục vụ nhanh chóng, hiệu quả, nồng hậu và không gian sang trọng, hiện đại thu hút cả tinh thần, cơ thể và tâm hồn của du khách. Pullman Vũng Tàu là sự pha trộn giữa công việc và giải trí, phong cách và văn hóa cùng hiệu quả và sự hài lòng."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/pullman-vung-tau/blog/o3sksqq5gp5yf1sg.webp","caption":""},{"type":"paragraph","text":"Khu hội nghị với mái vòm vàng nổi bật phía bên phải khách sạn có hai đại sảnh phù hợp với tiệc cưới, đại tiệc và sự kiện. Du khách có thể kết nối Wi-Fi tốc độ cao miễn phí trong toàn khách sạn. Tiện nghi hiện đại, không gian thoáng đãng và các nhà quản lý sự kiện chuyên nghiệp sẽ giúp du khách có thể tập trung vào công việc của mình. Fit Lounge và bể bơi ngoài trời tiếp thêm năng lượng cho du khách vào thời gian nghỉ ngơi."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/hotel/pullman-vung-tau/blog/y3x8ujrn0ckm9282.webp","caption":""}],"rooms":[{"id":"672b1c227140e5956a68bcf0","title":"Superior City view","size":40,"maxPersons":2,"price":2200000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/pullman-vung-tau/Superior City view/lq9r9mc7r27iuo4y.webp","tour/pullman-vung-tau/Superior City view/i1ypz8sv0376e5wc.webp","tour/pullman-vung-tau/Superior City view/kdb7du4ggkr5ddqb.webp","tour/pullman-vung-tau/Superior City view/5w9s84g9g6f3k9rr.webp","tour/pullman-vung-tau/Superior City view/wl13z1nlvq968ms9.webp"]},{"id":"672b1c227140e5956a68bcf2","title":"Deluxe Sea view","size":40,"maxPersons":2,"price":2700000,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/pullman-vung-tau/Deluxe Sea view /crldd3r9guty2xet.webp","tour/pullman-vung-tau/Deluxe Sea view /crok5sa0z238azdw.webp","tour/pullman-vung-tau/Deluxe Sea view /uoxrm1y5cgcga4d6.webp","tour/pullman-vung-tau/Deluxe Sea view /hhjm4ljo4j0cqp7i.webp","tour/pullman-vung-tau/Deluxe Sea view /0fq2t620aj3ni0cc.webp"]},{"id":"672b1c227140e5956a68bcf4","title":"Executive","size":40,"maxPersons":2,"price":40,"salePrice":0,"features":["Điều hòa","Bồn tắm/Cabin tắm đứng","Máy sấy tóc","Minibar","Tivi","Bàn làm việc","Nước đóng chai miễn phí"],"images":["tour/pullman-vung-tau/Executive/iozfgi1s0bscextc.webp","tour/pullman-vung-tau/Executive/gnmrhrbxhci46g9d.webp","tour/pullman-vung-tau/Executive/uczimmdvaujxlyy5.webp","tour/pullman-vung-tau/Executive/87wqgacvqzof2x6k.webp"]}],"reviews":[]}