ges/ouuufex3dcth4oka.webp","tour/du-thuyen-amanda-pearl/images/c5q3xx7u76bjkypt.webp","tour/du-thuyen-amanda-pearl/images/lqkv5n6x08f859jh.webp","tour/du-thuyen-amanda-pearl/images/4sia9ai44uzyjkcy.webp","tour/du-thuyen-amanda-pearl/images/knwmkvtq72zx6usd.webp","tour/du-thuyen-amanda-pearl/images/x44wzs45sxg4zoth.webp","tour/du-thuyen-amanda-pearl/images/c0oao1d43ew338cx.webp","tour/du-thuyen-amanda-pearl/images/1s00zaur4jgsemtj.webp","tour/du-thuyen-amanda-pearl/images/eokf6lkukinwy6ux.webp","tour/du-thuyen-amanda-pearl/images/rn3n7dwzg9y08nl7.webp","tour/du-thuyen-amanda-pearl/images/4ltfcajypa8ibu96.webp","tour/du-thuyen-amanda-pearl/images/4w8b13ht9e99dulp.webp","tour/du-thuyen-amanda-pearl/images/kjh5d8cryoxnd03h.webp","tour/du-thuyen-amanda-pearl/images/w9y0yq1xkscoa2wz.webp","tour/du-thuyen-amanda-pearl/images/kyfnth46fumz2uo0.webp","tour/du-thuyen-amanda-pearl/images/6geyepoonlyjzvde.webp","tour/du-thuyen-amanda-pearl/images/azoo3gpxjc5kg7ez.webp","tour/du-thuyen-amanda-pearl/images/90rjp6o4q7jlx196.webp"],"highlights":["21 cabin sang trọng, không gian riêng tư và đẳng cấp.","Tất cả phòng đều có ban công hoặc cửa sổ hướng vịnh.","Thiết kế hiện đại kết hợp nét đẹp văn hóa Việt Nam.","Trải nghiệm kayak, hang động, tiệc hoàng hôn và câu mực đêm.","Ẩm thực đa dạng cùng dịch vụ chuyên nghiệp, tận tâm."],"content":[{"type":"paragraph","text":"Amanda Pearl Cruise là một trong những du thuyền nghỉ dưỡng cao cấp mang đến hành trình khám phá vẻ đẹp kỳ quan thiên nhiên thế giới Vịnh Hạ Long và Vịnh Lan Hạ. Với thiết kế sang trọng, tinh tế cùng quy mô vừa phải chỉ 21 cabin, du thuyền tạo nên không gian riêng tư, ấm cúng, phù hợp cho các cặp đôi, gia đình và nhóm bạn muốn tận hưởng kỳ nghỉ trọn vẹn giữa biển trời di sản."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-amanda-pearl/blog/g3wk96qcalulfe3y.webp","caption":""},{"type":"paragraph","text":"Trên hành trình, du khách sẽ được trải nghiệm nhiều hoạt động hấp dẫn như chèo kayak, tham quan hang động, ngắm hoàng hôn trên boong tàu, câu mực đêm hay tham gia lớp học nấu ăn thú vị. Các cabin đều được trang bị đầy đủ tiện nghi hiện đại, nhiều hạng phòng sở hữu ban công riêng và tầm nhìn hướng vịnh tuyệt đẹp, mang đến những phút giây thư giãn đáng nhớ."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-amanda-pearl/blog/07fzyzul1re4492w.webp","caption":""},{"type":"paragraph","text":"Không chỉ nổi bật bởi dịch vụ chuyên nghiệp và ẩm thực đặc sắc, Amanda Pearl Cruise còn là lựa chọn lý tưởng để tận hưởng vẻ đẹp thanh bình của Hạ Long theo cách sang trọng và gần gũi nhất. Đây chắc chắn sẽ là điểm dừng chân hoàn hảo cho hành trình khám phá di sản và lưu giữ những khoảnh khắc đáng nhớ bên người thân, bạn bè."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-amanda-pearl/blog/shtdn7f5dgv0bkmd.webp","caption":""}],"rooms":[{"id":"6a34c188ec8f8b06a32ba270","title":"Junior","size":28,"maxPersons":2,"price":2500000,"salePrice":0,"features":["64fc175735b33132034fa427","64fc178335b33132034fa42a","64fc17d535b33132034fa439","64fc176f35b33132034fa428","64fc178b35b33132034fa42c","64fc17d835b33132034fa43a","64fc179435b33132034fa42e"],"images":["tour/du-thuyen-amanda-pearl/Junior/3btt49se0ftmndfz.webp","tour/du-thuyen-amanda-pearl/Junior/6itriftjx06r8hz6.webp","tour/du-thuyen-amanda-pearl/Junior/5h0255drptpklpac.webp"]},{"id":"6a34c188ec8f8b06a32ba272","title":"Junior Premium","size":28,"maxPersons":2,"price":2600000,"salePrice":0,"features":["64fc175735b33132034fa427","64fc178335b33132034fa42a","64fc17d535b33132034fa439","64fc176f35b33132034fa428","64fc178b35b33132034fa42c","64fc179435b33132034fa42e","64fc17d835b33132034fa43a"],"images":["tour/du-thuyen-amanda-pearl/Junior Premium/nj23nrn6rrt8ibri.webp","tour/du-thuyen-amanda-pearl/Junior Premium/zd5c70a8luns2xkw.webp","tour/du-thuyen-amanda-pearl/Junior Premium/xhludgp2au5kjat2.webp","tour/du-thuyen-amanda-pearl/Junior Premium/e9iydf95ze1cn0qa.webp","tour/du-thuyen-aman