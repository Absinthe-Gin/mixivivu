ges/znns25j04mihdbbh.webp","tour/du-thuyen-dora/images/o0ifstkgtwxtwhza.webp","tour/du-thuyen-dora/images/8uhw9fkarx8aqor0.webp","tour/du-thuyen-dora/images/mj2gbagqf8ola0w8.webp","tour/du-thuyen-dora/images/6l07r8nsn6twkfmh.webp","tour/du-thuyen-dora/images/3dpk1bop74ygl2ns.webp","tour/du-thuyen-dora/images/5wlakhcqy21dwi6p.webp","tour/du-thuyen-dora/images/6gfvtsmru5q2kwq9.webp","tour/du-thuyen-dora/images/he09imd7xxkm373y.webp","tour/du-thuyen-dora/images/taq5as5gocxvpyr7.webp","tour/du-thuyen-dora/images/afvq5l5n1oxkc9f9.webp","tour/du-thuyen-dora/images/ga5zrtoe4vkdvdc1.webp","tour/du-thuyen-dora/images/uk3tenxp53iajphi.webp","tour/du-thuyen-dora/images/1s9l1d6jz5rsms5g.webp","tour/du-thuyen-dora/images/wjeb3p3jvv88tt8f.webp","tour/du-thuyen-dora/images/zel09rnt0y1lijgc.webp","tour/du-thuyen-dora/images/jdbspt1l4tq42fbi.webp","tour/du-thuyen-dora/images/1kj01o3nlgan3331.webp","tour/du-thuyen-dora/images/84cnysiz4kl7ddqg.webp","tour/du-thuyen-dora/images/7qbcvtup9vv0i9rj.webp","tour/du-thuyen-dora/images/6y9kv04kgdcvnpwi.webp","tour/du-thuyen-dora/images/5xqdcwhbbk2pa69b.webp","tour/du-thuyen-dora/images/muhwjiswj180ipmw.webp","tour/du-thuyen-dora/images/wh5vmvs1pnozzj0b.webp","tour/du-thuyen-dora/images/cyy1ifoxj7fn4tua.webp","tour/du-thuyen-dora/images/ygdg884krqdjcgtu.webp","tour/du-thuyen-dora/images/4fquxhydrltvr013.webp","tour/du-thuyen-dora/images/zgdkkswempg59w6r.webp","tour/du-thuyen-dora/images/lh9j9lg60n7qsci0.webp","tour/du-thuyen-dora/images/4uvbcq4xi9odf4m2.webp","tour/du-thuyen-dora/images/ajpppsgsdb07usxf.webp","tour/du-thuyen-dora/images/7sipyop6o4fqp3zb.webp","tour/du-thuyen-dora/images/hjjfh71aythm9ktd.webp","tour/du-thuyen-dora/images/2b9t41zrnkdfwzod.webp"],"highlights":["Du thuyền Dora cung cấp chỗ ở với các phòng rộng rãi được thiết kế hiện đại. Mỗi phòng đều có ban công riêng hoặc sân thượng thoáng thích hợp để uống trà và ngắm cảnh.","Trên tàu có đầy đủ tiện nghi đáp ứng cả nhu cầu thư giãn và hoạt động với trung tâm chăm sóc sức khỏe và phòng tập gym.","Các hoạt động khác nhau trong và ngoài tàu: lớp học nấu ăn, lớp tập Tai-Chi, chèo thuyền kayak, bơi lội, đi xe đạp, thám hiểm hang động, vv","Du thuyền có phòng cho gia đình hoặc nhóm đem lại đa dạng lựa chọn phòng nghỉ cho du khách"],"content":[{"type":"header","level":6,"text":"Giới thiệu về du thuyền"},{"type":"paragraph","text":"Du thuyền Dora đưa du khách tham quan vịnh Lan Hạ với lịch trình truyền thống cùng những điểm đến tuyệt đẹp như hang Sáng Tối, đảo Ba Trái Đào. Du khách có cơ hội khám phá viên ngọc quý này bằng thuyền kayak hay thuyền nan, bơi lội hoặc đơn giản là đi bộ quanh đảo.<br>Du thuyền Dora còn được trang bị các dịch vụ như spa với thảo dược trị liệu, phòng tập thể hình và nhà hàng &amp; quầy bar với thực đơn đa dạng. Bên cạnh các món ăn truyền thống Việt Nam và hải sản địa phương, nhà hàng còn phục vụ các món chay cho thực khách có nhu cầu."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-dora/blog/yspsqz461o1wsxbk.webp","caption":"Bể bơi ngoài trời với"},{"type":"paragraph","text":"Đúng như tên gọi của nó, Du thuyền Dora là nơi cổ điển đáp ứng sự hiện đại trong bầu không khí lãng mạn. Với những tiện nghi tốt nhất cùng với dịch vụ cao cấp từ đội ngũ nhân viên tận tâm, ẩm thực đa dạng và phong phú có thể mang đến nhiều lựa chọn cho thực khách và những địa điểm mang tính biểu tượng ở Vịnh Lan Hà với vẻ đẹp mê hoặc, du thuyền Dora hứa hẹn sẽ mang đến cho bạn những kỷ niệm khó quên.<br>"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-dora/blog/q186anvwn771sv5z.webp","caption":"Du thuyền Dora"}],"rooms":[{"id":"65154e8a9d890355aaa6fda9","title":"Phòng Junior Suite","size":28,"maxPersons":2,"price":3550000,"salePrice":0,"features":["64fc175735b33132034fa427","64fc17d535b33132034fa439","64fc179435b33132034fa42e","64fc176f35b33132034fa428","64fc178b35b33132034fa42c"],"images":["tour/du-thuyen-dora/Phòng Junior Suite/lw60e7qfdd3isbtr.webp","tour/du-thuyen-dora/Phòng Junior Suite/ce