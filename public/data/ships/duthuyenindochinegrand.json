/images/kc22eqwmlmde598o.webp","tour/duthuyenindochinegrand/images/yuk886xq3i2fxwih.webp","tour/duthuyenindochinegrand/images/vetysq7ci7bxrfa7.webp","tour/duthuyenindochinegrand/images/o4rdeefyh9eu9m1t.webp","tour/duthuyenindochinegrand/images/8spdzikxtozjaksk.webp","tour/duthuyenindochinegrand/images/kp6h9y43iqwwm6q0.webp","tour/duthuyenindochinegrand/images/n58as562c8kp14he.webp","tour/duthuyenindochinegrand/images/r3c9qu6v7txdxdmw.webp","tour/duthuyenindochinegrand/images/0ocl29bk8mcso0dq.webp","tour/duthuyenindochinegrand/images/wbmbte9lsvcx2ygf.webp","tour/duthuyenindochinegrand/images/2u32jqbtrz9q7da5.webp","tour/duthuyenindochinegrand/images/mns2ujja3zwyrnr8.webp","tour/duthuyenindochinegrand/images/fgp70zr1ppqdyk3i.webp","tour/duthuyenindochinegrand/images/z7fqse9lruu4sggz.webp","tour/duthuyenindochinegrand/images/6kj6j556r0t2is4p.webp","tour/duthuyenindochinegrand/images/1nrf6iemfoh25amq.webp","tour/duthuyenindochinegrand/images/elzigmsctniibxvp.webp","tour/duthuyenindochinegrand/images/j1sctblpiv31u5wo.webp","tour/duthuyenindochinegrand/images/5cv3vzhp7ffdlg0w.webp","tour/duthuyenindochinegrand/images/uox5xhkcpzi3uvum.webp","tour/duthuyenindochinegrand/images/jphpjlt7twpi7axw.webp","tour/duthuyenindochinegrand/images/s22bpqw7v6pkzlv8.webp","tour/duthuyenindochinegrand/images/f7vagiby96jg7ho2.webp","tour/duthuyenindochinegrand/images/e9haw050e35xnspp.webp","tour/duthuyenindochinegrand/images/uekcaifs6oumnarg.webp","tour/duthuyenindochinegrand/images/9ttmn6wdv9i9a60k.webp","tour/duthuyenindochinegrand/images/sj8imxand1ke68yc.webp","tour/duthuyenindochinegrand/images/p73jv7no6xcw5msa.webp","tour/duthuyenindochinegrand/images/aas3mpcfi59bjsqc.webp","tour/duthuyenindochinegrand/images/a5gj4klw26thmnab.webp"],"highlights":["Indochine Grand – Du thuyền ngủ đêm cao cấp giữa vịnh Hạ Long - Lan Hạ, kiệt tác mới nhất từ chuỗi Indochine","Nơi tinh hoa thủ công truyền thống gặp gỡ dịch vụ đỉnh cao, mang đến trải nghiệm nghỉ dưỡng xa hoa, ẩm thực tinh tế và hành trình riêng biệt.","Thưởng thức tinh hoa ẩm thực thượng hạng giữa khung cảnh tráng lệ của Vịnh Lan Hạ – Hạ Long, nơi tuyệt tác thiên nhiên hiện ra đầy mê hoặc.","Tận hưởng khoảnh khắc sang trọng, chinh phục từng cú swing giữa thiên nhiên tuyệt mỹ, sự giao thoa tinh tế giữa đẳng cấp thượng lưu và vẻ đẹp ngoạn mục của vịnh biển."],"content":[{"type":"paragraph","text":"Du thuyền Indochine Grand là sự kết hợp hoàn hảo giữa thủ công tinh xảo và thiết kế sang trọng, với từng chi tiết phản ánh sự hòa hợp giữa không gian và cảnh quan xung quanh. Mỗi đường nét, mỗi góc nhìn đều khơi gợi cảm giác bình yên và sự gắn kết bền vững."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/duthuyenindochinegrand/blog/2rhlemnsgthnkq3p.webp","caption":""},{"type":"paragraph","text":"Khi Nghệ Thuật Chạm Đến Từng Không GianMột kỳ nghỉ trên du thuyền Indochine Grand không chỉ là trải nghiệm du ngoạn giữa kỳ quan vịnh Hạ Long - vịnh Lan Hạ, mà còn là hành trình khám phá những giá trị nghệ thuật tinh hoa. Sự kết tinh của tay nghề thủ công bậc thầy, tôn vinh vẻ đẹp Việt Nam qua lăng kính sang trọng."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/duthuyenindochinegrand/blog/eejbnz4ambr2faph.webp","caption":""},{"type":"paragraph","text":"Mang trong mình phong cách Indochine tao nhã, được chế tác kỳ công từ bàn tay nghệ nhân, du thuyền là sự giao thoa hoàn hảo giữa tinh hoa văn hóa và sự tinh tế hiện đại. Mỗi hành trình không chỉ là chuyến đi, mà còn là một bức họa sống động của đẳng cấp và trải nghiệm độc đáo, dẫn lối quý khách đầy thi vị."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/duthuyenindochinegrand/blog/3q6241th75uv25vd.webp","caption":""},{"type":"paragraph","text":"Thưởng thức tinh hoa ẩm thực thượng hạng giữa khung cảnh tráng lệ của Vịnh Lan Hạ – Hạ Long, nơi tuyệt tác thiên nhiên hiện ra đầy mê hoặc.&nbsp;"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/duthuyenindochinegrand/blog/94z0a5eqz872wjke.webp","caption":""}]