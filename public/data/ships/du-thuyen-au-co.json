ages/dug00e4s13qmabsm.webp","tour/du-thuyen-au-co/images/py8skn0vcl0zrgh1.webp","tour/du-thuyen-au-co/images/qskf5ab6rhndixq7.webp","tour/du-thuyen-au-co/images/dfoxy124tm9ftrg0.webp","tour/du-thuyen-au-co/images/c0azq4x9ljznviam.webp","tour/du-thuyen-au-co/images/kekp012y9zll8bev.webp","tour/du-thuyen-au-co/images/9pdgk4sxpms5d49l.webp","tour/du-thuyen-au-co/images/qbyk48yo5vg54w15.webp","tour/du-thuyen-au-co/images/wrrsw6gphve2s6bc.webp","tour/du-thuyen-au-co/images/nnildu0ftm9zfksp.webp","tour/du-thuyen-au-co/images/k1m834rzo6qb61dd.webp","tour/du-thuyen-au-co/images/48x4hnb3xwctmksl.webp","tour/du-thuyen-au-co/images/rq2mq1ndy47z9mkq.webp","tour/du-thuyen-au-co/images/qqqg1iap311oc4w8.webp","tour/du-thuyen-au-co/images/2vogfqtfc3eymtu3.webp","tour/du-thuyen-au-co/images/9ab5s4gidecjozbk.webp","tour/du-thuyen-au-co/images/6j9f3vzahzxtsdd8.webp","tour/du-thuyen-au-co/images/wlt7gm1h486ovkdh.webp","tour/du-thuyen-au-co/images/o7gojbblek4qr9mh.webp","tour/du-thuyen-au-co/images/m4e2smqheksqj5oq.webp","tour/du-thuyen-au-co/images/37oj0ccagn2kbxby.webp"],"highlights":["Du thuyền Âu Cơ có thiết kế đương đại với số lượng cabin lớn trang bị nội thất tinh tế, hiện đại","Nhà hàng của du thuyền phục vụ thực đơn theo phong cách Á-Âu với nhiều món ăn ngon và hấp dẫn","Hải trình đặc biệt 3 ngày 2 đêm có thể tham quan cả Vịnh Hạ Long và Vịnh Lan Hạ","Nhiều hoạt động hấp dẫn như: giờ vui vẻ, tham quan đảo Cát  Bà, tham quan làng chài chèo kayak, bơi lội."],"content":[{"type":"paragraph","text":"Du thuyền Âu Cơ là một thương hiệu thuộc Công ty du thuyền Bhaya nổi tiếng trên vịnh Hạ Long. Du thuyền được thiết kế theo phong cách đương đại gồm 32 cabin với vỏ ngoài là thép và sơn trắng nhẹ nhàng, tinh tế. Các phòng của du thuyền đều bao gồm nội thất trang nhã, tinh tế và đẹp mắt. Trong đó có 2 hạng phòng đặc biệt là Long Quân Suite và Âu Cơ Suite được trang bị thêm bồn tắm và sân hiên riêng."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-au-co/blog/16j6icmncrf9kw6c.webp","caption":""},{"type":"paragraph","text":"Du khách sẽ được phục vụ các bữa chính tại nhà hàng của du thuyền với thực đơn theo phong cách Á-Âu ngon miệng. Nhiều món ăn hấp dẫn sẽ được các đầu bếp giàu kinh nghiệm chế biến và sẵn sàng phục vụ thực khách...."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-au-co/blog/pscw3lf6go2h5lmc.webp","caption":""},{"type":"paragraph","text":"Bên cạnh đó, lịch trình đặc biệt của du thuyền cũng sẽ là một lựa chọn thú vị dành cho du khách. Những điểm tham quan như: hồ Ba Hầm, làng chài Việt Hải, đảo Ba Trái Đào...sẽ rất hiếm có du thuyền nào thực hiện.&nbsp;"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-au-co/blog/didw4uo37rasijnx.webp","caption":""}],"rooms":[{"id":"65fbf1d446d040cfa8325067","title":"Phòng Deluxe có ban công riêng","size":20,"maxPersons":2,"price":3550000,"salePrice":0,"features":["64fc175735b33132034fa427","64fc17d535b33132034fa439","64fc176f35b33132034fa428","64fc178b35b33132034fa42c","64fc179435b33132034fa42e","64fc17d835b33132034fa43a"],"images":["tour/du-thuyen-au-co/Phòng Deluxe có ban công riêng/h06dt1uui7wpc6rc.webp","tour/du-thuyen-au-co/Phòng Deluxe có ban công riêng/jn8wiim0lifwm28o.webp","tour/du-thuyen-au-co/Phòng Deluxe có ban công riêng/olkz1b3ql0ifr5cz.webp","tour/du-thuyen-au-co/Phòng Deluxe có ban công riêng/oke69204j8nai8js.webp","tour/du-thuyen-au-co/Phòng Deluxe có ban công riêng/j0cjxibfnptq3r0k.webp","tour/du-thuyen-au-co/Phòng Deluxe có ban công riêng/k7xijv6dvs6slyo0.webp","tour/du-thuyen-au-co/Phòng Deluxe có ban công riêng/2o0iktefxbvp6u8o.webp","tour/du-thuyen-au-co/Phòng Deluxe có ban công riêng/jpprxjmw3ff7fgsl.webp","tour/du-thuyen-au-co/Phòng Deluxe có ban công riêng/5agtg1s6ckc31dsc.webp"]},{"id":"65fbf1d446d040cfa8325069","title":"Phòng Grand Deluxe","size":25,"maxPersons":2,"price":3550000,"salePrice":0,"features":["64fc175735b33132034fa427","64fc176f35b33132034fa428","64fc178b35b33132034fa42c","64fc179435b