y.webp","tour/duthuyen-calistahalong/images/rp9a46irujmcnaoo.webp","tour/duthuyen-calistahalong/images/67o30rowjkxajx27.webp","tour/duthuyen-calistahalong/images/jb9g7qps2nra62p2.webp","tour/duthuyen-calistahalong/images/j1fdwbm3hpjxrqaz.webp","tour/duthuyen-calistahalong/images/xsp4dp30vlc54xqv.webp","tour/duthuyen-calistahalong/images/i0cxqzzv1fn7u215.webp","tour/duthuyen-calistahalong/images/lfpa14xs3iobq3ql.webp","tour/duthuyen-calistahalong/images/ntu4k438py2kpoa8.webp","tour/duthuyen-calistahalong/images/j67cwernylh4j1y9.webp","tour/duthuyen-calistahalong/images/dc22l8chadfhdhkz.webp","tour/duthuyen-calistahalong/images/3ii6rx5s5c4zom4y.webp","tour/duthuyen-calistahalong/images/7jukur3c02xgw3xn.webp","tour/duthuyen-calistahalong/images/015n5miovkvucjs7.webp","tour/duthuyen-calistahalong/images/wmevbmoxgzlucbex.webp","tour/duthuyen-calistahalong/images/o81po3ulr3wpie9x.webp","tour/duthuyen-calistahalong/images/ucge86y1g6yc6016.webp","tour/duthuyen-calistahalong/images/5cdw8z6cksif8rzw.webp","tour/duthuyen-calistahalong/images/4spo9lnq9yj284aa.webp","tour/duthuyen-calistahalong/images/dse920evy6dg5ot3.webp","tour/duthuyen-calistahalong/images/wlnlyhmgln1vlqu2.webp","tour/duthuyen-calistahalong/images/25ctu0hn9ltotven.webp"],"highlights":["Lấy cảm hứng từ thần thoại Hy Lạp, Calista mang đến không gian nghỉ dưỡng đẳng cấp 6 sao, nơi mọi chi tiết đều được chăm chút để tôn vinh vẻ đẹp di sản thiên nhiên.","Với thiết kế đẳng cấp cùng dịch vụ chuẩn 6 sao, du thuyền Calista hứa hẹn mang đến hành trình thượng lưu giữa kỳ quan thiên nhiên hùng vĩ.","Dịch vụ spa cao cấp của Calista được thiết kế để mang đến sự thư giãn tuyệt đối, giúp bạn xua tan mọi căng thẳng và tìm lại sự cân bằng.","Calista Cruise hội tụ tinh hoa của sự sang trọng và đẳng cấp, nâng tầm trải nghiệm cho mọi du khách.","Bể bơi Oceanus trên du thuyền Calista không chỉ là nơi thư giãn mà còn là điểm nhấn sang trọng giữa di sản Vịnh Hạ Long"],"content":[{"type":"paragraph","text":"Giữa lòng di sản thiên nhiên vịnh Hạ Long, Calista Cruise xuất hiện như một biểu tượng của vẻ đẹp tinh tế và thanh lịch. Tên gọi Calista lấy cảm hứng từ một nhân vật trong thần thoại Hy Lạp – một nữ thần có sắc đẹp rạng ngời như ánh sao trời. Từ đó, Calista mang ý nghĩa \"đẹp nhất,\" cũng như một lời ngợi ca dành cho vịnh Hạ Long – một trong những kỳ quan thiên nhiên đẹp nhất thế giới"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/duthuyen-calistahalong/blog/qswls7xrpnsrxjud.webp","caption":""},{"type":"paragraph","text":"Tên gọi Calista không chỉ gợi lên vẻ đẹp rạng ngời, mà còn mang trong mình tinh thần kết nối giữa con người và thiên nhiên. Vẻ đẹp ấy, như ánh sao soi sáng mặt biển, đã hòa quyện vào từng làn nước xanh, từng ngọn gió mát lành, và những hòn đảo kỳ vĩ của vịnh Hạ Long. Calista Cruise không chỉ là hành trình khám phá, mà còn là sự tiếp nối của tình yêu, sự trân trọng và sứ mệnh gìn giữ vẻ đẹp di sản cho thế hệ mai sau."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/duthuyen-calistahalong/blog/w1c9b5ylji63aqay.webp","caption":""},{"type":"paragraph","text":"Nhà hàng Bayview Dining trên du thuyền Calista không chỉ là nơi trải nghiệm ẩm thực đẳng cấp mà còn là không gian lý tưởng để khám phá văn hóa và tận hưởng vẻ đẹp thiên nhiên."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/duthuyen-calistahalong/blog/t1w4y71xcm21area.webp","caption":""},{"type":"paragraph","text":" Trong không gian sang trọng với sân khấu trình diễn nghệ thuật, thực khách sẽ được đắm mình trong hương vị tinh tế từ thực đơn đặc sắc, hòa quyện cùng khung cảnh vịnh Hạ Long đẹp như tranh vẽ.&nbsp;"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/duthuyen-calistahalong/blog/hcam1qkr7v5x5mch.webp","caption":""}],"rooms":[{"id":"67c95f18fb943a0d053d0b1d","title":"Phòng Calista Ocean","size":30,"maxPersons":2,"price":3950000,"salePrice":0,"features":["64fc175735b33132034fa427","64fc17d535b33132034fa439","64fc17d835b33132034fa43a","64fc179435b3