phẩm tươi ngon, hấp dẫn sẽ đem đến cho du khách những bữa ăn đầy dủ dinh dưỡng và ngon miệng. Bên cạnh thực đơn theo lịch trình, du khách cũng có thể gọi món tại nhà hàng của du thuyền.&nbsp;"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-paradise-sails/blog/lexvia51el7pzfyn.webp","caption":"Thực đơn ngon miệng"},{"type":"paragraph","text":"Với lịch trình tham quan đặc sắc: khám phá hang Sửng Sốt kỳ vỹ nhất vịnh Hạ Long, bơi lội leo núi tại đảo Ti Tốp, chèo thuyền kayak, tham quan làng chài Cửa Vạn, hang Trống,..."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-paradise-sails/blog/9lfvwm30if2wixx0.webp","caption":"Sundeck của du thuyền"}],"rooms":[{"id":"6513f32d9d890355aaa6df72","title":"Phòng Deluxe Window","size":16,"maxPersons":2,"price":3050000,"salePrice":0,"features":["64fc175735b33132034fa427","64fc17d535b33132034fa439","64fc176f35b33132034fa428","64fc178b35b33132034fa42c","64fc179435b33132034fa42e","64fc17d835b33132034fa43a"],"images":["tour/du-thuyen-paradise-sails/Phòng Deluxe/g2z3l0f30d3hb20g.webp","tour/du-thuyen-paradise-sails/Phòng Deluxe/ozglhzukbt88sf9x.webp","tour/du-thuyen-paradise-sails/Phòng Deluxe/82a6z98ovu9ufvzx.webp"]},{"id":"6513f32d9d890355aaa6df74","title":"Phòng Deluxe Balcony","size":18,"maxPersons":2,"price":3450000,"salePrice":0,"features":["64fc175735b33132034fa427","64fc17d535b33132034fa439","64fc176f35b33132034fa428","64fc178b35b33132034fa42c","64fc179435b33132034fa42e","64fc17d835b33132034fa43a"],"images":["tour/du-thuyen-paradise-sails/Phòng Deluxe có ban công/203y1dwmmfqb2qs3.webp","tour/du-thuyen-paradise-sails/Phòng Deluxe có ban công/458j7z7puedl24g7.webp","tour/du-thuyen-paradise-sails/Phòng Deluxe có ban công/v4dox36wo2fsr0it.webp","tour/du-thuyen-paradise-sails/Phòng Deluxe có ban công/emwfgy4nj89iljme.webp"]},{"id":"6513f32d9d890355aaa6df76","title":"Phòng Terrace Suite","size":19,"maxPersons":2,"price":3850000,"salePrice":0,"features":["64fc17d535b33132034fa439","6