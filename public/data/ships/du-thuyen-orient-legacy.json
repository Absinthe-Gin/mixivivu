bp","tour/du-thuyen-orient-legacy/images/tmq495ubo0m1ng8f.webp","tour/du-thuyen-orient-legacy/images/fcji22qqmx1o04ry.webp","tour/du-thuyen-orient-legacy/images/y7mlhyais9ls48yt.webp","tour/du-thuyen-orient-legacy/images/op8cq7n2bqks3nx5.webp","tour/du-thuyen-orient-legacy/images/lv5dzgzmm4zbuncr.webp","tour/du-thuyen-orient-legacy/images/3u0445jvitusq9qf.webp","tour/du-thuyen-orient-legacy/images/vvr8q98o5ry24n2x.webp","tour/du-thuyen-orient-legacy/images/uf6en0bjdbpiaox9.webp","tour/du-thuyen-orient-legacy/images/dixxwfzglaijz5uf.webp","tour/du-thuyen-orient-legacy/images/5qyq73w54sh3q1of.webp","tour/du-thuyen-orient-legacy/images/85nefub7g0wej3ae.webp","tour/du-thuyen-orient-legacy/images/09ecnaudrdfhggww.webp","tour/du-thuyen-orient-legacy/images/g59o5wdgnfxf8vxk.webp","tour/du-thuyen-orient-legacy/images/lkzrxbirsqaaclaf.webp","tour/du-thuyen-orient-legacy/images/uwzltgnle42v1mni.webp","tour/du-thuyen-orient-legacy/images/br4fgzmjbr9kq999.webp","tour/du-thuyen-orient-legacy/images/z2wagu9urr3oxalo.webp","tour/du-thuyen-orient-legacy/images/odblyco9fqoeknbc.webp","tour/du-thuyen-orient-legacy/images/ff246qw4nlrtuqcc.webp","tour/du-thuyen-orient-legacy/images/u8cjlahiz8divqgx.webp","tour/du-thuyen-orient-legacy/images/be8woozfu6oj7oti.webp","tour/du-thuyen-orient-legacy/images/nww94yfk60vdnp5h.webp","tour/du-thuyen-orient-legacy/images/likmjngfkb9tormu.webp","tour/du-thuyen-orient-legacy/images/l2mzck9lkz2avpog.webp","tour/du-thuyen-orient-legacy/images/zcmeuuafssnegtkd.webp","tour/du-thuyen-orient-legacy/images/qzjdfvx50s9oagwj.webp"],"highlights":["Du thuyền 6 sao Orient Legacy phong cách Indochine sang trọng bậc nhất Vịnh Hạ Long và Vịnh Lan Hạ","Đắm mình trong bể bơi vô cực trên boong tàu và tận hưởng tiệc ngắm hoàng hôn kỳ ảo","Trải nghiệm tự chèo thuyền kayak hoặc ngồi thuyền nan khám phá danh thắng Hang Sáng Tối hoang sơ","Trọn gói 4 bữa ăn ẩm thực fine dining thượng hạng tại nhà hàng sang trọng Pearl of Orient trên tầng 4"],"content":[{"type":"paragraph","text":"Orient Legacy Cruise là một trong những siêu du thuyền 6 sao đẳng cấp và sang trọng bậc nhất tại Vịnh Hạ Long và Vịnh Lan Hạ. Ra mắt vào năm 2025, du thuyền mang đến một không gian nghỉ dưỡng đỉnh cao với sự hòa quyện hoàn hảo giữa nét lãng mạn, cổ điển của kiến trúc Đông Dương (Indochine) và sự tiện nghi, hiện đại của một khách sạn nổi xa hoa. "},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-orient-legacy/blog/7a5iymhsg66vkg9m.webp","caption":""},{"type":"paragraph","text":"Với thiết kế 5 tầng hoành tráng, sở hữu 43 phòng Suite thượng lưu có ban công riêng và bồn tắm hướng vịnh, Orient Legacy mang lại tầm nhìn panorama tuyệt mỹ ra di sản thiên nhiên thế giới. "},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-orient-legacy/blog/fqqedngej2rz9loj.webp","caption":""},{"type":"paragraph","text":"Hành trình cùng du thuyền không chỉ là chuyến thưởng ngoạn cảnh sắc kỳ vĩ của Hang Sáng - Hang Tối hay bãi biển Ba Trái Đào, mà còn là một trải nghiệm sống hoàng gia với bể bơi vô cực ngoài trời, hệ thống spa cao cấp và ẩm thực Fine Dining tinh tế tại nhà hàng Pearl of Orient. "},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-orient-legacy/blog/44kv6f73hs9on8gj.webp","caption":"Spa"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-orient-legacy/blog/l58ldm9hrjrxhjs7.webp","caption":"Pearl of Orient Restaurant"},{"type":"paragraph","text":"Đây chắc chắn là lựa chọn hoàn hảo cho những ai đang tìm kiếm một kỳ nghỉ thượng lưu, riêng tư và giàu cảm xúc giữa lòng kỳ quan."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-orient-legacy/blog/0u6e52tvhncjaifo.webp","caption":""}],"rooms":[{"id":"6acf3f2eec8f8b06a3325967","title":"Halong Deluxe","size":35,"maxPersons":2,"price":3700000,"salePrice":0,"features":["64fc175735b33132034fa427","64fc178335b33132034fa42a","64fc17d535b33132034fa439","64fc176f35b33132034fa428","64fc178b35b33132034fa42c","64fc