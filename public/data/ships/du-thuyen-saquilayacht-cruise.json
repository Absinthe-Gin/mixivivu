uise/images/uupah6zzjy73vooj.webp","tour/du-thuyen-saquilayacht-cruise/images/gsb9i0xg0g999kys.webp","tour/du-thuyen-saquilayacht-cruise/images/7vfix9uryqvj3m3g.webp","tour/du-thuyen-saquilayacht-cruise/images/xuz4e3n7avrd8g7g.webp","tour/du-thuyen-saquilayacht-cruise/images/g2fgi9fu4e4c26bq.webp","tour/du-thuyen-saquilayacht-cruise/images/51pv11y2cr3flf0q.webp","tour/du-thuyen-saquilayacht-cruise/images/d3sprpikl6aiby1h.webp","tour/du-thuyen-saquilayacht-cruise/images/4ifnslscldk7poes.webp","tour/du-thuyen-saquilayacht-cruise/images/xp7x6rbpie2g1xkj.webp","tour/du-thuyen-saquilayacht-cruise/images/fai2ta5nv5buachs.webp","tour/du-thuyen-saquilayacht-cruise/images/6drizgy60xnyulnh.webp","tour/du-thuyen-saquilayacht-cruise/images/fchxzh112jxk0dth.webp","tour/du-thuyen-saquilayacht-cruise/images/9ek0xoff26nonvfw.webp","tour/du-thuyen-saquilayacht-cruise/images/osz3jvj9yae4b1zi.webp","tour/du-thuyen-saquilayacht-cruise/images/rt2exu4j9mxl0t4d.webp","tour/du-thuyen-saquilayacht-cruise/images/g31urtuf1wkofkug.webp","tour/du-thuyen-saquilayacht-cruise/images/dmfjx5usxf7pqwes.webp","tour/du-thuyen-saquilayacht-cruise/images/ph3iy4xwlt7kikpq.webp","tour/du-thuyen-saquilayacht-cruise/images/ki2t0ug6w6aw2t1j.webp","tour/du-thuyen-saquilayacht-cruise/images/mtlhe6ozju5j9w7u.webp","tour/du-thuyen-saquilayacht-cruise/images/mi47s4q3gvdoavm1.webp","tour/du-thuyen-saquilayacht-cruise/images/qqxjpm5yuc2kxesp.webp"],"highlights":["Saquila Yacht được thiết kế độc bản, sang trọng, hướng đến đáp ứng mong muốn của khách hàng, từ cuộc họp quan trọng đến kỳ nghỉ thư giãn.","Du thuyền đưa đến khách hàng các bữa tiệc và chương trình ẩm thực chất lượng cao, đảm bảo một trải nghiệm ẩm thực đặc sắc trên Vịnh di sản.","Đội ngũ của chúng tôi luôn sẵn sàng hỗ trợ mọi yêu cầu, cam kết một chuyến hải trình an toàn, thuận lợi."],"content":[{"type":"paragraph","text":"Được hoà phối giữa kiến trúc hiện đại và yếu tố truyền thống, du thuyền Saquila Yacht là một biểu tượng mới của sự lịch lãm và phong cách.<br>"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-saquilayacht-cruise/blog/xeoi2kjl21tsq6yi.webp","caption":""},{"type":"paragraph","text":"Saquila Yacht không chỉ đơn thuần là một chiếc du thuyền, mà đó còn là một cửa ngõ đưa bạn tới tận hưởng vẻ đẹp thanh tao của Vịnh Hạ Long&nbsp;<br>"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-saquilayacht-cruise/blog/ckkqrkbxidsipmt1.webp","caption":""},{"type":"paragraph","text":"<br>Saquila Yatch Cruise 5* sẽ là điểm dừng chân lý tưởng cho những ai yêu thích sự sang trọng, đẳng cấp và muốn khám phá vẻ đẹp huyền bí của Vịnh Hạ Long!"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-saquilayacht-cruise/blog/2pf9t8rl1qevq7w3.webp","caption":""},{"type":"paragraph","text":"Hành trình sẽ được hướng dẫn bởi những chuyên viên giàu kinh nghiệm, đảm bảo quý khách sẽ có một trải nghiệm du lịch hoàn hảo và đáng nhớ.<br>"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-saquilayacht-cruise/blog/8xcgskkafzpo3yc2.webp","caption":""}],"rooms":[{"id":"664ca61346d040cfa83a970f","title":"Tour 4h","size":1,"maxPersons":120,"price":1400000,"salePrice":0,"features":["64fc176f35b33132034fa428","64fc175735b33132034fa427","64fc179035b33132034fa42d","64fc17d535b33132034fa439"],"images":["tour/du-thuyen-saquilayacht-cruise/Tour 4h/thao5ppo7r7e5sg3.webp","tour/du-thuyen-saquilayacht-cruise/Tour 4h/asco65i70csp84m3.webp","tour/du-thuyen-saquilayacht-cruise/Tour 4h/nwhfith4m9f2x45e.webp","tour/du-thuyen-saquilayacht-cruise/Tour 4h/wg1o4i0qlecrv825.webp"]}],"reviews":[{"id":"66d9c731a4d34761c52b27da","name":"Phạm Hồng Nhung","score":5,"comment":"Du thuyền đẹp, sang trọng, trải nghiệm dịch vụ ok. Thanks Mixi Vivu!!!","date":"2024-09-05"},{"id":"66da7565a4d34761c52b27e4","name":"Tú Linh","score":5,"comment":"Mình đặt tour trải nghiệm 4 tiếng, trải nghiệm rất vui. Đồ ăn ngon và các bạn nhân viên phục vụ chu đáo. Cảm ơn Mixi Vivu!","date":"2024-09-06"}]}