r/du-thuyen-du-yen/images/fuwhx4stv2ecekqn.webp","tour/du-thuyen-du-yen/images/1pfpcmp6v1aw4qmg.webp","tour/du-thuyen-du-yen/images/umsmhv4dgzz570xq.webp","tour/du-thuyen-du-yen/images/axaz6dl5u5hnsl72.webp","tour/du-thuyen-du-yen/images/n5wie45lvx6yyhml.webp","tour/du-thuyen-du-yen/images/aj1lpm3u23ynyrhz.webp","tour/du-thuyen-du-yen/images/r2peu006f9cqx88o.webp","tour/du-thuyen-du-yen/images/336i7ujk233ytz48.webp","tour/du-thuyen-du-yen/images/6vp65e8fyknt7iwe.webp","tour/du-thuyen-du-yen/images/gh985p6afrdiue36.webp","tour/du-thuyen-du-yen/images/wxzx9p9m4ks3n7m3.webp","tour/du-thuyen-du-yen/images/4w0ucewtbgde2hi9.webp","tour/du-thuyen-du-yen/images/q59wfxrgy08oc086.webp","tour/du-thuyen-du-yen/images/hvoshv37e76mbi3k.webp","tour/du-thuyen-du-yen/images/v25s2rev9tkhi69x.webp","tour/du-thuyen-du-yen/images/ccmro36dfdqjjt16.webp"],"highlights":["Thiết kế mang cảm hứng phương Đông thanh lịch, tôn vinh vẻ đẹp tinh giản và sang trọng.","26 cabin hạng sang với ban công riêng, cửa sổ toàn cảnh hướng vịnh.","Ẩm thực tinh tế, kết hợp giữa ẩm thực Việt và Á – Âu đương đại.","Sundeck rộng rãi, khu vực sky bar & pool mini lý tưởng để ngắm hoàng hôn.","Hoạt động phong phú: chèo kayak, thăm hang động, lớp nấu ăn, tiệc tối trên boong."],"content":[{"type":"paragraph","text":"Ra mắt năm 2025,&nbsp;Du thuyền ngủ đêm Du Yên 5 sao&nbsp;mang đến trải nghiệm tinh tế và đậm chất Á Đông giữa khung cảnh kỳ vĩ của&nbsp;Vịnh Hạ Long. "},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-du-yen/blog/yq1byl6xtte1hzrf.webp","caption":""},{"type":"paragraph","text":"Với 26 cabin, điểm nhấn của Du thuyền Du Yên nằm ở thiết kế Tân cổ điển châu Âu kết hợp tinh tế phương Đông – sự giao thoa hài hòa giữa nét thanh lịch châu Âu và cảm hứng Á Đông. Từng chi tiết đều được chế tác tỉ mỉ, mang đến một không gian vừa tinh tế vừa lôi cuốn, vừa tinh tế vừa tràn đầy cảm xúc."},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-du-yen/blog/1qi2mv1fkh7ik2cq.webp","caption":""},{"type":"paragraph","text":"Hành trình của Du thuyền Du Yên mang chủ đề “Hành trình Phương Đông”, đưa du khách qua những vịnh biển thơ mộng, những đảo đá vôi hùng vĩ và những làng chài truyền thống. Không chỉ là một chuyến tham quan, đây còn là một hành trình đắm chìm vào văn hóa, ẩm thực tinh tế, các hoạt động truyền thống và lòng hiếu khách đẳng cấp thế giới ngay tại trung tâm của Di sản Thế giới được UNESCO công nhận"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/du-thuyen-du-yen/blog/f5gt0o83cdgyk239.webp","caption":""}],"rooms":[{"id":"694cbd2cd5f2ec2dc49f282a","title":"Du Junior","size":30,"maxPersons":2,"price":3900000,"salePrice":0,"features":["64fc175735b33132034fa427","64fc17d535b33132034fa439","64fc176f35b33132034fa428","64fc179435b33132034fa42e","64fc17d835b33132034fa43a"],"images":["tour/du-thuyen-du-yen/Du Junior/qfyapogbaqpiod72.webp","tour/du-thuyen-du-yen/Du Junior/w8pd9qbhmmd28oy8.webp","tour/du-thuyen-du-yen/Du Junior/t4un3qzq8phbqsdb.webp","tour/du-thuyen-du-yen/Du Junior/mprk09k0si4uauks.webp","tour/du-thuyen-du-yen/Du Junior/ivcal332z9ob87c9.webp","tour/du-thuyen-du-yen/Du Junior/x119rodyoq18cwwr.webp"]},{"id":"694cbd2cd5f2ec2dc49f282c","title":"Yên Senior","size":30,"maxPersons":2,"price":4200000,"salePrice":0,"features":["64fc175735b33132034fa427","64fc17d535b33132034fa439","64fc176f35b33132034fa428","64fc179435b33132034fa42e","64fc17d835b33132034fa43a"],"images":["tour/du-thuyen-du-yen/Yên Senior/aup4ehk6t3pawvsr.webp","tour/du-thuyen-du-yen/Yên Senior/k4252ekzm76gcdx9.webp","tour/du-thuyen-du-yen/Yên Senior/w0zizc1e102c59pp.webp","tour/du-thuyen-du-yen/Yên Senior/pg35zl88rcepfw0d.webp","tour/du-thuyen-du-yen/Yên Senior/tnhykt2snoegdfz1.webp"]},{"id":"694cbd2cd5f2ec2dc49f282e","title":"Yên Premium","size":30,"maxPersons":2,"price":4000000,"salePrice":0,"features":["64fc175735b33132034fa427","64fc17d535b33132034fa439","64fc176f35b33132034fa428","64fc17d835b33132034fa43a"],"images":["tour/du-thuyen-du-yen/Yên