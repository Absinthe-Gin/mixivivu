/images/54v0iya6wd3mrn2k.webp","tour/halong-glory-legend-cruise/images/ypntcx215fk3a3dr.webp","tour/halong-glory-legend-cruise/images/kunq8u8e03leq33a.webp","tour/halong-glory-legend-cruise/images/v9xqzh7fya7m1r4g.webp","tour/halong-glory-legend-cruise/images/fzbyzwbuj5xiw5fh.webp","tour/halong-glory-legend-cruise/images/n1r01qt5am7isvod.webp","tour/halong-glory-legend-cruise/images/ikpdpjd3sumf9swo.webp","tour/halong-glory-legend-cruise/images/6owmtl7bfcburgca.webp","tour/halong-glory-legend-cruise/images/v44z6yaj5gjoa8e8.webp","tour/halong-glory-legend-cruise/images/kas8n4nt8dqjzgpp.webp","tour/halong-glory-legend-cruise/images/hc8isbl0pz7oqbf6.webp","tour/halong-glory-legend-cruise/images/fni6jldzflu2tcwo.webp","tour/halong-glory-legend-cruise/images/ipq9ae473hykb2ja.webp","tour/halong-glory-legend-cruise/images/jty44l0q8fvakz8s.webp","tour/halong-glory-legend-cruise/images/p8ibctb66jh60v2d.webp","tour/halong-glory-legend-cruise/images/yvc0ulywu72vd10k.webp","tour/halong-glory-legend-cruise/images/oj312j2m8zlhg3yu.webp","tour/halong-glory-legend-cruise/images/5ha1ko7au1fz0epo.webp","tour/halong-glory-legend-cruise/images/3lhivx5se2hyi1yj.webp","tour/halong-glory-legend-cruise/images/u915h8iz95q6yj8z.webp"],"highlights":["Du thuyền Mila mang phong cách hiện đại kết hợp với nét cổ điển Á Đông","Các phòng nghỉ của du thuyền đều gồm đầy đủ các thiết bị và nội thất hiện đại","Du thuyền Mila với hành trình khám phá Vịnh Hạ Long, đưa du khách đến các điểm tham quan nổi tiếng như đảo Titop, hang Sửng Sốt.","Nhà hàng trên du thuyền sẽ phục vụ du khách các chính theo phong cách Á-Âu kết hợp và ngon miệng"],"content":[{"type":"header","level":6,"text":"Giới thiệu về du thuyền"},{"type":"paragraph","text":"&nbsp;Với thiết kế hiện đại kết hợp hài hòa phong cách cổ điển Á Đông, du thuyền được bố trí đầy đủ các tiện ích như: spa, boong tàu rộng rãi, các phòng đều có ban công và phòng tắm riêng. Quầy bar của du thuyền cũng được bài trí phù hợp phục vụ du khách những đồ uống ngon miệng và hấp dẫn.&nbsp;"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/halong-glory-legend-cruise/blog/7aiknpjx20dmo9u7.webp","caption":"Đội tàu của tập đoàn&nbsp;CÔNG TY CỔ PHẦN DU THUYỀN HERMES"},{"type":"paragraph","text":"Nhà hàng của du thuyền có diện tích khá rộng rãi đem đến cho du khách sự thoải mái khi dùng các bữa chính tại đây. Những đầu bếp giàu kinh nghiệm luôn chọn thực phẩm tươi ngon và chất lượng cho du khách.&nbsp;"},{"type":"image","url":"https://minio.fares.vn/mixivivu-dev/tour/halong-glory-legend-cruise/blog/2l7g7zf8f7q1u79s.webp","caption":"Nhà hàng của du thuyền"}],"rooms":[{"id":"651a720e9d890355aaa73b9f","title":"Phòng Deluxe Ocean View","size":18,"maxPersons":2,"price":2800000,"salePrice":0,"features":["64fc175735b33132034fa427","64fc17d535b33132034fa439","64fc176f35b33132034fa428","64fc178b35b33132034fa42c","64fc17d835b33132034fa43a"],"images":["tour/halong-glory-legend-cruise/Phòng Deluxe/irfk27jm6oeh2sx8.webp","tour/halong-glory-legend-cruise/Phòng Deluxe/5bg5vyo6g1j6ml4p.webp","tour/halong-glory-legend-cruise/Phòng Deluxe/g4749ya8mnefx4k7.webp"]},{"id":"651a720e9d890355aaa73ba1","title":"Phòng Suite Ocean View","size":18,"maxPersons":2,"price":3000000,"salePrice":0,"features":["64fc175735b33132034fa427","64fc17d535b33132034fa439","64fc176f35b33132034fa428","64fc178b35b33132034fa42c","64fc179435b33132034fa42e","64fc17d835b33132034fa43a"],"images":["tour/halong-glory-legend-cruise/Phòng Suite/58syzv1ipbha62p5.webp","tour/halong-glory-legend-cruise/Phòng Suite/k9qk2kjebsrzjyqj.webp"]},{"id":"651a720e9d890355aaa73ba3","title":"Phòng Royal Suite","size":32,"maxPersons":2,"price":3800000,"salePrice":0,"features":["64fc175735b33132034fa427","64fc17d535b33132034fa439","64fc176f35b33132034fa428","64fc178b35b33132034fa42c","64fc179435b33132034fa42e","64fc17d835b33132034fa43a"],"images":["tour/halong-glory-legend-cruise/Phòng Royal Suite /0e5yn8e5qcjoo6kd.webp","tour/halong-glory-legend-cruise/Phòng Royal Suite /dfgznqxmagy0322u